-- Process Chat Messages for ".ai "
local function processChat(player, message)
    if string.sub(string.lower(message), 1, #PREFIX) == PREFIX then
        local prompt = string.sub(message, #PREFIX + 1)
        if #prompt == 0 then return end
        
        local myName = LocalPlayer.DisplayName
        sayInChat("[" .. myName .. "]: Answer Loading...")
        
        -- AI analyzes and executes physical movement dynamically
        processAIMovement(prompt, player)
        
        task.spawn(function()
            local randomSeed = math.random(1, 999999)
            local systemPrompt = "You are a Roblox player named " .. myName .. ". Answer the user directly in under 12 words. No prefix labels like Name: or Answer:. User says: " .. prompt
            
            local url = "https://text.pollinations.ai/" .. HttpService:UrlEncode(systemPrompt) .. "?seed=" .. tostring(randomSeed)
            
            local success, response = pcall(function() return game:HttpGet(url) end)
            
            if success and response and response ~= "" then
                local cleanResponse = string.gsub(response, "[\r\n]", " ")
                cleanResponse = string.gsub(cleanResponse, "^%w+:%s*", "")
                
                if string.find(string.lower(cleanResponse), "sorry") or string.find(string.lower(cleanResponse), "can't help") then
                    sayInChat("[" .. myName .. "]: On it!")
                else
                    sayInChat("[" .. myName .. "]: " .. cleanResponse)
                end
            else
                sayInChat("[" .. myName .. "]: On it!")
            end
        end)
    end
end

-- Hook onto all players in server
local function hookPlayer(player)
    player.Chatted:Connect(function(msg)
        processChat(player, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    hookPlayer(p)
end

Players.PlayerAdded:Connect(hookPlayer)

print("AI-Powered Movement Analyzer Loaded Successfully!")
