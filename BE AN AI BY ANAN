-- Pollinations AI "Send Guide" Circle GUI (AI-Powered Movement Analyzer)
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local PREFIX = ".ai "

-- Function to get character parts safely
local function getLocalParts()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char, char:WaitForChild("Humanoid"), char:WaitForChild("HumanoidRootPart")
end

-- Function to broadcast message in public server chat
local function sayInChat(message)
    if #message > 195 then
        message = string.sub(message, 1, 190) .. "..."
    end

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if channel then channel:SendAsync(message) end
    else
        local req = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
            and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
        if req then req:FireServer(message, "All") end
    end
end

-- AI-Powered Movement Executor (Analyzes intent via Pollinations AI)
local function processAIMovement(prompt, speakerPlayer)
    task.spawn(function()
        local char, humanoid, rootPart = getLocalParts()
        if not char or not humanoid or not rootPart then return end
        
        -- Ask Pollinations AI to classify the movement intent into strict keywords
        local classifyQuery = "Classify this command into ONE action word only (JUMP, SPIN, DANCE, FOLLOW, or NONE): " .. prompt
        local classifyUrl = "https://text.pollinations.ai/" .. HttpService:UrlEncode(classifyQuery) .. "?seed=" .. math.random(1, 999999)
        
        local success, res = pcall(function() return game:HttpGet(classifyUrl) end)
        local action = success and res and string.upper(res) or "NONE"
        
        if string.find(action, "JUMP") then
            -- Supports multiple jumps if specified (e.g., "jump 2 times")
            local count = tonumber(prompt:match("(%d+)")) or 1
            for i = 1, math.clamp(count, 1, 5) do
                humanoid.Jump = true
                task.wait(0.35)
            end
        elseif string.find(action, "SPIN") then
            for i = 1, 30 do
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(20), 0)
                task.wait(0.02)
            end
        elseif string.find(action, "DANCE") then
            for i = 1, 6 do
                humanoid.Jump = true
                task.wait(0.25)
            end
        elseif string.find(action, "FOLLOW") then
            if speakerPlayer and speakerPlayer.Character and speakerPlayer.Character:FindFirstChild("HumanoidRootPart") then
                humanoid:MoveTo(speakerPlayer.Character.HumanoidRootPart.Position)
            end
        end
    end)
end

