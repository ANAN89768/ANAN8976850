			C(-5.2 + .6 * sin(sine / 14), -5, 6) * A(-15 * sin(sine / 12), -16 * sin(sine / 14), 0), .2
	end)
	hold(25, function()
		return A(25, 0, 0),
			C(5.2, -5, 6) * A(-94 + 8 * sin(sine / 12), 3 * sin(sine / 10), 0),
			C(-5.2, -5, 6) * A(-94 - 8 * sin(sine / 12), -3 * sin(sine / 10), 0), .2
	end)
	hold(3, function()
		return A(0, 0, 0),
			C(5.2, -5, 6) * A(-76 + 8 * sin(sine / 12), 3 * sin(sine / 10), 0),
			C(-5.2, -5, 6) * A(-76 - 8 * sin(sine / 12), -3 * sin(sine / 10), 0), .2
	end)

	override = function()
		return A(-30, 0, 0),
			C(5.2, -2, 7.2 + .95 * sin(sine / 12)) * A(45, -9, 0),
			C(-5.2, -2, 7.2 + .95 * sin(sine / 12)) * A(45, 9, 0), .2
	end
	local look = root.CFrame.LookVector
	local right = root.CFrame.RightVector
	local origin = root.Position
	for i = 1, PILLAR_COUNT do
		local dist = 45 + (i / PILLAR_COUNT) * 235
		local lateral = math.random(-30, 30)
		pillar(origin + look * dist + right * lateral)
		task.wait(90 / 60 / PILLAR_COUNT)
	end
	task.wait(.3)
	unlock()
end

---------------------------------------------------------------- T: unleashed evil ball (cosmetic only)
local function evilBall()
	if attacking then return end
	lock()
	faceOn()
	local ball
	local started = os.clock()
	local charging = true

	task.spawn(function()
		local lastRing = 0
		while charging and alive do
			local torso = root.CFrame * pose.root
			local hand = torso * pose.h1:Inverse()
			local cf = hand * C(0, 0, -3)
			local sz = .1 + math.clamp((os.clock() - started) / 4.17, 0, 1) * 5
			if not ball then
				ball = quick("Ball", cf, V(sz, sz, sz), BLACK)
			else
				api("SyncResize", { { Part = ball, CFrame = cf, Size = V(sz, sz, sz) } })
			end
			if os.clock() - lastRing > .35 then
				lastRing = os.clock()
				ring(cf.Position, BLACK, 5)
			end
			task.wait(.05)
		end
	end)

	hold(250, function()
		return CFrame.new(),
			C(6.5, 0, -1) * A(70, 90, 0),
			C(6.5, 0, -5) * A(-110, 90, 0), .2
	end)
	hold(20, function()
		return A(0, -35, 0),
			C(4.5, -5 + .5 * sin(sine / 14), 6) * A(10 + sin(sine / 13), -5 + 5 * sin(sine / 12), -36 - 4 * sin(sine / 11)),
			C(-4.5, 0, 7) * A(-90, 18, 37), .2
	end)
	charging = false
	task.wait(.1)

	override = function()
		return A(0, 35, 0),
			C(6, -5 + .5 * sin(sine / 14), 6) * A(20 + sin(sine / 13), -5 + 5 * sin(sine / 12), -36 - 4 * sin(sine / 11)),
			C(-5.5, 0, 5) * A(30, -28, 37), .2
	end

	if ball then
		local pos = ball.Position
		local dir = (mouse.Hit.Position - pos)
		dir = dir.Magnitude > 1 and dir.Unit or root.CFrame.LookVector
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = { char, ball }
		params.FilterType = Enum.RaycastFilterType.Exclude
		local hitPos
		for _ = 1, 60 do
			local step = dir * 15
			local r = workspace:Raycast(pos, step, params)
			if r then hitPos = r.Position break end
			pos += step
			api("SyncMove", { { Part = ball, CFrame = CFrame.new(pos) } })
			task.wait(.05)
		end
		hitPos = hitPos or pos
		api("SyncMove", { { Part = ball, CFrame = CFrame.new(hitPos) } })
		flash(hitPos, BLACK, 220)
		ring(hitPos - V(0, 3, 0), BLACK, 22)
		ring(hitPos - V(0, 3, 0), WHITE, 34)
		for i = 1, 20 do
			local sz = 5 + i * 10
			api("SyncResize", { { Part = ball, CFrame = CFrame.new(hitPos), Size = V(sz, sz, sz) } })
			api("SyncMaterial", { { Part = ball, Transparency = i / 20 } })
			task.wait(.04)
		end
		api("Remove", { ball })
	end
	task.wait(.3)
	unlock()
end

