-- VEREUS showcase, VISUAL ONLY, built through F3X SyncAPI so other players see it
-- LocalScript for StarterPlayerScripts. Keep the F3X tool in your Backpack.
-- PC keys / mobile buttons:
-- Z = white form   X = red form (press the same key again to go back)
-- Q = red eye stare   E = doom pillars   T = unleashed evil ball   P = remove everything
-- Nothing here damages, moves or deletes other players.
--
-- Smooth mode: parts are un-anchored through F3X and driven from your client every frame.
-- If the server doesn't accept that, it falls back to anchored SyncMove workers automatically.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local hum = char:WaitForChild("Humanoid")

-- PC aims with the mouse, mobile aims where the camera is pointing
local realMouse = player:GetMouse()
local mouse = setmetatable({}, {
	__index = function(_, k)
		if k == "Hit" and not UIS.MouseEnabled then
			local cam = workspace.CurrentCamera
			return CFrame.new(cam.CFrame.Position + cam.CFrame.LookVector * 150)
		end
		return realMouse[k]
	end,
})

local V = Vector3.new
local V0 = Vector3.zero
local function C(...) return CFrame.new(...) end
local function A(x, y, z) return CFrame.Angles(math.rad(x), math.rad(y), math.rad(z)) end
local sin = math.sin

local USE_PHYSICS = true       -- smooth client-driven mode (auto falls back if it doesn't work)
local PILLAR_COUNT = 14        -- lower this if the server lags
local WORKERS_PER_GROUP = 3    -- only used by the fallback mode
local WALK_SPEED = 92          -- matches the walk animation (from the original script)
local FORM2_SPEED = 155        -- speed in the white form (Z), like the original

-- fallback mode: every part has its own group, each group gets its own workers
local GROUPS = {
	{ "head" }, { "mask" }, { "horns" },
	{ "eye1" }, { "eye2" }, { "eye3" }, { "eye4" }, { "light" },
	{ "hand1" }, { "hand2" }, { "mg1" }, { "mg2" },
}

---------------------------------------------------------------- F3X
local endpoint
repeat
	for _, holder in ipairs({ player.Backpack, char }) do
		for _, tool in ipairs(holder:GetChildren()) do
			if tool:IsA("Tool") and tool:FindFirstChild("SyncAPI") then
				endpoint = tool.SyncAPI:FindFirstChild("ServerEndpoint")
			end
		end
	end
	if not endpoint then task.wait(0.5) end
until endpoint

local function api(...)
	return endpoint:InvokeServer(...)
end

