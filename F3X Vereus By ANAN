---------------------------------------------------------------- Cleanup
local buttonGui -- mobile buttons, created at the bottom

local function cleanup()
	if not alive then return end
	alive = false
	conn:Disconnect()
	steppedConn:Disconnect()
	faceOff()
	if buttonGui then buttonGui:Destroy() end
	local list = {}
	for _, p in pairs(P) do table.insert(list, p) end
	api("Remove", list)
	local show = {}
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v ~= root then
			table.insert(show, { Part = v, Transparency = 0 })
		end
	end
	pcall(api, "SyncMaterial", show)
	hum.HipHeight = origHip
	hum.WalkSpeed = origWS
end

hum.Died:Connect(function()
	alive = false
	conn:Disconnect()
	steppedConn:Disconnect()
