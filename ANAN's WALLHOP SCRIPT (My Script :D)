-- ========================================================
-- ANAN's Wallhop Script (Ultra Fast Flick & Return)
-- ========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Clean up existing GUI if re-executed
local guiName = "ANAN_Wallhop_GUI"
local targetParent = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

if targetParent:FindFirstChild(guiName) then
    targetParent[guiName]:Destroy()
end

-- ========================================================
-- CONFIGURABLE SETTINGS
-- ========================================================
local wallhopEnabled = false
local lastHopTime = 0
local hopCooldown = 0.3   -- Cooldown set to 0.3s
local checkDistance = 2   -- Distance set to 2 studs
local airjumpForce = 55   -- Strong upward velocity boost force

-- MAXIMUM ROTATION SPEED SETTINGS
local stepAngleDegrees = 10.5 -- Changed to 10.5° steps
local totalAngleDegrees = 45

