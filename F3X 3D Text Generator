-- 3. UNIVERSAL EXECUTOR F3X HANDLER
local function getF3X()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local tool = nil

    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") and (v.Name:lower():find("building") or v.Name:lower():find("f3x") or v:FindFirstChild("SyncAPI", true)) then
                return v
            end
        end
    end

    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") and (v.Name:lower():find("building") or v.Name:lower():find("f3x") or v:FindFirstChild("SyncAPI", true)) then
                tool = v
                break
            end
        end
    end

    if tool and char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:EquipTool(tool)
            task.wait(0.05)
        end
    end

    return tool or (char and char:FindFirstChildOfClass("Tool"))
end

local function f3xCall(action, ...)
    local tool = getF3X()
    if not tool then return false, nil end

    local api = tool:FindFirstChild("SyncAPI", true) or tool:FindFirstChild("ServerEndpoint", true)
    local remote = api and (api:IsA("RemoteFunction") and api or api:FindFirstChild("ServerEndpoint") or api)

    if remote then
        return pcall(function(...)
            return remote:InvokeServer(action, ...)
        end, ...)
    end
    return false, nil
end

