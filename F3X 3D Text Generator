-- 6. SERVER BUILDER ENGINE
local function build3DText(text, PixelSize)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if PixelSize <= 0 then PixelSize = 0.5 end
    local LineGap = 1.2
    local origin = root.CFrame * CFrame.new(0, 2, -8)
    local chosenColor = colors[colorIndex].Color

    local spawnTargets = {}
    local lineIndex = 0

    for line in text:gmatch("[^\r\n]+") do
        local xOffset = -((#line * 4 * PixelSize) / 2)
        for i = 1, #line do
            local charVal = line:sub(i, i)
            local glyph = getGlyph(charVal)

            for row = 1, 5 do
                for col = 1, 3 do
                    if glyph[row][col] == 1 then
                        local pCFrame = origin * CFrame.new(
                            xOffset + (col * PixelSize),
                            - (row * PixelSize) - (lineIndex * LineGap * PixelSize * 5),
                            0
                        )
                        table.insert(spawnTargets, pCFrame)
                    end
                end
            end
            xOffset = xOffset + (4 * PixelSize)
        end
        lineIndex = lineIndex + 1
    end

    if #spawnTargets == 0 then return end

    task.spawn(function()
        local targetModel = Workspace
        local okSeed, seedPart = f3xCall("CreatePart", "Normal", spawnTargets[1], Workspace)

        if okSeed and seedPart then
            local gOk, newGroup = f3xCall("Group", {seedPart}, Workspace)
            if gOk and typeof(newGroup) == "Instance" and newGroup:IsA("Model") then
                targetModel = newGroup
            elseif seedPart.Parent and seedPart.Parent:IsA("Model") and seedPart.Parent ~= Workspace then
                targetModel = seedPart.Parent
            end
        end

        local createdParts = {}
        if seedPart then table.insert(createdParts, seedPart) end

        local resizeBatch, anchorBatch, colorBatch, collideBatch = {}, {}, {}, {}
        if seedPart then
            table.insert(resizeBatch, {Part = seedPart, Size = Vector3.new(PixelSize, PixelSize, PixelSize), CFrame = spawnTargets[1]})
            table.insert(anchorBatch, {Part = seedPart, Anchored = true})
            table.insert(colorBatch, {Part = seedPart, Color = chosenColor})
            table.insert(collideBatch, {Part = seedPart, CanCollide = false})
        end

        local completedThreads = 1
        local totalParts = #spawnTargets

        for idx = 2, totalParts do
            local pCFrame = spawnTargets[idx]
            task.spawn(function()
                local ok, newPart = f3xCall("CreatePart", "Normal", pCFrame, targetModel)
                if ok and newPart then
                    createdParts[idx] = newPart
                    table.insert(resizeBatch, {Part = newPart, Size = Vector3.new(PixelSize, PixelSize, PixelSize), CFrame = pCFrame})
                    table.insert(anchorBatch, {Part = newPart, Anchored = true})
                    table.insert(colorBatch, {Part = newPart, Color = chosenColor})
                    table.insert(collideBatch, {Part = newPart, CanCollide = false})
                end
                completedThreads = completedThreads + 1
            end)
        end

        local timeout = os.clock() + 1.5
        while completedThreads < totalParts and os.clock() < timeout do
            task.wait()
        end

        if #createdParts > 0 then
            f3xCall("SyncResize", resizeBatch)
            f3xCall("SyncAnchor", anchorBatch)
            f3xCall("SyncColor", colorBatch)
            f3xCall("SyncCollision", collideBatch)

            local validParts = {}
            for _, part in pairs(createdParts) do
                table.insert(validParts, part)
            end
            f3xCall("Group", validParts, Workspace)
        end

        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:UnequipTools() end
        end
    end)
end

