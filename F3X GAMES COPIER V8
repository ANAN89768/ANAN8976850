-- F3X GAME COPIER V8
local setclipboard = setclipboard or toclipboard or set_clipboard
if not setclipboard then error("Your executor does not support setclipboard()") end

local workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local partsToExport = {}

-- Scan Workspace (excluding terrain, player characters, and baseplate)
for _, part in ipairs(workspace:GetDescendants()) do
    if part:IsA("BasePart") and not part:IsA("Terrain") then
        local nameLower = part.Name:lower()
        if nameLower ~= "baseplate" then
            local isCharacter = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and part:IsDescendantOf(player.Character) then
                    isCharacter = true
                    break
                end
            end
            if not isCharacter then
                table.insert(partsToExport, part)
            end
        end
    end
end

local function round(num)
    return math.floor(num * 10000 + 0.5) / 10000
end

-- Extract Mesh details
local function getInfo(part)
    local shape = "Normal"
    local meshInfo = nil
    
    if part:IsA("MeshPart") or part.ClassName == "MeshPart" then
        local meshId = tostring(part.MeshId or "")
        if meshId ~= "" then
            meshInfo = {
                MeshType = "FileMesh",
                MeshId = meshId,
                TextureId = tostring(part.TextureID or ""),
                Scale = "Vector3.new(1, 1, 1)",
                Offset = "Vector3.new(0, 0, 0)"
            }
        end
    else
        local sm = part:FindFirstChildOfClass("SpecialMesh")
        if sm then
            local meshId = tostring(sm.MeshId or "")
            if meshId ~= "" then
                meshInfo = {
                    MeshType = sm.MeshType.Name or "FileMesh",
                    MeshId = meshId,
                    TextureId = tostring(sm.TextureId or ""),
                    Scale = string.format("Vector3.new(%s, %s, %s)", round(sm.Scale.X), round(sm.Scale.Y), round(sm.Scale.Z)),
                    Offset = string.format("Vector3.new(%s, %s, %s)", round(sm.Offset.X), round(sm.Offset.Y), round(sm.Offset.Z))
                }
            end
        end
    end
    
    if not meshInfo or meshInfo.MeshId == "" then
        if part:IsA("WedgePart") or part.ClassName == "WedgePart" then
            shape = "Wedge"
        elseif part:IsA("CornerWedgePart") or part.ClassName == "CornerWedgePart" then
            shape = "Corner"
        elseif part:IsA("TrussPart") or part.ClassName == "TrussPart" then
            shape = "Truss"
        elseif part:IsA("Part") then
            local ok, pShape = pcall(function() return part.Shape end)
            if ok and pShape then
                if pShape == Enum.PartType.Ball then
                    shape = "Ball"
                elseif pShape == Enum.PartType.Cylinder then
                    shape = "Cylinder"
                elseif pShape == Enum.PartType.Wedge then
                    shape = "Wedge"
                end
            end
        end
    end
    return shape, meshInfo
end

-- Extract Decals and Textures
local function getTextures(part)
    local list = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            local isTex = child:IsA("Texture")
            local r, g, b = 255, 255, 255
            pcall(function()
                r = math.round(child.Color3.R * 255)
                g = math.round(child.Color3.G * 255)
                b = math.round(child.Color3.B * 255)
            end)
            table.insert(list, string.format(
                '{Type = "%s", Face = Enum.NormalId.%s, Texture = "%s", Transparency = %s, Color = Color3.fromRGB(%d, %d, %d), StudsPerTileU = %s, StudsPerTileV = %s, OffsetStudsU = %s, OffsetStudsV = %s}',
                child.ClassName, child.Face.Name, child.Texture, tostring(round(child.Transparency)), r, g, b,
                isTex and tostring(round(child.StudsPerTileU)) or "1",
                isTex and tostring(round(child.StudsPerTileV)) or "1",
                isTex and tostring(round(child.OffsetStudsU)) or "0",
                isTex and tostring(round(child.OffsetStudsV)) or "0"
            ))
        end
    end
    return "{" .. table.concat(list, ", ") .. "}"
end

local serializedLines = {}
for _, part in ipairs(partsToExport) do
    local shape, meshInfo = getInfo(part)
    local cf = part.CFrame
    local comps = {cf:GetComponents()}
    for i, v in ipairs(comps) do comps[i] = round(v) end
    local cfStr = string.format("CFrame.new(%s)", table.concat(comps, ", "))
    local sizeStr = string.format("Vector3.new(%s, %s, %s)", round(part.Size.X), round(part.Size.Y), round(part.Size.Z))
    local color = part.Color
    local colorStr = string.format("Color3.fromRGB(%d, %d, %d)", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255))
    local matStr = "Enum.Material." .. part.Material.Name
    local transNum = round(math.clamp(part.Transparency, 0, 1))
    local anch = part.Anchored and "true" or "false"
    local canCollide = part.CanCollide and "true" or "false"
    local texStr = getTextures(part)
    
    local meshStr = "nil"
    if meshInfo then
        meshStr = string.format(
            '{MeshType = "%s", MeshId = "%s", TextureId = "%s", Scale = %s, Offset = %s}',
            meshInfo.MeshType, meshInfo.MeshId, meshInfo.TextureId, meshInfo.Scale, meshInfo.Offset
        )
    end
    
    local line = string.format(
        ' {"%s", %s, %s, %s, %s, %s, %s, %s, %s, %s}',
        shape, cfStr, sizeStr, colorStr, matStr, tostring(transNum), anch, canCollide, texStr, meshStr
    )
    table.insert(serializedLines, line)
end

-- Importer Generator
