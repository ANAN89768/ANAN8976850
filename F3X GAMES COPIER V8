    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    return nil
end

local tool = getF3X()
if not tool then error("F3X / Building Tools not found in character or backpack!") end

local serverEndpoint = tool:FindFirstChild("ServerEndpoint", true) or tool:FindFirstChild("SyncAPI", true)
if serverEndpoint:IsA("Folder") or serverEndpoint:IsA("ModuleScript") then
    serverEndpoint = serverEndpoint:FindFirstChild("ServerEndpoint", true) or serverEndpoint
end

local mapData = {
]] .. table.concat(serializedLines, ",\n") .. [[
}

local function sendInChunks(remoteMethod, dataArray, chunkSize)
    chunkSize = chunkSize or 150
    for i = 1, #dataArray, chunkSize do
        local chunk = {}
        for j = i, math.min(i + chunkSize - 1, #dataArray) do
            table.insert(chunk, dataArray[j])
        end
        pcall(function() serverEndpoint:InvokeServer(remoteMethod, chunk) end)
        task.wait(0.03)
    end
end

task.spawn(function()
    setCharacterAnchored(true)
    local totalParts = #mapData
    local createdParts = table.create(totalParts)
    local completedWorkers = 0
    local WORKERS = 12

    for workerId = 1, WORKERS do
        task.spawn(function()
            local processedCount = 0
            for i = workerId, totalParts, WORKERS do
                local data = mapData[i]
                local shape, cf = data[1], data[2]
                local ok, part = pcall(function() return serverEndpoint:InvokeServer("CreatePart", shape, cf, workspace) end)
                if ok and part then
                    createdParts[i] = {Part = part, Data = data}
                end
                processedCount = processedCount + 1
                if processedCount % 25 == 0 then task.wait() end
            end
            completedWorkers = completedWorkers + 1
        end)
    end

    repeat task.wait() until completedWorkers >= WORKERS

    local resizeBatch, colorBatch, materialBatch, transBatch = {}, {}, {}, {}
    local anchorBatch, collisionBatch = {}, {}
    local meshCreateBatch, meshSyncBatch, textureSyncBatch = {}, {}, {}

    for _, item in pairs(createdParts) do
        local p, d = item.Part, item.Data
        local shape, cf, size, color, mat, trans, anch, canCollide, textures, meshData = d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10]
        local numTrans = tonumber(trans) or 0

        table.insert(resizeBatch, {Part = p, Size = size, CFrame = cf})
        table.insert(colorBatch, {Part = p, Color = color})
        table.insert(materialBatch, {Part = p, Material = mat, Transparency = numTrans})
        table.insert(transBatch, {Part = p, Transparency = numTrans})
        table.insert(anchorBatch, {Part = p, Anchored = anch})
        table.insert(collisionBatch, {Part = p, CanCollide = canCollide})

        if meshData and meshData.MeshId and meshData.MeshId ~= "" then
            table.insert(meshCreateBatch, {Part = p})
            local mType = Enum.MeshType[meshData.MeshType] or Enum.MeshType.FileMesh
            table.insert(meshSyncBatch, {
                Part = p,
                MeshType = mType,
                MeshId = tostring(meshData.MeshId),
                TextureId = tostring(meshData.TextureId or ""),
                Scale = meshData.Scale or Vector3.new(1, 1, 1),
                Offset = meshData.Offset or Vector3.new(0, 0, 0)
            })
        end

        if textures and #textures > 0 then
            for _, t in ipairs(textures) do
                if t.Texture and t.Texture ~= "" then
                    pcall(function() serverEndpoint:InvokeServer("CreateTexture", {p}, t.Type, t.Face) end)
                    table.insert(textureSyncBatch, {
                        Part = p,
                        Face = t.Face,
                        Texture = tostring(t.Texture),
                        Transparency = tonumber(t.Transparency) or 0,
                        Color = t.Color,
                        StudsPerTileU = tonumber(t.StudsPerTileU) or 1,
                        StudsPerTileV = tonumber(t.StudsPerTileV) or 1,
                        OffsetStudsU = tonumber(t.OffsetStudsU) or 0,
                        OffsetStudsV = tonumber(t.OffsetStudsV) or 0
                    })
                end
            end
        end
    end

    sendInChunks("SyncResize", resizeBatch, 150)
    sendInChunks("SyncColor", colorBatch, 150)
    sendInChunks("SyncMaterial", materialBatch, 150)
    sendInChunks("SyncTransparency", transBatch, 150)
    sendInChunks("SyncAnchor", anchorBatch, 150)
    sendInChunks("SyncCollision", collisionBatch, 150)

    if #meshCreateBatch > 0 then
        sendInChunks("CreateMeshes", meshCreateBatch, 150)
        task.wait(0.05)
        sendInChunks("SyncMesh", meshSyncBatch, 150)
    end

    if #textureSyncBatch > 0 then
        sendInChunks("SyncTexture", textureSyncBatch, 150)
    end

    setCharacterAnchored(false)
end)
]]

setclipboard(generatedScript)
