local dragging, dragInput, dragStart, startPos

local function updateInput(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(
        startPos.X.Scale, 
        startPos.X.Offset + delta.X, 
        startPos.Y.Scale, 
        startPos.Y.Offset + delta.Y
    )
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateInput(input)
    end
end)

local function isInsideHumanoidModel(part)
    local current = part.Parent
    while current and current ~= workspace do
        if current:IsA("Model") and current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        current = current.Parent
    end
    
    local success, connectedParts = pcall(function() return part:GetConnectedParts() end)
    if success and connectedParts then
        for i = 1, #connectedParts do
            local parentModel = connectedParts[i]:FindFirstAncestorWhichIsA("Model")
            if parentModel and parentModel:FindFirstChildOfClass("Humanoid") then
                return true
            end
        end
    end
    
    return false
end

local function hasNetworkOwnership(part)
    if typeof(isnetworkowner) == "function" then
        return isnetworkowner(part)
    end
    return true
end

local function isValidOrbitPart(part)
    if not part:IsA("BasePart") or part.Name == "Terrain" then
        return false
    end

    if part.Anchored then
        return false
    end
    
    if part.AssemblyRootPart and part.AssemblyRootPart.Anchored then
        return false
    end

    if isInsideHumanoidModel(part) then
        return false
    end

    if not hasNetworkOwnership(part) then
        return false
    end

    return true
end

local isOrbiting = false
local orbitConnection = nil
local scanTask = nil

local activeTargets = {}
local validTargets = {}
local nearbyLookup = {}

local MAX_SCAN_DISTANCE = 50
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function startBackgroundScanner()
    scanTask = task.spawn(function()
        while isOrbiting do
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            
            table.clear(nearbyLookup)
            
            if hrp then
                overlapParams.FilterDescendantsInstances = {character}
                local partsNearby = workspace:GetPartBoundsInRadius(hrp.Position, MAX_SCAN_DISTANCE, overlapParams)
                
                for i = 1, #partsNearby do
                    local part = partsNearby[i]
                    if isValidOrbitPart(part) then
                        nearbyLookup[part] = true
                    end
                end
                
                for i = #activeTargets, 1, -1 do
                    local part = activeTargets[i]
                    if not nearbyLookup[part] then
                        table.remove(activeTargets, i)
                    end
                end
                
                for part in pairs(nearbyLookup) do
                    if not table.find(activeTargets, part) then
                        table.insert(activeTargets, part)
                    end
                end
            else
                table.clear(activeTargets)
            end
            
            task.wait(0.5)
        end
    end)
end

local function getPolygonFactor(angle, sides)
    local phi = (angle) % (2 * math.pi / sides)
    return math.cos(math.pi / sides) / math.cos(phi - (math.pi / sides))
end

local function startOrbit()
    startBackgroundScanner()
    
    orbitConnection = RunService.Heartbeat:Connect(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        table.clear(validTargets)
        
        for i = 1, #activeTargets do
            local part = activeTargets[i]
            if part and part.Parent and isValidOrbitPart(part) then
                table.insert(validTargets, part)
            end
        end
        
        local count = #validTargets
        if count == 0 then return end
        
        local rawHeight = tonumber(HeightBox.Text) or 0
        local orbitHeight = math.clamp(rawHeight, -100, 100)

        local rawRadius = tonumber(RadiusBox.Text) or 12
        local orbitRadius = math.clamp(rawRadius, 1, 50)
        
        local rawSpeed = tonumber(SpeedBox.Text) or 3.5
        local orbitSpeed = math.clamp(rawSpeed, 0, 50)
        
        local currentTime = tick()
        local angleStep = (math.pi * 2) / count
        local selectedShape = shapesList[currentShapeIndex]
        
        for i = 1, count do
            local part = validTargets[i]
            local angle = (currentTime * orbitSpeed) + (i * angleStep)
            
            local offsetX = 0
            local offsetY = orbitHeight
            local offsetZ = 0
            
            if selectedShape == "Circle" then
                offsetX = math.cos(angle) * orbitRadius
                offsetZ = math.sin(angle) * orbitRadius
                
            elseif selectedShape == "Square" then
                local factor = getPolygonFactor(angle, 4)
                offsetX = math.cos(angle) * orbitRadius * factor
                offsetZ = math.sin(angle) * orbitRadius * factor

            elseif selectedShape == "Triangle" then
                local factor = getPolygonFactor(angle, 3)
                offsetX = math.cos(angle) * orbitRadius * factor
                offsetZ = math.sin(angle) * orbitRadius * factor

            elseif selectedShape == "Pentagon" then
                local factor = getPolygonFactor(angle, 5)
                offsetX = math.cos(angle) * orbitRadius * factor
                offsetZ = math.sin(angle) * orbitRadius * factor

            elseif selectedShape == "Hexagon" then
                local factor = getPolygonFactor(angle, 6)
                offsetX = math.cos(angle) * orbitRadius * factor
                offsetZ = math.sin(angle) * orbitRadius * factor
                
            elseif selectedShape == "Star" then
                local starFactor = 0.6 + 0.4 * math.cos(angle * 5)
                offsetX = math.cos(angle) * orbitRadius * starFactor
                offsetZ = math.sin(angle) * orbitRadius * starFactor

            elseif selectedShape == "Heart" then
                local t = angle
                local x = 16 * (math.sin(t) ^ 3)
                local z = -(13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t))
                offsetX = (x / 16) * orbitRadius
                offsetZ = (z / 16) * orbitRadius

            elseif selectedShape == "Infinity" then
                local denom = 1 + (math.sin(angle) ^ 2)
                offsetX = (orbitRadius * 1.3 * math.cos(angle)) / denom
                offsetZ = (orbitRadius * 1.3 * math.sin(angle) * math.cos(angle)) / denom
                
            elseif selectedShape == "3D Helix" then
                offsetX = math.cos(angle) * orbitRadius
                offsetZ = math.sin(angle) * orbitRadius
                local verticalSpread = count > 1 and ((i / count) - 0.5) * (orbitRadius * 1.5) or 0
                offsetY = orbitHeight + verticalSpread

            elseif selectedShape == "3D DNA Helix" then
                local strand = (i % 2 == 0) and 0 or math.pi
                offsetX = math.cos(angle + strand) * orbitRadius
                offsetZ = math.sin(angle + strand) * orbitRadius
                local progress = (i / count) - 0.5
                offsetY = orbitHeight + progress * (orbitRadius * 1.8)
                
            elseif selectedShape == "3D Sphere" then
                local phi = math.acos(1 - (2 * (i - 0.5) / count))
                local theta = (math.pi * (1 + math.sqrt(5)) * i) + (currentTime * orbitSpeed)
                offsetX = orbitRadius * math.sin(phi) * math.cos(theta)
                offsetZ = orbitRadius * math.sin(phi) * math.sin(theta)
                offsetY = orbitHeight + (orbitRadius * math.cos(phi))

            elseif selectedShape == "3D Torus" then
                local u = angle
                local v = (i / count) * math.pi * 2 + (currentTime * orbitSpeed)
                local r = orbitRadius * 0.4
                offsetX = (orbitRadius + r * math.cos(v)) * math.cos(u)
                offsetZ = (orbitRadius + r * math.cos(v)) * math.sin(u)
                offsetY = orbitHeight + r * math.sin(v)

            elseif selectedShape == "3D Pyramid" then
                local heightProgress = (i / count)
                local currentR = orbitRadius * (1 - heightProgress)
                local factor = getPolygonFactor(angle, 4)
                offsetX = math.cos(angle) * currentR * factor
                offsetZ = math.sin(angle) * currentR * factor
                offsetY = orbitHeight + (heightProgress - 0.5) * (orbitRadius * 1.5)
                
            elseif selectedShape == "3D Wave" then
                offsetX = math.cos(angle) * orbitRadius
                offsetZ = math.sin(angle) * orbitRadius
                offsetY = orbitHeight + math.sin(angle * 4 + currentTime * 2) * (orbitRadius * 0.4)
            end
            
            local targetPos = hrp.Position + Vector3.new(offsetX, offsetY, offsetZ)
            
            part.CFrame = CFrame.new(targetPos, hrp.Position)
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

local function stopOrbit()
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end
    if scanTask then
        task.cancel(scanTask)
        scanTask = nil
    end
    table.clear(activeTargets)
    table.clear(validTargets)
    table.clear(nearbyLookup)
end

local function updateToggleUI()
    if isOrbiting then
        ToggleButton.Text = "Orbit: On"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
        TopToggle.Text = "ON"
        TopToggle.BackgroundColor3 = Color3.fromRGB(50, 200, 90)
    else
        ToggleButton.Text = "Orbit: Off"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        TopToggle.Text = "OFF"
        TopToggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

local function handleToggleClick()
    isOrbiting = not isOrbiting
    updateToggleUI()
    if isOrbiting then
        startOrbit()
    else
        stopOrbit()
    end
end

ToggleButton.MouseButton1Click:Connect(handleToggleClick)
TopToggle.MouseButton1Click:Connect(handleToggleClick)
