--==================================================
-- COORDINATE HELPERS
--==================================================

local function WorldPoint(base, x, y, z)
    return base:PointToWorldSpace(Vector3.new(x, y, z))
end

local function PlaceBlock(p, base, x, y, z, rotation)
    local cf = base * CFrame.new(x, y, z)
    if rotation then cf = cf * rotation end
    p.cf = cf
end

local function ConnectBlocks(p, a, b, width, height)
    local diff = b - a
    local dist = diff.Magnitude
    if dist < 0.01 then return end
    p.size = Vector3.new(width, height, dist)
    p.cf = CFrame.lookAt((a + b) / 2, b)
end

--==================================================
-- TAIL CURVE
--==================================================

local function GetTailPoint(base, index, sway, time)
    local points = {
        Vector3.new(0, 0.15, 1.15),
        Vector3.new(0, 0.3, 1.65),
        Vector3.new(0, 0.65, 1.8),
        Vector3.new(0, 1.0, 1.55),
        Vector3.new(0, 1.35, 1.0),
        Vector3.new(0, 1.65, 0.4),
        Vector3.new(0, 1.85, -0.1),
        Vector3.new(0, 1.9, -0.45),
    }
    local point = points[index]
    local wave = math.sin(time * 2.2 + index * 0.55) * sway
    return base:PointToWorldSpace(Vector3.new(point.X + wave, point.Y, point.Z))
end

--==================================================
-- ASYNC F3X BUILDER
--==================================================

local Alive = true
local Ready = false

local function BuildScorpion()
    local ep = getEndpoint()
    if not ep then return false end

    local spawnCF = Root.CFrame
    local created = 0
    local lock = false

    for _, p in ipairs(Order) do
        task.spawn(function()
            if not Alive then return end
            local inst = sync("CreatePart", p.kind, spawnCF, workspace)
            while lock do task.wait() end
            lock = true
            if typeof(inst) == "Instance" then
                p.inst = inst
                created += 1
            end
            lock = false
        end)
    end

    local timeout = os.clock() + 12
    while created < #Order and os.clock() < timeout and Alive do
        status.Text = string.format("Building Mech Suit... (%d/%d)", created, #Order)
        task.wait(0.05)
    end

    if created < #Order then return false end

    local anchors, collisions, colors, mats, sizes = {}, {}, {}, {}, {}
    for _, p in ipairs(Order) do
        table.insert(anchors, { Part = p.inst, Anchored = true })
        table.insert(collisions, { Part = p.inst, CanCollide = false })
        table.insert(colors, { Part = p.inst, Color = p.color, UnionColoring = true })
        table.insert(mats, { Part = p.inst, Material = p.material, Transparency = 0 })
        table.insert(sizes, { Part = p.inst, Size = p.size, CFrame = p.cf })
    end

    sync("SyncAnchor", anchors)
    sync("SyncCollision", collisions)
    sync("SyncColor", colors)
    sync("SyncMaterial", mats)
    sync("SyncResize", sizes)

    return true
end

--==================================================
-- STATE & F3X HEAD OFFSET (NECK SNAP) LOGIC
--==================================================

local AnimationTime = 0
local WalkPhase = 0
local SnappedPlayers = {}

local function CheckNeckSnap()
    if not Head.inst or not Head.inst.Parent then return end
    local headPos = Head.inst.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player and plr.Character then
            local char = plr.Character
            local victimHead = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 and victimHead and not SnappedPlayers[plr] then
                local dist = (victimHead.Position - headPos).Magnitude
                if dist <= SETTINGS.KillRadius then
                    SnappedPlayers[plr] = true
                    
                    -- MOVE VICTIM HEAD 0.1 STUDS UPWARD VIA F3X SYNC MOVE TO SNAP NECK!
                    local snapCF = victimHead.CFrame + Vector3.new(0, 0.1, 0)
                    sync("SyncMove", { { Part = victimHead, CFrame = snapCF } })
                    
                    -- Clear cooldown after 5 seconds
                    task.delay(5, function()
                        SnappedPlayers[plr] = nil
                    end)
                end
            end
        end
    end
end

local function UpdateCreature(dt)
    if not Character.Parent or Humanoid.Health <= 0 then return end
    AnimationTime += dt

    local move = Humanoid.MoveDirection
    local horizontalMove = Vector3.new(move.X, 0, move.Z)
    local moving = horizontalMove.Magnitude > 0.05

    if moving then
        WalkPhase += dt * SETTINGS.WalkFrequency
    else
        WalkPhase += dt * 1.5
    end

    local rootCF = Root.CFrame
    local bob = moving and math.abs(math.sin(WalkPhase * 2)) * 0.08 or math.sin(AnimationTime * 2) * 0.025
    local bodyCF = rootCF * CFrame.new(0, -0.6 + bob, 0)

    -- BODY
    PlaceBlock(Body, bodyCF, 0, 0.12, 0)
    PlaceBlock(Thorax, bodyCF, 0, 0.02, 0.05)
    PlaceBlock(Head, bodyCF, 0, 0.12, -1.25)
    PlaceBlock(FrontArmor, bodyCF, 0, 0.38, -1.3)
    PlaceBlock(RearArmor, bodyCF, 0, 0.35, 0.8)
    PlaceBlock(UnderBody, bodyCF, 0, -0.3, 0.05)
    PlaceBlock(EyeLeft, bodyCF, -0.34, 0.32, -1.55)
    PlaceBlock(EyeRight, bodyCF, 0.34, 0.32, -1.55)

    for i, plate in ipairs(BodyPlates) do
        PlaceBlock(plate, bodyCF, 0, 0.4, 0.15 + i * 0.18)
    end

    -- LEGS
    for _, leg in ipairs(Legs) do
        local side = leg.Side
        local index = leg.Index
        local alternating = index % 2 == 0 and math.pi or 0
        local phase = WalkPhase + alternating + (side == 1 and 0 or math.pi)
        local stride = moving and SETTINGS.LegStride or 0.08
        local lift = moving and math.max(0, math.cos(phase)) * SETTINGS.LegLift or math.abs(math.sin(AnimationTime * 1.5 + index)) * 0.04

        local footX = side * (1.65 + math.sin(phase) * stride)
        local footZ = leg.HipZ + math.cos(phase) * stride

        local hip = WorldPoint(bodyCF, side * 0.47, -0.05, leg.HipZ)
        local foot = WorldPoint(bodyCF, footX, -1.78 + lift, footZ)
        local knee = WorldPoint(bodyCF, side * 1.08, -0.65 + lift * 0.45, (leg.HipZ + footZ) / 2)
        local ankle = WorldPoint(bodyCF, side * 1.52, -1.25 + lift * 0.7, footZ)

        leg.HipJoint.cf = CFrame.new(hip)
        leg.KneeJoint.cf = CFrame.new(knee)

        ConnectBlocks(leg.Upper, hip, knee, 0.2, 0.2)
        ConnectBlocks(leg.Lower, knee, ankle, 0.15, 0.15)
        ConnectBlocks(leg.Foot, ankle, foot, 0.14, 0.14)
    end

    -- PINCERS
    local clawMotion = math.sin(AnimationTime * 3) * 0.12
    for _, claw in ipairs(Claws) do
        local side = claw.Side
        local base = WorldPoint(bodyCF, side * 0.42, -0.02, -1.5)
        local wrist = WorldPoint(bodyCF, side * 0.75, -0.12, -2.0)
        local palm = WorldPoint(bodyCF, side * 1.02, -0.18, -2.3)

        ConnectBlocks(claw.Arm, base, wrist, 0.2, 0.2)
        claw.Wrist.cf = CFrame.new(wrist)
        claw.Palm.cf = CFrame.new(palm)

        local jawOpen = 0.13 + clawMotion
        local topJawStart = palm + Vector3.new(side * 0.12, 0.12, -0.15)
        local topJawEnd = palm + Vector3.new(side * (0.35 + jawOpen), 0.1, -0.75)
        local bottomJawStart = palm + Vector3.new(side * 0.12, -0.12, -0.15)
        local bottomJawEnd = palm + Vector3.new(side * (0.35 + jawOpen), -0.1, -0.75)

        ConnectBlocks(claw.TopJaw, topJawStart, topJawEnd, 0.13, 0.13)
        ConnectBlocks(claw.BottomJaw, bottomJawStart, bottomJawEnd, 0.13, 0.13)
    end

    -- TAIL
    local tailPoints = {}
    for i = 1, 8 do
        tailPoints[i] = GetTailPoint(bodyCF, i, moving and 0.13 or 0.09, AnimationTime)
    end

    TailBase.cf = CFrame.lookAt((tailPoints[1] + tailPoints[2]) / 2, tailPoints[2])
    TailBase.size = Vector3.new(0.58, 0.48, 0.5)

    for i = 1, 7 do
        ConnectBlocks(Tail[i].Part, tailPoints[i], tailPoints[i + 1], 0.46 - i * 0.035, 0.42 - i * 0.025)
    end

    local stingerEnd = tailPoints[8] + Vector3.new(0, -0.42, -0.3)
    ConnectBlocks(Stinger, tailPoints[8], stingerEnd, 0.17, 0.17)

    -- CHECK FOR NECK SNAP VIA F3X
    CheckNeckSnap()
end

--==================================================
-- STOP / CLEANUP
