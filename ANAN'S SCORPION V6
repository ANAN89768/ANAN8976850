--==================================================
-- F3X SYNC API INTEGRATION
--==================================================

local endpoint = nil
local function getEndpoint()
    if endpoint and endpoint.Parent then return endpoint end
    endpoint = nil
    for _, container in ipairs({ Player.Character, Player.Backpack }) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                local api = tool:FindFirstChild("SyncAPI")
                local ep = api and api:FindFirstChild("ServerEndpoint")
                if ep then
                    endpoint = ep
                    return ep
                end
            end
        end
    end
    return nil
end

local function sync(action, ...)
    local ep = getEndpoint()
    if not ep then return nil end
    local args = table.pack(...)
    local ok, result = pcall(function()
        return ep:InvokeServer(action, table.unpack(args, 1, args.n))
    end)
    return ok and result or nil
end

