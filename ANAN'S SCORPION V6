local Connection

local function StopScorpion()
    Alive = false
    if Connection then
        Connection:Disconnect()
        Connection = nil
    end

    local ep = getEndpoint()
    if ep and Character and Character.Parent then
        local matSync = {}
        for _, v in ipairs(Character:GetChildren()) do
            if v:IsA("BasePart") then
                table.insert(matSync, { Part = v, Material = v.Material, Transparency = 0 })
            elseif v:IsA("Accessory") and v:FindFirstChild("Handle") then
                table.insert(matSync, { Part = v.Handle, Material = v.Handle.Material, Transparency = 0 })
            end
        end
        sync("SyncMaterial", matSync)
    end

    local toDestroy = {}
    for _, p in ipairs(Order) do
        if p.inst then table.insert(toDestroy, p.inst) end
    end
    if #toDestroy > 0 then
        sync("Remove", toDestroy)
    end

    if gui then gui:Destroy() end
    shared.ANAN_SCORPION_F3X_STOP = nil
end

shared.ANAN_SCORPION_F3X_STOP = StopScorpion

