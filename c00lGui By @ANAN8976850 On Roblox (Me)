local function createButton(name, text, scaleSize, scalePosition)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Parent = MainFrame
    button.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    button.BackgroundTransparency = 0
    button.BorderSizePixel = 4
    button.BorderColor3 = Color3.fromRGB(255, 0, 0)
    button.AnchorPoint = Vector2.new(0.5, 0.5)
    button.Position = scalePosition
    button.Size = scaleSize
    button.Font = Enum.Font.SourceSansSemibold
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 0, 0)
    button.TextScaled = true
    button.ZIndex = 2

    task.spawn(function()
        task.wait(0.05) 
        
        local GROW_FACTOR = 1.15     
        local ANIMATION_SPEED = 0.11

        local originalSize = button.Size

        local enlargedSize = UDim2.new(
            originalSize.X.Scale * GROW_FACTOR, 0,
            originalSize.Y.Scale * GROW_FACTOR, 0
        )

        local tweenInfo = TweenInfo.new(ANIMATION_SPEED, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

        local growTween = TweenService:Create(button, tweenInfo, {Size = enlargedSize})
        local shrinkTween = TweenService:Create(button, tweenInfo, {Size = originalSize})

        button.MouseEnter:Connect(function()
            growTween:Play()
        end)

        button.MouseLeave:Connect(function()
            shrinkTween:Play()
        end)
    end)

    return button
end

