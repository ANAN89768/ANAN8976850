        dot.Size = UDim2.new(0, dotSize, 0, dotSize)
        dot.ZIndex = 1
        
        local startX = random:NextNumber(0, 1)
        dot.Position = UDim2.new(startX, 0, 1, 0)
        
        local floatTime = random:NextNumber(3, 6)
        
        table.insert(activeDots, dot)
        
        local tweenInfo = TweenInfo.new(floatTime, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
        local tween = TweenService:Create(dot, tweenInfo, {
            Position = UDim2.new(startX, 0, 0, 0),
            BackgroundTransparency = 1
        })
        
        tween:Play()
        
        tween.Completed:Connect(function()
            local idx = table.find(activeDots, dot)
            if idx then table.remove(activeDots, idx) end
            dot:Destroy()
        end)
    end
end)

local DISTANCE_THRESHOLD = 35
local THRESHOLD_SQ = DISTANCE_THRESHOLD * DISTANCE_THRESHOLD

RunService.Heartbeat:Connect(function()
    if not MainFrame or not MainFrame.Parent then return end
    
    for _, line in ipairs(linesPool) do
        line.Visible = false
    end
    
    local mainPos = MainFrame.AbsolutePosition
    local mainSize = MainFrame.AbsoluteSize
    local numDots = #activeDots
    if numDots < 2 then return end
    
    local cachedPos = {}
    for i = 1, numDots do
        local dot = activeDots[i]
        if dot and dot.Parent then
            local pos = dot.AbsolutePosition - mainPos + (dot.AbsoluteSize / 2)
            if pos.X >= 0 and pos.X <= mainSize.X and pos.Y >= 0 and pos.Y <= mainSize.Y then
                cachedPos[i] = pos
            end
        end
    end
    
    for i = 1, numDots do
        local posA = cachedPos[i]
        if posA then
            for j = i + 1, numDots do
                local posB = cachedPos[j]
                if posB then
                    local dx = posB.X - posA.X
                    local dy = posB.Y - posA.Y
                    local distSq = dx * dx + dy * dy
                    
                    if distSq <= THRESHOLD_SQ then
                        local dist = math.sqrt(distSq)
                        local line = getLine()
                        local mid = (posA + posB) / 2
                        local angle = math.deg(math.atan2(dy, dx))
                        
                        line.Size = UDim2.new(0, dist, 0, 1)
                        line.Position = UDim2.new(0, mid.X, 0, mid.Y)
                        line.Rotation = angle
                        line.BackgroundTransparency = dist / DISTANCE_THRESHOLD
                        line.Visible = true
                    end
                end
            end
        end
    end
end)

do
    local gui = MainFrame
    local dragging
    local dragInput
    local dragStart
    local startPos
     
    local function update(input)
        local delta = input.Position - dragStart
        local dragTime = 0.15 
        
        local goalPosition = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
        
        local tween = TweenService:Create(gui, TweenInfo.new(dragTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = goalPosition})
        tween:Play()
    end
     
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
     
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
     
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

