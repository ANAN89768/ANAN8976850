commands.reset = function(target)
    commands.visible(target)
    commands.unfire(target)
    commands.unsmoke(target)
    commands.unsparkles(target)
    commands.thaw(target)
    commands.clip(target)
end

-- 6. CHAT CONNECTOR
LocalPlayer.Chatted:Connect(function(msg)
    if msg:sub(1, #Prefix) ~= Prefix then return end

    local args = string.split(msg, " ")
    local cmdName = args[1]:lower():sub(#Prefix + 1)
    local targetQuery = args[2]

    if cmdName == "cmds" then
        commands.cmds()
        return
    end

    if cmdName == "uncmds" then
        commands.uncmds()
        return
    end

    if commands[cmdName] then
        local matchedPlayers = getTargetPlayers(targetQuery)
        for _, targetPlayer in ipairs(matchedPlayers) do
            commands[cmdName](targetPlayer)
        end
    end
end)
