-- 4. CLEAN TEXT SPINNER (28 STUDS ELEVATION)
local function spawnText3DInstant(text, startCFrame)
    if #activeCmdParts > 0 then
        f3xCall("Remove", activeCmdParts)
        activeCmdParts = {}
    end

    local tool = getF3X()
    if not tool then return end
    local SyncAPI = tool:FindFirstChild("SyncAPI", true) or tool:FindFirstChild("ServerEndpoint", true)
    local Remote = SyncAPI and (SyncAPI:FindFirstChild("ServerEndpoint") or SyncAPI)
    if not Remote then return end

    local createdParts = {}
    local origin = startCFrame * CFrame.new(0, 28, -SpawnDistance)
    local lineIndex = 0

    local spawnTargets = {}
    for line in text:gmatch("[^\r\n]+") do
        local xOffset = -((#line * 4 * PixelSize) / 2)
        for i = 1, #line do
            local char = line:sub(i, i):upper()
            local glyph = font[char] or font[" "]

            for row = 1, 5 do
                for col = 1, 3 do
                    if glyph[row][col] == 1 then
                        local pCFrame = origin * CFrame.new(
                            xOffset + (col * PixelSize),
                            - (row * PixelSize) - (lineIndex * LineGap * PixelSize * 5),
                            0
                        )
                        table.insert(spawnTargets, pCFrame)
                    end
                end
            end
            xOffset = xOffset + (4 * PixelSize)
        end
        lineIndex = lineIndex + 1
    end

    local total = #spawnTargets
    local completed = 0

    for _, pCFrame in ipairs(spawnTargets) do
        task.spawn(function()
            local success, newPart = pcall(function()
                return Remote:InvokeServer("CreatePart", "Normal", pCFrame, workspace)
            end)
            if success and newPart then
                table.insert(createdParts, {Part = newPart, CFrame = pCFrame})
                table.insert(activeCmdParts, newPart)
            end
            completed = completed + 1
        end)
    end

    task.spawn(function()
        while completed < total do
            task.wait()
        end

        if #createdParts > 0 then
            local resizeBatch, moveBatch, anchorBatch, colorBatch, collideBatch, materialBatch = {}, {}, {}, {}, {}, {}

            for _, item in ipairs(createdParts) do
                local part = item.Part
                local cf = item.CFrame

                table.insert(resizeBatch, {Part = part, Size = Vector3.new(PixelSize, PixelSize, PixelSize), CFrame = cf})
                table.insert(moveBatch, {Part = part, CFrame = cf})
                table.insert(anchorBatch, {Part = part, Anchored = true})
                table.insert(colorBatch, {Part = part, Color = Color3.fromRGB(0, 255, 127)})
                table.insert(collideBatch, {Part = part, CanCollide = false})
                table.insert(materialBatch, {Part = part, Material = Enum.Material.Neon})
            end

            f3xCall("SyncResize", resizeBatch)
            f3xCall("SyncMove", moveBatch)
            f3xCall("SyncAnchor", anchorBatch)
            f3xCall("SyncColor", colorBatch)
            f3xCall("SyncCollision", collideBatch)
            f3xCall("SyncMaterial", materialBatch)
        end
    end)
end

-- 5. COMMAND HANDLERS
local commands = {}

commands.cmds = function()
    local char = LocalPlayer.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
    if root then
        local cmdListText = "COMMANDS LIST\n" ..
                            Prefix .. "KILL " .. Prefix .. "HEADLESS      " .. Prefix .. "UNHEADLESS\n" ..
                            Prefix .. "NAKED " .. Prefix .. "FREEZE        " .. Prefix .. "FIRE " .. Prefix .. "UNFIRE\n" ..
                            Prefix .. "THAW " .. Prefix .. "INVISIBLE     " .. Prefix .. "SMOKE " .. Prefix .. "UNSMOKE\n" ..
                            Prefix .. "VISIBLE " .. Prefix .. "GHOST       " .. Prefix .. "SPARKLES " .. Prefix .. "UNSPARKLES\n" ..
                            Prefix .. "NOCLIP " .. Prefix .. "CLIP        " .. Prefix .. "RESET\n" ..
                            Prefix .. "NEON " .. Prefix .. "PLASTIC\n" ..
                            Prefix .. "BLACK " .. Prefix .. "GOLD"
        
        spawnText3DInstant(cmdListText, root.CFrame)
    end
end

commands.uncmds = function()
    if #activeCmdParts > 0 then
        f3xCall("Remove", activeCmdParts)
        activeCmdParts = {}
    end
end

commands.kill = function(target)
    local head = target.Character and target.Character:FindFirstChild("Head")
    if head then
        f3xCall("Remove", {head})
    end
end

commands.headless = function(target)
    if not target.Character then return end
    local head = target.Character:FindFirstChild("Head")
    
    if head then
        saveAndRemoveFace(target)
        setF3XTransparency({head}, 1)
        f3xCall("SyncCollision", {{Part = head, CanCollide = false}})
    end
end

commands.unheadless = function(target)
    if not target.Character then return end
    local head = target.Character:FindFirstChild("Head")
    
    if head then
        setF3XTransparency({head}, 0)
        restoreFace(target)
    end
end

commands.naked = function(target)
    if target.Character then
        local removeBatch = {}
        for _, child in ipairs(target.Character:GetChildren()) do
            if child:IsA("Clothing") or child:IsA("ShirtGraphic") or child:IsA("Accessory") then
                table.insert(removeBatch, child)
            end
        end
        if #removeBatch > 0 then f3xCall("Remove", removeBatch) end
    end
end

commands.freeze = function(target)
    local parts = target.Character and getCharacterParts(target.Character)
    if parts then
        local batch = {}
        for _, part in ipairs(parts) do table.insert(batch, {Part = part, Anchored = true}) end
        f3xCall("SyncAnchor", batch)
    end
end

commands.thaw = function(target)
    local parts = target.Character and getCharacterParts(target.Character)
    if parts then
        local batch = {}
        for _, part in ipairs(parts) do table.insert(batch, {Part = part, Anchored = false}) end
        f3xCall("SyncAnchor", batch)
    end
end

commands.invisible = function(target)
    local parts = target.Character and getCharacterParts(target.Character)
    if parts then
        saveAndRemoveFace(target)
        setF3XTransparency(parts, 1)
    end
end

commands.visible = function(target)
    local parts = target.Character and getCharacterParts(target.Character)
    if parts then
        setF3XTransparency(parts, 0)
        restoreFace(target)
    end
end

commands.ghost = function(target)
    local parts = target.Character and getCharacterParts(target.Character)
    if parts then
        setF3XTransparency(parts, 0.75)
