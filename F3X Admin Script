commands.fire = function(target)
    local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if root and not root:FindFirstChildOfClass("Fire") then
        f3xCall("CreateDecor", {Parent = root, Type = "Fire"})
    end
end

