-- F3X Admin Script

-- CONFIGURATION
local Prefix = "."
local PixelSize = 0.3       -- Block size
local LineGap = 2.8         -- Line gap spacing
local SpawnDistance = 7     -- Distance in front of character

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Global array to track active command list parts
local activeCmdParts = {}

-- Table to back up saved face decals by UserId
local savedFaces = {}

-- 1. LOCATE F3X TOOL
local function getF3X()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
        end
    end
    
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
        end
    end
    return nil
end

local function f3xCall(action, args)
    local tool = getF3X()
    if not tool then return false end
    
    local SyncAPI = tool:FindFirstChild("SyncAPI", true) or tool:FindFirstChild("ServerEndpoint", true)
    local Remote = SyncAPI and (SyncAPI:FindFirstChild("ServerEndpoint") or SyncAPI)
    
    if Remote then
        return pcall(function()
            Remote:InvokeServer(action, args)
        end)
    end
    return false
end

-- HELPER FOR MATERIAL PANEL TRANSPARENCY
local function setF3XTransparency(partList, transparencyValue)
    local batch = {}
    for _, part in ipairs(partList) do
        table.insert(batch, {
            Part = part,
            Transparency = transparencyValue
        })
    end
    f3xCall("SyncMaterial", batch)
end

-- 2. ENHANCED PLAYER TARGETING SYSTEM
local function getTargetPlayers(query)
    if not query or query == "" then 
        return {LocalPlayer}
    end
    
    query = query:lower()

    if query == "me" then
        return {LocalPlayer}
    end

    if query == "others" then
        local targets = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(targets, player)
            end
        end
        return targets
    end

    for _, player in ipairs(Players:GetPlayers()) do
        local userName = player.Name:lower()
        local displayName = player.DisplayName:lower()
        if userName:find(query, 1, true) or displayName:find(query, 1, true) then
            return {player}
        end
    end

    return {}
end

local function getCharacterParts(targetChar)
    local parts = {}
    for _, child in ipairs(targetChar:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
            table.insert(parts, child)
        end
    end
    return parts
end

-- FACE DECAL MECHANICS
local function saveAndRemoveFace(target)
    if not target.Character then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end

    local faceDecal = head:FindFirstChildOfClass("Decal")
    if faceDecal then
        savedFaces[target.UserId] = {
            Texture = faceDecal.Texture,
            Face = faceDecal.Face
        }
        f3xCall("Remove", {faceDecal})
    end
end

local function restoreFace(target)
    if not target.Character then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end

    local savedData = savedFaces[target.UserId]
    if savedData then
        local currentFace = head:FindFirstChildOfClass("Decal")
        if currentFace then
            f3xCall("SyncTexture", {{Part = currentFace, Texture = savedData.Texture}})
        else
            local tool = getF3X()
            if not tool then return end
            local SyncAPI = tool:FindFirstChild("SyncAPI", true) or tool:FindFirstChild("ServerEndpoint", true)
            local Remote = SyncAPI and (SyncAPI:FindFirstChild("ServerEndpoint") or SyncAPI)
            
            if Remote then
                pcall(function()
                    local newDecal = Remote:InvokeServer("CreateDecal", head, savedData.Face or Enum.NormalId.Front)
                    if newDecal then
                        f3xCall("SyncTexture", {{Part = newDecal, Texture = savedData.Texture}})
                    end
                end)
            end
        end
    end
end

