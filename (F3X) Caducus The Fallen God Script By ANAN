---------------------------------------------------------------- Effects manager (pooled, one batch per tick)
local active, inflight = {}, 0
local function cv(v) return V(math.max(v.X, .05), math.max(v.Y, .05), math.max(v.Z, .05)) end

local function fx(kind, cf, s0, g, life, color, o)
	local name = table.remove(free[kind])
	if not name then return end
	o = o or {}
	active[#active + 1] = { n = name, k = kind, cf = cf, s0 = s0, g = g or V0, life = life, c = color or BLACK,
		t0 = o.t0 or 0, tend = o.tend or 1, vel = o.vel, acc = o.acc, ms0 = o.ms0 or V(1, 1, 1), mg = o.mg or V0,
		born = os.clock(), fresh = true }
end

local function send(act, list)
	if #list == 0 then return end
	inflight += 1
	task.spawn(function() pcall(api, act, list) inflight -= 1 end)
end

task.spawn(function()
	while alive do
		task.wait(.05)
		if inflight < 4 then
			local now = os.clock()
			local rs, ms, mt, cl, mv = {}, {}, {}, {}, {}
			for i = #active, 1, -1 do
				local a = active[i]
				local p = P[a.n]
				local t = now - a.born
				if p and p.Parent then
					if t >= a.life then
						mt[#mt + 1] = { Part = p, Transparency = 1 }
						table.insert(free[a.k], a.n)
						table.remove(active, i)
					else
						local pos = a.cf.Position + (a.vel and a.vel * t or V0) + (a.acc and a.acc * (.5 * t * t) or V0)
						local cf = CFrame.new(pos) * (a.cf - a.cf.Position)
						if a.k == "wav" then
							ms[#ms + 1] = { Part = p, Scale = cv(a.ms0 + a.mg * t) }
							if a.fresh or a.vel then mv[#mv + 1] = { Part = p, CFrame = cf } end
						else
							rs[#rs + 1] = { Part = p, CFrame = cf, Size = cv(a.s0 + a.g * t) }
						end
						mt[#mt + 1] = { Part = p, Transparency = math.clamp(a.t0 + (a.tend - a.t0) * (t / a.life), 0, 1) }
						if a.fresh then
							cl[#cl + 1] = { Part = p, Color = a.c, UnanchorAfter = false }
							a.fresh = false
						end
					end
				else
					table.insert(free[a.k], a.n)
					table.remove(active, i)
				end
			end
			send("SyncResize", rs)
			send("SyncMove", mv)
			send("SyncMesh", ms)
			send("SyncMaterial", mt)
			send("SyncColor", cl)
		end
	end
end)

local function boom(pos, radius, life, color)
	fx("sph", CFrame.new(pos), V(1, 1, 1), V(radius, radius * 2, radius) / life, life, color or BLACK)
	fx("sph", CFrame.new(pos), V(1, 1, 1), V(radius, radius * 2, radius) * .7 / life, life, GREY)
	fx("wav", CFrame.new(pos), V(1, 1, 1), V0, life, BLACK, { ms0 = V(4, .001, 4), mg = V(radius * 1.2, .01, radius * 1.2) / life })
	fx("wav", CFrame.new(pos), V(1, 1, 1), V0, life, GREY, { ms0 = V(4, .001, 4), mg = V(radius, .01, radius) / life })
end

local function debris(pos, n, speed)
	for _ = 1, n do
		local s = math.random(10, 25) / 10
		fx("blk", CFrame.new(pos + V(math.random(-4, 4), 2, math.random(-4, 4))), V(s, s, s), V0, 1.4, BLACK,
			{ vel = V(math.random(-speed, speed), math.random(speed, speed * 2), math.random(-speed, speed)), acc = V(0, -120, 0), t0 = .2 })
	end
end

local function trace()
	for _, n in ipairs({ "torso", "head", "larm", "rarm", "lleg", "rleg" }) do
		if target[n] then fx("blk", target[n], defs[n].size, V0, .5, BLACK, { t0 = .3 }) end
	end
end

