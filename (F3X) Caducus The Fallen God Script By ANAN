---------------------------------------------------------------- Build (parallel create, batched properties)
local P = {}
local usePhysics = USE_PHYSICS

local function build(names)
	local pend = #names
	for _, n in ipairs(names) do
		task.spawn(function()
			local d = defs[n]
			local p = api("CreatePart", "Normal", root.CFrame, workspace)
			if p then P[n] = p end
			pend -= 1
		end)
	end
	while pend > 0 do task.wait() end
	local rs, col, mat, cc, anch, mk, mp = {}, {}, {}, {}, {}, {}, {}
	for _, n in ipairs(names) do
		local p, d = P[n], defs[n]
		if p then
			rs[#rs + 1] = { Part = p, CFrame = root.CFrame, Size = d.size }
			col[#col + 1] = { Part = p, Color = d.color, UnanchorAfter = false }
			mat[#mat + 1] = { Part = p, Material = d.mat, Transparency = d.trans or 0 }
			cc[#cc + 1] = { Part = p, CanCollide = false }
			if d.mesh then
				mk[#mk + 1] = { Part = p }
				mp[#mp + 1] = { Part = p, MeshType = d.mesh.type, MeshId = d.mesh.id,
					TextureId = d.mesh.tex, Scale = d.mesh.scale }
			end
			-- Anchor every created part, including pooled visual effects.
			anch[#anch + 1] = { Part = p, Anchored = true }
		end
	end
	par(
		function() api("SyncResize", rs) end,
		function() api("SyncColor", col) end,
		function() api("SyncMaterial", mat) end,
		function() api("SyncCollision", cc) end,
		function() if #anch > 0 then api("SyncAnchor", anch) end end,
		function() if #mk > 0 then api("CreateMeshes", mk) api("SyncMesh", mp) end end
	)
end

