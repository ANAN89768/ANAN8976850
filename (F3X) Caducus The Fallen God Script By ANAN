local function wobble(p, a)
	return { t = p.t * Ang(0, .2 * cos(sine / 30), 0), h = p.h, ra = p.ra, la = p.la, rl = p.rl, ll = p.ll,
		wing = -15 * cos(sine / 30), a = a or .1 }
end

local function grounded(dist)
	return workspace:Raycast(root.Position, V(0, -(dist or 4), 0), rayParams) ~= nil
end

local state = "idle"
local function autoPose()
	local vel = root.AssemblyLinearVelocity
	local speed = V(vel.X, 0, vel.Z).Magnitude
	local g = grounded(4)
	if vel.Y > 1 and not g then state = "jump"
	elseif vel.Y < -1 and not g then state = "fall"
	elseif speed < 1 and g then state = "idle"
	elseif speed > 2 and g then state = "walk" end
	if state == "jump" then return POSE_JUMP
	elseif state == "fall" then return POSE_FALL
	elseif state == "walk" then return walk() end
	return idle()
end

local function wf(frames) task.wait(frames / 45) end

---------------------------------------------------------------- Rig drive (client every frame, fallback = SyncMove workers)
local wingNames, tatNames = {}, {}
for i = 1, #wingInv do wingNames[i] = "w" .. i end
for i = 1, #tatInv do tatNames[i] = "t" .. i end
local WING_OFF = C(.0814, -.0268, -.041)
local TAT_OFF = C(.128, .406, -.0114)

local function compute()
	-- Predict a short distance ahead using horizontal velocity. Clamp the lead so
	-- sudden dashes/jumps do not fling the visual rig far away from the player.
	local velocity = root.AssemblyLinearVelocity
	local lead = math.clamp(PREDICTION_TIME, 0, 0.2)
	local predictedOffset = velocity * lead
	local horizontal = V(velocity.X, 0, velocity.Z)
	if horizontal.Magnitude > 0 then
		local horizontalDistance = math.min(horizontal.Magnitude * lead, MAX_PREDICTION_DISTANCE)
		local horizontalLead = horizontal.Unit * horizontalDistance
		predictedOffset = V(
			horizontalLead.X,
			math.clamp(predictedOffset.Y, -2, 2),
			horizontalLead.Z
		)
	end

	local rootCF = root.CFrame + predictedOffset
	local torso = rootCF * pose.t
	local head = torso * pose.h
	target.torso = torso
	target.head = head
	target.halfhed = head * C(0, .185, 0) * A(0, 180, 0)
	target.larm = torso * pose.la
	target.rarm = torso * pose.ra
	target.lleg = torso * pose.ll
	target.rleg = torso * pose.rl
	local wingCF = torso * WING_OFF * A(0, 0, pose.wing) * WING_OFF
	for i = 1, #wingInv do target[wingNames[i]] = wingCF * wingInv[i] end
	local tb = target.rarm * TAT_OFF
	for i = 1, #tatInv do target[tatNames[i]] = tb * tatInv[i] end
end

local function differs(a, b)
	return not a
		or (a.Position - b.Position).Magnitude > .015
		or (a.LookVector - b.LookVector).Magnitude > .002
		or (a.UpVector - b.UpVector).Magnitude > .002
end

-- Each worker owns distinct batches. Failed SyncMove calls do not update the
-- last-sent cache, so those parts are retried on the next pass.
local function startWorkers()
	local batches = {}
	for s = 1, #rigNames, SYNC_BATCH_SIZE do
		local names = {}
		for i = s, math.min(s + SYNC_BATCH_SIZE - 1, #rigNames) do
			names[#names + 1] = rigNames[i]
		end
		batches[#batches + 1] = { names = names, last = {} }
	end

	for workerId = 1, math.min(WORKERS, math.max(#batches, 1)) do
		task.spawn(function()
			task.wait((workerId - 1) * 0.025)
			while alive do
				local list = {}
				local pendingNames = {}
				for batchIndex = workerId, #batches, WORKERS do
					local batch = batches[batchIndex]
					for _, n in ipairs(batch.names) do
						local cf, p = target[n], P[n]
						if cf and p and p.Parent and differs(batch.last[n], cf) then
							list[#list + 1] = { Part = p, CFrame = cf }
							pendingNames[#pendingNames + 1] = { batch = batch, name = n, cf = cf }
						end
					end
				end

				if #list > 0 then
					local t0 = os.clock()
					local ok = pcall(api, "SyncMove", list)
					if ok then
						rtt = rtt * 0.85 + (os.clock() - t0) * 0.15
						for _, item in ipairs(pendingNames) do
							item.batch.last[item.name] = item.cf
						end
					end
				end
				task.wait(SYNC_INTERVAL)
			end
		end)
	end
end

-- Anchoring is applied during build; no local CFrame writes or physics fallback.
if not usePhysics then startWorkers() end

local conn = RunService.RenderStepped:Connect(function(dt)
	if not alive then return end
	sine += 45 * dt
	local p = override
	if type(p) == "function" then p = p() end
	p = p or autoPose()
	local k = 1 - (1 - (p.a or .1)) ^ (dt * 45)
	pose.t = pose.t:Lerp(p.t, k)
	pose.h = pose.h:Lerp(p.h, k)
	pose.ra = pose.ra:Lerp(p.ra, k)
	pose.la = pose.la:Lerp(p.la, k)
	pose.rl = pose.rl:Lerp(p.rl, k)
	pose.ll = pose.ll:Lerp(p.ll, k)
	local kw = 1 - (1 - .1) ^ (dt * 45)
	pose.wing = pose.wing + ((p.wing or 0) - pose.wing) * kw
	compute()
end)

