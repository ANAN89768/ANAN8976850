---------------------------------------------------------------- Moves (visual only)
local function begin(lockMove)
	if Attack then return false end
	Attack = true
	if lockMove then hum.WalkSpeed = 0 end
	return true
end
local function finish()
	override = nil
	Attack = false
	hum.WalkSpeed = WALK_SPEED
end

-- Click: Wretched Row
local function punch()
	if not begin(false) then return end
	override = function() return wobble(POSE_WIND, .1) end
	local last = 0
	local t0 = os.clock()
	while os.clock() - t0 < 50 / 45 do
		if os.clock() - last > .1 and target.larm then
			last = os.clock()
			fx("sph", target.larm * C(0, -1, 0), V(.2, .2, .2), V(9, 9, 9), .28, BLACK)
		end
		RunService.Heartbeat:Wait()
	end
	override = function() return wobble(POSE_SLAM, .1) end
	local look = root.CFrame.LookVector
	local start = root.Position
	for k = 1, 22 do
		local pos = groundAt(start + look * (k * 5 + 3))
		fx("sph", CFrame.new(pos), V(.2, .6, .2), V(45, 90, 45), .55, BLACK)
		task.wait(.05)
	end
	task.wait(.1)
	finish()
end

-- Z: Spectral Sprint
local function sprint()
	if Attack then return end
	dash = not dash
end

-- X: Vile Vault
local function vault()
	if not begin(true) then return end
	override = POSE_CHARGE
	wf(90)
	fx("wav", CFrame.new(root.Position - V(0, 2, 0)), V(1, 1, 1), V0, .5, GREY, { ms0 = V(3, .001, 3), mg = V(30, .01, 30) / .5 })
	hum:ChangeState(Enum.HumanoidStateType.Jumping)
	override = POSE_RISE
	for i = 1, 30 do
		root.AssemblyLinearVelocity = V(0, 200, 0)
		if i % 4 == 0 then trace() end
		RunService.Heartbeat:Wait()
	end
	wf(20)
	override = POSE_DIVE
	local t0 = os.clock()
	local n = 0
	while not grounded(10) and os.clock() - t0 < 4 do
		root.AssemblyLinearVelocity = V(0, -200, 0)
		n += 1
		if n % 4 == 0 then trace() end
		RunService.Heartbeat:Wait()
	end
	override = POSE_IMPACT
	local pos = groundAt(root.Position)
	debris(pos, 14, 60)
	boom(pos, 45, .6)
	root.AssemblyLinearVelocity = V0
	wf(50)
	finish()
end

-- C: The Spire
local function spire()
	if not begin(false) then return end
	override = function() return wobble(POSE_WIND, .2) end
	wf(10)
	override = function() return wobble(POSE_SLAM, .1) end
	local pos = aim()
	fx("wav", CFrame.new(pos + V(0, .3, 0)), V(1, 1, 1), V0, 1.2, BLACK, { ms0 = V(2, .01, 2), mg = V(60, .01, 60) })
	fx("wav", CFrame.new(pos + V(0, .4, 0)), V(1, 1, 1), V0, 1.2, GREY, { ms0 = V(1, .01, 1), mg = V(45, .01, 45) })
	wf(55)
	boom(pos, 110, 1.4)
	debris(pos, 16, 70)
	wf(30)
	finish()
end

-- V: Blot Out The Sun
local function meteor(center)
	local start = center + V(math.random(-50, 50), 300, math.random(-50, 50))
	local gy = groundAt(V(start.X, center.Y, start.Z)).Y
	local speed = 150
	local life = math.max((start.Y - gy) / speed, .3)
	fx("sph", CFrame.new(start), V(10, 10, 10), V0, life, BLACK, { vel = V(0, -speed, 0), t0 = 0, tend = 0 })
	task.delay(life, function()
		if not alive then return end
		local pos = V(start.X, gy, start.Z)
		boom(pos, 30, .6)
		for _ = 1, 5 do
			fx("blk", CFrame.new(pos + V(0, 2, 0)), V(1.2, 1.2, 1.2), V0, 1.2, BLACK,
				{ vel = V(math.random(-60, 60), math.random(60, 110), math.random(-60, 60)), acc = V(0, -120, 0), t0 = .1 })
		end
	end)
end

local function sun()
	if not begin(false) then return end
	override = function() return wobble(POSE_WIND, .2) end
	wf(10)
	local center = aim()
	override = POSE_ARM
	wf(20)
	Attack = false
	for _ = 1, 20 do
		if not alive then break end
		meteor(center)
		task.wait(.5)
	end
	finish()
end

-- B: Then Make a New One
local function laser()
	if not begin(true) then return end
	override = function() return wobble(POSE_WIND, .1) end
	wf(80)
	local src = root.Position + V(0, 80, 0)
	local stopT = os.clock() + 6
	while os.clock() < stopT and alive do
		local tgt = aim()
		local d = tgt - src
		local len = math.max(d.Magnitude, 1)
		fx("blk", CFrame.new(src + d / 2, tgt), V(5, 5, len), V(14, 14, 0), .3, BLACK, { t0 = .1 })
		fx("sph", CFrame.new(src), V(2, 2, 2), V(12, 12, 12), .3, BLACK)
		fx("sph", CFrame.new(tgt), V(2, 4, 2), V(40, 80, 40), .35, BLACK)
		task.wait(.1)
	end
	finish()
end

-- M: The Cataclyst (visual only, your fake body breaks apart and rebuilds)
local function cataclyst()
	if not begin(true) then return end
	override = POSE_DET
	local t0 = os.clock()
	while os.clock() - t0 < 4 do
		if target.rarm then fx("sph", target.rarm * C(.2, -1.1, 0), V(.22, .22, .22), V(10, 10, 10), .28, BLACK) end
		task.wait(.15)
	end
	for _, R in ipairs({ 40, 100, 180 }) do
		fx("sph", CFrame.new(target.rarm.Position), V(2, 2, 2), V(R, R, R) / 1.2, 1.2, BLACK)
		task.wait(1.2)
	end
	local hideList, showList = {}, {}
	for _, n in ipairs(rigNames) do
		local p = P[n]
		if p then
			hideList[#hideList + 1] = { Part = p, Transparency = 1 }
			showList[#showList + 1] = { Part = p, Transparency = defs[n].trans or 0 }
		end
	end
	api("SyncMaterial", hideList)
	for _, n in ipairs({ "torso", "head", "larm", "rarm", "lleg", "rleg" }) do
		local s = defs[n].size
		fx("blk", target[n], s, V0, 3, BLACK, { vel = V(math.random(-30, 30), math.random(-5, 25), math.random(-30, 30)),
			acc = V(0, -4, 0), t0 = 0 })
	end
	boom(root.Position, 90, 1.2)
	task.wait(3)
	api("SyncMaterial", showList)
	finish()
end

---------------------------------------------------------------- Watchdog (instant parallel rebuild of any deleted part)
local rebuilding = false
local watchConn = RunService.Heartbeat:Connect(function()
	if not alive or rebuilding then return end
	local missing = {}
	for _, n in ipairs(order) do
		local p = P[n]
		if not p or not p.Parent then missing[#missing + 1] = n end
	end
	if #missing == 0 then return end
	rebuilding = true
	task.spawn(function()
		build(missing)
		task.wait(.25)
		rebuilding = false
	end)
end)

---------------------------------------------------------------- Cleanup
local buttonGui
local function cleanup()
	if not alive then return end
	alive = false
	conn:Disconnect()
	steppedConn:Disconnect()
	heartConn:Disconnect()
	watchConn:Disconnect()
	if buttonGui then buttonGui:Destroy() end
	for _, s in ipairs(root:GetChildren()) do
		if s.Name == "CaducusTheme" then s:Destroy() end
	end
	local list = {}
	for _, p in pairs(P) do table.insert(list, p) end
	api("Remove", list)
	local show = {}
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v ~= root then show[#show + 1] = { Part = v, Transparency = 0 } end
	end
	pcall(api, "SyncMaterial", show)
	hum.WalkSpeed = origWS
	hum.JumpPower = origJP
end

hum.Died:Connect(function()
	alive = false
	conn:Disconnect()
	steppedConn:Disconnect()
	heartConn:Disconnect()
	watchConn:Disconnect()
	if buttonGui then buttonGui:Destroy() end
end)

---------------------------------------------------------------- PC input (keyboard + click)
UIS.InputBegan:Connect(function(input, gpe)
	if gpe or not alive then return end
	local k = input.KeyCode
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		task.spawn(punch)
	elseif k == Enum.KeyCode.Z then task.spawn(sprint)
	elseif k == Enum.KeyCode.X then task.spawn(vault)
	elseif k == Enum.KeyCode.C then task.spawn(spire)
	elseif k == Enum.KeyCode.V then task.spawn(sun)
	elseif k == Enum.KeyCode.B then task.spawn(laser)
	elseif k == Enum.KeyCode.M then task.spawn(cataclyst)
	elseif k == Enum.KeyCode.P then cleanup() end
end)

