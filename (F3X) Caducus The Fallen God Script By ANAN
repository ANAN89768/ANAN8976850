local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.FilterDescendantsInstances = { char }
rayParams.RespectCanCollide = true

local function aim()
	if UIS.MouseEnabled then return realMouse.Hit.Position end
	local cam = workspace.CurrentCamera
	local r = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 500, rayParams)
	return r and r.Position or (cam.CFrame.Position + cam.CFrame.LookVector * 150)
end

local function groundAt(pos)
	local r = workspace:Raycast(pos + V(0, 400, 0), V(0, -800, 0), rayParams)
	return r and r.Position or pos
end

---------------------------------------------------------------- F3X
local endpoint
repeat
	for _, holder in ipairs({ player.Backpack, char }) do
		for _, tool in ipairs(holder:GetChildren()) do
			if tool:IsA("Tool") and tool:FindFirstChild("SyncAPI") then
				endpoint = tool.SyncAPI:FindFirstChild("ServerEndpoint")
			end
		end
	end
	if not endpoint then task.wait(.5) end
until endpoint

local function api(...)
	return endpoint:InvokeServer(...)
end

local function par(...)
	local fns, n = { ... }, select("#", ...)
	for _, f in ipairs(fns) do
		task.spawn(function() pcall(f) n -= 1 end)
	end
	while n > 0 do RunService.Heartbeat:Wait() end
end

