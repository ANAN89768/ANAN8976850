-- Settings
local REACH = 50
local BUILD_ENABLED = false
local INCREMENT_ENABLED = false
local CUSTOM_INC = 1
local CURRENT_SIZE = Vector3.new(1, 1, 1)
local CURRENT_COLOR = BrickColor.new("White")

-- Services
local Player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")

local BuildFolder = workspace:FindFirstChild("DeltaBuilds") or Instance.new("Folder", workspace)
BuildFolder.Name = "DeltaBuilds"

-- 1. GUI Setup
local ScreenGui = Instance.new("ScreenGui", Player:WaitForChild("PlayerGui"))
ScreenGui.Name = "DeltaBuilder_V22"
ScreenGui.ResetOnSpawn = false

-- Crosshair (V16 Standard Height)
local Crosshair = Instance.new("TextLabel", ScreenGui)
Crosshair.Name = "BuilderCrosshair"
Crosshair.Text = "+"
Crosshair.TextColor3 = Color3.new(1, 1, 1)
Crosshair.BackgroundTransparency = 1
Crosshair.Font = Enum.Font.SourceSans
Crosshair.TextSize = 40
Crosshair.Size = UDim2.new(0, 40, 0, 40)
Crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
Crosshair.Position = UDim2.new(0.5, 0, 0.4, 0) 
Crosshair.Visible = false

-- Main Menu Frame
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 160, 0, 240) 
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true

local DragBar = Instance.new("TextLabel", MainFrame)
DragBar.Size = UDim2.new(1, 0, 0, 30)
DragBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
DragBar.Text = "BUILDER V22"
DragBar.TextColor3 = Color3.new(1, 1, 1)
DragBar.Font = Enum.Font.SourceSansBold

-- Crop (Minimize) System
local IsMinimized = false
local CropBtn = Instance.new("TextButton", DragBar)
CropBtn.Size = UDim2.new(0, 25, 0, 25)
CropBtn.Position = UDim2.new(1, -30, 0, 2)
CropBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
CropBtn.Text = "–"
CropBtn.TextColor3 = Color3.new(1, 1, 1)

local ContentFrame = Instance.new("Frame", MainFrame)
ContentFrame.Size = UDim2.new(1, 0, 1, -30)
ContentFrame.Position = UDim2.new(0, 0, 0, 30)
ContentFrame.BackgroundTransparency = 1

CropBtn.MouseButton1Click:Connect(function()
    IsMinimized = not IsMinimized
    ContentFrame.Visible = not IsMinimized
    MainFrame.Size = IsMinimized and UDim2.new(0, 160, 0, 30) or UDim2.new(0, 160, 0, 240)
    CropBtn.Text = IsMinimized and "+" or "–"
end)

-- Menu Buttons
local ToggleBtn = Instance.new("TextButton", ContentFrame)
ToggleBtn.Size = UDim2.new(0.9, 0, 0.12, 0)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.05, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
ToggleBtn.Text = "OFF"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)

local IncToggle = Instance.new("TextButton", ContentFrame)
IncToggle.Size = UDim2.new(0.42, 0, 0.12, 0)
IncToggle.Position = UDim2.new(0.05, 0, 0.2, 0)
IncToggle.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
IncToggle.Text = "INC: OFF"
IncToggle.TextColor3 = Color3.new(1, 1, 1)

local IncInput = Instance.new("TextBox", ContentFrame)
IncInput.Size = UDim2.new(0.42, 0, 0.12, 0)
IncInput.Position = UDim2.new(0.53, 0, 0.2, 0)
IncInput.Text = "1"
IncInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
IncInput.TextColor3 = Color3.new(1, 1, 1)

local WhiteBtn = Instance.new("TextButton", ContentFrame)
WhiteBtn.Size = UDim2.new(0.42, 0, 0.12, 0)
WhiteBtn.Position = UDim2.new(0.05, 0, 0.35, 0)
WhiteBtn.BackgroundColor3 = Color3.new(1, 1, 1)
WhiteBtn.Text = "White"

local BlackBtn = Instance.new("TextButton", ContentFrame)
BlackBtn.Size = UDim2.new(0.42, 0, 0.12, 0)
BlackBtn.Position = UDim2.new(0.53, 0, 0.35, 0)
BlackBtn.BackgroundColor3 = Color3.new(0.1, 0.1, 0.1)
BlackBtn.Text = "Black"
BlackBtn.TextColor3 = Color3.new(1, 1, 1)

local SizeInput = Instance.new("TextBox", ContentFrame)
SizeInput.Size = UDim2.new(0.9, 0, 0.12, 0)
SizeInput.Position = UDim2.new(0.05, 0, 0.5, 0)
SizeInput.Text = "1, 1, 1"
SizeInput.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
SizeInput.TextColor3 = Color3.new(1, 1, 1)

local PlaceBtn = Instance.new("TextButton", ContentFrame)
PlaceBtn.Size = UDim2.new(0.9, 0, 0.15, 0)
PlaceBtn.Position = UDim2.new(0.05, 0, 0.65, 0)
PlaceBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
PlaceBtn.Text = "Place"
PlaceBtn.TextColor3 = Color3.new(1, 1, 1)
PlaceBtn.TextScaled = true

local ClearAllBtn = Instance.new("TextButton", ContentFrame)
ClearAllBtn.Size = UDim2.new(0.9, 0, 0.12, 0)
ClearAllBtn.Position = UDim2.new(0.05, 0, 0.83, 0)
ClearAllBtn.BackgroundColor3 = Color3.fromRGB(100, 0, 0)
ClearAllBtn.Text = "DELETE ALL"
ClearAllBtn.TextColor3 = Color3.new(1, 1, 1)

-- 2. Placement Logic
local Preview = Instance.new("Part")
Preview.Transparency = 1
Preview.CanCollide = false
Preview.Anchored = true
Preview.Material = Enum.Material.Neon
Preview.Parent = workspace

local function updateSize()
	local text = SizeInput.Text:gsub("[^%d%.%*%,%s]", "")
	local nums = {}
	for num in text:gmatch("[%d%.]+") do table.insert(nums, tonumber(num)) end
	if #nums >= 3 then
		CURRENT_SIZE = Vector3.new(nums[1], nums[2], nums[3])
		Preview.Size = CURRENT_SIZE
	end
end

local function placeBlock()
	if BUILD_ENABLED and Preview.Transparency < 1 then
		local b = Instance.new("Part", BuildFolder)
		b.Size = CURRENT_SIZE
		b.Position = Preview.Position
		b.BrickColor = CURRENT_COLOR
		b.TopSurface = "Studs"
		b.Anchored = true
	end
end

RunService.Heartbeat:Connect(function()
	if BUILD_ENABLED then
		local ray = Ray.new(Camera.CFrame.Position, Camera.CFrame.LookVector * REACH)
		local hit, pos, normal = workspace:FindPartOnRayWithIgnoreList(ray, {Preview, Player.Character})
		if hit then
			local sX, sY, sZ = CURRENT_SIZE.X, CURRENT_SIZE.Y, CURRENT_SIZE.Z
            
            local step = INCREMENT_ENABLED and CUSTOM_INC or 1
            local snapX = INCREMENT_ENABLED and step or sX
            local snapY = INCREMENT_ENABLED and step or sY
            local snapZ = INCREMENT_ENABLED and step or sZ

			local p = pos + (normal * (sY / 2))
			Preview.Position = Vector3.new(
                math.round(p.X/snapX)*snapX, 
                math.round(p.Y/snapY)*snapY, 
                math.round(p.Z/snapZ)*snapZ
            )
			Preview.Transparency = 0.5
			Preview.BrickColor = CURRENT_COLOR
		else
			Preview.Transparency = 1
		end
	else
		Preview.Transparency = 1
	end
end)

-- 3. Interaction
IncToggle.MouseButton1Click:Connect(function()
    INCREMENT_ENABLED = not INCREMENT_ENABLED
    IncToggle.Text = INCREMENT_ENABLED and "INC: ON" or "INC: OFF"
    IncToggle.BackgroundColor3 = INCREMENT_ENABLED and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(80, 80, 80)
end)

IncInput.FocusLost:Connect(function()
    CUSTOM_INC = tonumber(IncInput.Text) or 1
end)

ToggleBtn.MouseButton1Click:Connect(function()
	BUILD_ENABLED = not BUILD_ENABLED
	ToggleBtn.Text = BUILD_ENABLED and "ON" or "OFF"
	ToggleBtn.BackgroundColor3 = BUILD_ENABLED and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    Crosshair.Visible = BUILD_ENABLED
end)

-- Dragging
local dragging, dragStart, startPos
DragBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true dragStart = input.Position startPos = MainFrame.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UIS.InputEnded:Connect(function() dragging = false end)

-- Single Place Connection
PlaceBtn.MouseButton1Click:Connect(placeBlock)

WhiteBtn.MouseButton1Click:Connect(function() CURRENT_COLOR = BrickColor.new("White") end)
BlackBtn.MouseButton1Click:Connect(function() CURRENT_COLOR = BrickColor.new("Really black") end)
ClearAllBtn.MouseButton1Click:Connect(function() BuildFolder:ClearAllChildren() end)
SizeInput.FocusLost:Connect(updateSize)
