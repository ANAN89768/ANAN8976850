local setclipboard = setclipboard or toclipboard or set_clipboard

if not setclipboard then
    error("Your executor does not support setclipboard()")
end

local workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local partsToExport = {}

-- 1. Scan Workspace for all BaseParts (ignoring terrain and player characters)
for _, part in ipairs(workspace:GetDescendants()) do
    if part:IsA("BasePart") and not part:IsA("Terrain") then
        local isCharacter = false
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Character and part:IsDescendantOf(player.Character) then
                isCharacter = true
                break
            end
        end
        
        if not isCharacter then
            table.insert(partsToExport, part)
        end
    end
end

local function round(num)
    return math.floor(num * 1000 + 0.5) / 1000
end

-- Shape detection for F3X compatibility
local function getShape(part)
    local className = part.ClassName

    if className == "WedgePart" or part:IsA("WedgePart") then
        return "Wedge"
    elseif className == "CornerWedgePart" or part:IsA("CornerWedgePart") then
        return "Corner"
    elseif className == "TrussPart" or part:IsA("TrussPart") then
        return "Truss"
    end
    
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        if mesh.MeshType == Enum.MeshType.Wedge then return "Wedge"
        elseif mesh.MeshType == Enum.MeshType.Sphere then return "Ball"
        elseif mesh.MeshType == Enum.MeshType.Cylinder then return "Cylinder"
        end
    end

    if part:IsA("Part") then
        local success, shape = pcall(function() return part.Shape end)
        if success and shape then
            if shape == Enum.PartType.Ball or shape.Name == "Ball" then return "Ball"
            elseif shape == Enum.PartType.Cylinder or shape.Name == "Cylinder" then return "Cylinder"
            elseif shape.Name == "Wedge" then return "Wedge"
            end
        end
    end

    if part.Name:lower():find("wedge") then return "Wedge" end
    return "Normal"
end

-- Decal & Texture scanner capturing all properties
local function getTextures(part)
    local texList = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            local isTex = child:IsA("Texture")
            local r, g, b = 255, 255, 255
            
            if pcall(function() return child.Color3 end) and child.Color3 then
                r = math.round(child.Color3.R * 255)
                g = math.round(child.Color3.G * 255)
                b = math.round(child.Color3.B * 255)
            end

            table.insert(texList, {
                Type = child.ClassName,
                Face = child.Face.Name,
                Texture = child.Texture,
                Transparency = round(child.Transparency),
                Color = string.format("Color3.fromRGB(%d, %d, %d)", r, g, b),
                StudsPerTileU = isTex and round(child.StudsPerTileU) or 1,
                StudsPerTileV = isTex and round(child.StudsPerTileV) or 1,
                OffsetStudsU = isTex and round(child.OffsetStudsU) or 0,
                OffsetStudsV = isTex and round(child.OffsetStudsV) or 0
            })
        end
    end
    return texList
end

local serializedLines = {}

-- 2. Serialize parts, shapes, physics, transparency, and decals/textures
for _, part in ipairs(partsToExport) do
    local shape = getShape(part)
    local cf = part.CFrame
    local components = {cf:GetComponents()}
    for i, v in ipairs(components) do components[i] = round(v) end
    
    local size = part.Size
    local color = part.Color
    local r, g, b = math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255)
    
    local cfStr = string.format("CFrame.new(%s)", table.concat(components, ", "))
    local sizeStr = string.format("Vector3.new(%s, %s, %s)", round(size.X), round(size.Y), round(size.Z))
    local colorStr = string.format("Color3.fromRGB(%d, %d, %d)", r, g, b)
    local matStr = "Enum.Material." .. part.Material.Name
    
    local exactTrans = math.clamp(part.Transparency, 0, 1)
    local transStr = tostring(math.floor(exactTrans * 10000 + 0.5) / 10000)
    
    local anch = part.Anchored and "true" or "false"
    local canCollide = part.CanCollide and "true" or "false"
    
    local textures = getTextures(part)
    local texSerialized = {}
    for _, t in ipairs(textures) do
        local tLine = string.format('{Type = "%s", Face = Enum.NormalId.%s, Texture = "%s", Transparency = %s, Color = %s, StudsPerTileU = %s, StudsPerTileV = %s, OffsetStudsU = %s, OffsetStudsV = %s}',
            t.Type, t.Face, t.Texture, tostring(t.Transparency), t.Color, tostring(t.StudsPerTileU), tostring(t.StudsPerTileV), tostring(t.OffsetStudsU), tostring(t.OffsetStudsV))
        table.insert(texSerialized, tLine)
    end
    local texTableStr = "{" .. table.concat(texSerialized, ", ") .. "}"
    
    local line = string.format('    {"%s", %s, %s, %s, %s, %s, %s, %s, %s}', shape, cfStr, sizeStr, colorStr, matStr, transStr, anch, canCollide, texTableStr)
    table.insert(serializedLines, line)
end

-- 3. Construct generated F3X Recreation Script
local generatedScript = [[
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function getF3X()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:WaitForChild("Backpack")

    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    return nil
end

local tool
for i = 1, 10 do
    tool = getF3X()
    if tool then break end
    task.wait(0.5)
end

if not tool then error("F3X / Building Tools not found in character or backpack!") end

local serverEndpoint = tool:FindFirstChild("ServerEndpoint", true) or tool:FindFirstChild("SyncAPI", true)
if serverEndpoint:IsA("Folder") or serverEndpoint:IsA("ModuleScript") then
    serverEndpoint = serverEndpoint:FindFirstChild("ServerEndpoint", true) or serverEndpoint
end

local mapData = {
]] .. table.concat(serializedLines, ",\n") .. [[

}

task.spawn(function()
    print("Recreating " .. #mapData .. " parts with Decals & Textures via F3X...")
    for i, data in ipairs(mapData) do
        task.spawn(function()
            local shape, cf, size, color, mat, trans, anch, canCollide, textures = unpack(data)
            
            -- Create Base Part
            local part = serverEndpoint:InvokeServer("CreatePart", shape, cf, workspace)
            if part then
                if shape ~= "Normal" then
                    serverEndpoint:InvokeServer("SyncShape", {{Part = part, Shape = shape}})
                end
                
                serverEndpoint:InvokeServer("SyncResize", {{Part = part, Size = size, CFrame = cf}})
                serverEndpoint:InvokeServer("SyncColor", {{Part = part, Color = color}})
                serverEndpoint:InvokeServer("SyncMaterial", {{Part = part, Material = mat}})
                serverEndpoint:InvokeServer("SyncTransparency", {{Part = part, Transparency = trans}})
                serverEndpoint:InvokeServer("SyncAnchor", {{Part = part, Anchored = anch}})
                serverEndpoint:InvokeServer("SyncCollision", {{Part = part, CanCollide = canCollide}})

                -- Create and Sync Decals / Textures
                if textures and #textures > 0 then
                    for _, t in ipairs(textures) do
                        local texObj = serverEndpoint:InvokeServer("CreateTexture", part, t.Face, t.Type)
                        serverEndpoint:InvokeServer("SyncTexture", {{
                            Part = part,
                            Face = t.Face,
                            Texture = t.Texture,
                            Transparency = t.Transparency,
                            Color = t.Color,
                            StudsPerTileU = t.StudsPerTileU,
                            StudsPerTileV = t.StudsPerTileV,
                            OffsetStudsU = t.OffsetStudsU,
                            OffsetStudsV = t.OffsetStudsV
                        }})
                    end
                end
            end
        end)
        if i % 15 == 0 then task.wait(0.05) end
    end
    print("Recreation process complete!")
end)
]]

setclipboard(generatedScript)
print("Scanned " .. #partsToExport .. " parts with Decal/Texture detection! Script copied to clipboard.")
