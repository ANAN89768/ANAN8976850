-- 4. Ownership & NPC Identification
-- -------------------------------------------------------
local function hasOwnership(part)
    if isnetworkowner then
        return isnetworkowner(part)
    elseif part.GetNetworkOwner then
        local owner = part:GetNetworkOwner()
        return owner == LocalPlayer or owner == nil
    end
    return true
end

local function getClosestNPC()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local playerPos = char.HumanoidRootPart.Position
    local closestDist = math.huge
    local targetNPC = nil

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            if not Players:GetPlayerFromCharacter(obj) then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart

                if humanoid and rootPart and humanoid.Health > 0 then
                    if hasOwnership(rootPart) then
                        local dist = (rootPart.Position - playerPos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            targetNPC = obj
                        end
                    end
                end
            end
        end
    end

    return targetNPC
end

-- -------------------------------------------------------
-- 5. Command Parser & Task Management
-- -------------------------------------------------------
local function stopCurrentTask()
    if activeLoop then
        activeLoop:Disconnect()
        activeLoop = nil
    end
    if activeTask then
        task.cancel(activeTask)
        activeTask = nil
    end
    if activeNPC then
        local hum = activeNPC:FindFirstChildOfClass("Humanoid")
        local root = activeNPC:FindFirstChild("HumanoidRootPart") or activeNPC.PrimaryPart
        
        if hum then
            hum.AutoRotate = true
            hum.Sit = false
        end
        if root then
            local gyro = root:FindFirstChild("NPC_FaceGyro")
            if gyro then
                gyro:Destroy()
            end
        end
        activeNPC = nil
    end
end

local function analyzeCommandIntent(rawText)
    local text = rawText:lower():gsub("^%s*(.-)%s*$", "%1")
    for _, cmd in ipairs(COMMAND_REGISTRY) do
        for _, key in ipairs(cmd.keys) do
            if text:find(key, 1, true) then
                return cmd.intent
            end
        end
    end
    return "UNKNOWN"
end

local function getTargetRoot(query)
    local targetPlayer = findPlayer(query)
    if targetPlayer and targetPlayer.Character then
        return targetPlayer.Character:FindFirstChild("HumanoidRootPart"), targetPlayer
    end
    return nil, nil
end

-- -------------------------------------------------------
-- 6. Execution Handler
-- -------------------------------------------------------
local function processCommand(fullCommandText)
    local cleanText = fullCommandText:gsub("^%s*(.-)%s*$", "%1")
    local lowerText = cleanText:lower()

    if lowerText == "show command" or lowerText == "commands" or lowerText == "help" then
        screenGui.Enabled = true
        return
    elseif lowerText == "hide command" or lowerText == "close gui" then
        screenGui.Enabled = false
        return
    end

    local npc = getClosestNPC()
    if not npc then
        warn("[NPC COMMANDER] No controllable NPC found nearby or ownership missing.")
        return
    end

    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart
    if not humanoid or not rootPart then return end

    stopCurrentTask()

    -- 1. BNG Command (.bng <plr|me>)
    if lowerText:sub(1, 3) == "bng" then
        local targetQuery = cleanText:sub(4)
        local targetRoot, targetPlayer = getTargetRoot(targetQuery)
        
        if not targetRoot or not targetPlayer then
            warn("[NPC COMMANDER] Player not found for .bng: " .. targetQuery)
            return
        end

        activeNPC = npc
        humanoid.AutoRotate = false

        local gyro = Instance.new("BodyGyro")
        gyro.Name = "NPC_FaceGyro"
        gyro.MaxTorque = Vector3.new(0, 400000, 0)
        gyro.P = 20000
        gyro.D = 100
        gyro.Parent = rootPart

        -- Instant initial TP behind target
        rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2)

        -- Continuous BodyGyro facing
        activeLoop = RunService.Heartbeat:Connect(function()
            local currentTChar = targetPlayer.Character
            local currentTRoot = currentTChar and currentTChar:FindFirstChild("HumanoidRootPart")

            if currentTRoot and rootPart and humanoid and humanoid.Health > 0 then
                gyro.CFrame = CFrame.lookAt(
                    rootPart.Position,
                    Vector3.new(currentTRoot.Position.X, rootPart.Position.Y, currentTRoot.Position.Z)
                )
            else
                stopCurrentTask()
            end
        end)

        -- Back and forth pacing (1 stud and 5 studs)
        activeTask = task.spawn(function()
            local closeDistance = true
            while humanoid and humanoid.Health > 0 and rootPart do
                local currentTChar = targetPlayer.Character
                local currentTRoot = currentTChar and currentTChar:FindFirstChild("HumanoidRootPart")

                if currentTRoot then
                    local targetOffset = closeDistance and 1 or 5
                    local movePos = (currentTRoot.CFrame * CFrame.new(0, 0, targetOffset)).Position
                    humanoid:MoveTo(movePos)
                    closeDistance = not closeDistance
                    task.wait(0.5)
                else
                    break
                end
            end
        end)
        return
    end

    -- 2. Headsit Command (.headsit <plr|me> | .hs <plr|me>)
    if lowerText:sub(1, 7) == "headsit" or lowerText:sub(1, 2) == "hs" then
        local targetQuery = cleanText:gsub("^%s*headsit%s*", ""):gsub("^%s*hs%s*", "")
        local targetRoot, targetPlayer = getTargetRoot(targetQuery)

        if not targetRoot or not targetPlayer then
            warn("[NPC COMMANDER] Target player not found for headsit: " .. targetQuery)
            return
        end

        activeNPC = npc
        humanoid.Sit = true

        activeLoop = RunService.Heartbeat:Connect(function()
            local tChar = targetPlayer.Character
            local tHead = tChar and tChar:FindFirstChild("Head")

            if tHead and rootPart and humanoid and humanoid.Health > 0 then
                humanoid.Sit = true
                rootPart.CFrame = tHead.CFrame * CFrame.new(0, 1.5, 0)
            else
                stopCurrentTask()
            end
        end)
        return
    end

    -- 3. Follow (.follow <plr|me>)
    if lowerText:sub(1, 6) == "follow" and not lowerText:find("dont") and not lowerText:find("don't") and not lowerText:find("unfollow") then
        local targetQuery = cleanText:sub(7)
        local targetRoot, targetPlayer = getTargetRoot(targetQuery)
        if not targetRoot or not targetPlayer then
            warn("[NPC COMMANDER] Target not found for follow: " .. targetQuery)
            return
        end

        activeLoop = RunService.Heartbeat:Connect(function()
            local tChar = targetPlayer.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if tRoot and rootPart and humanoid then
                local pPos = tRoot.Position
                local nPos = rootPart.Position
                if (pPos - nPos).Magnitude > 4 then
                    local dir = (nPos - pPos).Unit
                    humanoid:MoveTo(pPos + (dir * 4))
                else
                    humanoid:MoveTo(nPos)
                end
            end
        end)
        return
    end

    -- 4. Come (.come <plr|me>)
    if lowerText:sub(1, 4) == "come" then
        local targetQuery = cleanText:sub(5):gsub("^%s*here%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            local pPos = targetRoot.Position
            local nPos = rootPart.Position
            local dist = (pPos - nPos).Magnitude
            if dist > 4 then
                local dir = (nPos - pPos).Unit
                humanoid:MoveTo(pPos + (dir * 4))
            else
                humanoid:MoveTo(nPos)
            end
        end
        return
    end

    -- 5. Teleport / Bring (.tp <plr|me> | .bring <plr|me>)
    if (lowerText:sub(1, 5) == "tp to" or lowerText:sub(1, 5) == "bring" or lowerText:sub(1, 2) == "tp") and not lowerText:find("mouse") then
        local targetQuery = ""
        if lowerText:sub(1, 5) == "tp to" then
            targetQuery = cleanText:sub(6)
        elseif lowerText:sub(1, 5) == "bring" then
            targetQuery = cleanText:sub(6)
        else
            targetQuery = cleanText:sub(3)
        end
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            rootPart.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -4)
        end
        return
    end

    -- 6. Positional Offsets (.behind, .in front, .left, .right)
    if lowerText:find("behind") then
        local targetQuery = cleanText:gsub("^%s*behind%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            humanoid:MoveTo((targetRoot.CFrame * CFrame.new(0, 0, 4)).Position)
        end
        return
    elseif lowerText:find("front") then
        local targetQuery = cleanText:gsub("^%s*in%s*front%s*", ""):gsub("^%s*front%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            humanoid:MoveTo((targetRoot.CFrame * CFrame.new(0, 0, -4)).Position)
        end
        return
    elseif lowerText:find("left") then
        local targetQuery = cleanText:gsub("^%s*left%s*side%s*", ""):gsub("^%s*left%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            humanoid:MoveTo((targetRoot.CFrame * CFrame.new(-4, 0, 0)).Position)
        end
        return
    elseif lowerText:find("right") then
        local targetQuery = cleanText:gsub("^%s*right%s*side%s*", ""):gsub("^%s*right%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            humanoid:MoveTo((targetRoot.CFrame * CFrame.new(4, 0, 0)).Position)
        end
        return
    end

    -- 7. Look At / Face (.look at <plr|me> | .face <plr|me>)
    if lowerText:find("look at") or lowerText:find("face") then
        local targetQuery = cleanText:gsub("^%s*look%s*at%s*", ""):gsub("^%s*face%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(targetRoot.Position.X, rootPart.Position.Y, targetRoot.Position.Z))
        end
        return
    end

    -- 8. Look Away (.look away <plr|me>)
    if lowerText:find("look away") then
        local targetQuery = cleanText:gsub("^%s*look%s*away%s*", "")
        local targetRoot = getTargetRoot(targetQuery)
        if targetRoot then
            local dir = (rootPart.Position - targetRoot.Position).Unit
            rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + dir)
        end
        return
    end

    -- 9. Orbit (.orbit <plr|me>)
    if lowerText:find("orbit") then
        local targetQuery = cleanText:gsub("^%s*orbit%s*", "")
        local targetRoot, targetPlayer = getTargetRoot(targetQuery)
        if targetRoot and targetPlayer then
            local angle = 0
            activeLoop = RunService.Heartbeat:Connect(function()
                local tChar = targetPlayer.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if tRoot then
                    angle = angle + 0.05
                    local offset = Vector3.new(math.cos(angle) * 6, 0, math.sin(angle) * 6)
                    humanoid:MoveTo(tRoot.Position + offset)
                end
            end)
        end
        return
    end

    -- Standard Non-Target Commands
    local intent = analyzeCommandIntent(cleanText)

    if intent == "STOP" then
        humanoid:MoveTo(rootPart.Position)
    elseif intent == "MOVE_TO_MOUSE" then
        humanoid:MoveTo(Mouse.Hit.Position)
    elseif intent == "JUMP" then
        humanoid.Jump = true
    elseif intent == "SPEED_FAST" then humanoid.WalkSpeed = 28
    elseif intent == "SPEED_NORMAL" then humanoid.WalkSpeed = 16
    elseif intent == "SPEED_SLOW" then humanoid.WalkSpeed = 8
    elseif intent == "SPEED_SUPER" then humanoid.WalkSpeed = 50
    elseif intent == "TP_MOUSE" then
        rootPart.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, 3, 0))
    elseif intent == "SIT" then humanoid.Sit = true
    elseif intent == "STAND" then humanoid.Sit = false; humanoid.PlatformStand = false
    elseif intent == "RAGDOLL" then humanoid.PlatformStand = true
    elseif intent == "UNRAGDOLL" then humanoid.PlatformStand = false
    elseif intent == "SPIN" then
        activeLoop = RunService.Heartbeat:Connect(function()
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(12), 0)
        end)
    elseif intent == "PATROL" then
        local startPos = rootPart.Position
        local targetPos = startPos + Vector3.new(15, 0, 0)
        local movingToTarget = true
        activeLoop = RunService.Heartbeat:Connect(function()
            local dest = movingToTarget and targetPos or startPos
            humanoid:MoveTo(dest)
            if (rootPart.Position - dest).Magnitude < 3 then
                movingToTarget = not movingToTarget
            end
        end)
    elseif intent == "FLOAT" then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "NPC_Float"
        bv.Velocity = Vector3.new(0, 10, 0)
        bv.MaxForce = Vector3.new(0, 9e9, 0)
        bv.Parent = rootPart
    elseif intent == "UNFLOAT" then
        local bv = rootPart:FindFirstChild("NPC_Float")
        if bv then bv:Destroy() end
    elseif intent == "FLIP" then
        rootPart.Velocity = Vector3.new(0, 45, 0)
        for i = 1, 30 do
            rootPart.CFrame = rootPart.CFrame * CFrame.Angles(math.rad(12), 0, 0)
            task.wait(0.01)
        end
    end
end

-- -------------------------------------------------------
-- 7. Chat Listener Hook
-- -------------------------------------------------------
local function handleChat(message)
    if message:sub(1, #PREFIX):lower() == PREFIX:lower() then
        local command = message:sub(#PREFIX + 1)
        processCommand(command)
    end
end

if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.OnIncomingMessage = function(message)
        if message.TextSource and message.TextSource.UserId == LocalPlayer.UserId then
            handleChat(message.Text)
        end
    end
else
    LocalPlayer.Chatted:Connect(handleChat)
end

