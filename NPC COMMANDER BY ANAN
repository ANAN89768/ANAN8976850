-- -------------------------------------------------------
-- 1. Helper: Find Player by Partial Name / DisplayName / "me"
-- -------------------------------------------------------
local function findPlayer(query)
    query = query:lower():gsub("^%s*(.-)%s*$", "%1")
    if query == "" or query == "me" or query == "myself" then
        return LocalPlayer
    end

    -- Direct / Prefix Match
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower():sub(1, #query) == query or player.DisplayName:lower():sub(1, #query) == query then
            return player
        end
    end

    -- Substring Search Fallback
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower():find(query, 1, true) or player.DisplayName:lower():find(query, 1, true) then
            return player
        end
    end

    return nil
end

