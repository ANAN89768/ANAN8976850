-- F3X FE All Rigs Anim Filter Bypasser V6.7

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local function getF3X()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local backpack = LocalPlayer:WaitForChild("Backpack")
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:lower():find("f3x") or item.Name:lower():find("build")) then return item end
    end
    return nil
end

local tool = getF3X()
if not tool then error("❌ F3X Tool not found in Character or Backpack!") end

local serverEndpoint = tool:FindFirstChild("ServerEndpoint", true) or tool:FindFirstChild("SyncAPI", true)
if serverEndpoint:IsA("Folder") or serverEndpoint:IsA("ModuleScript") then
    serverEndpoint = serverEndpoint:FindFirstChild("ServerEndpoint", true) or serverEndpoint
end

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

print("⚡ F3X FE ALL RIGS ANIM FILTER BYPASSER V6.7 INITIALIZED FOR: " .. character.Name .. " ⚡")

-- Universal mesh extraction supporting MeshParts, SpecialMeshes, & R6 CharacterMeshes
local function extractMeshInfo(part)
    if not part then return nil end
    
    local specialMesh = part:FindFirstChildOfClass("SpecialMesh")
    if specialMesh then
        return {
            MeshType = specialMesh.MeshType,
            MeshId = specialMesh.MeshId,
            TextureId = specialMesh.TextureId,
            Scale = specialMesh.Scale,
            Offset = specialMesh.Offset,
            VertexColor = specialMesh.VertexColor
        }
    end
    
    if part:IsA("MeshPart") then
        return {
            MeshType = Enum.MeshType.FileMesh,
            MeshId = part.MeshId,
            TextureId = part.TextureID,
            Scale = Vector3.new(1, 1, 1),
            Offset = Vector3.new(0, 0, 0),
            VertexColor = Vector3.new(1, 1, 1)
        }
    end

    local r6BodyPartMap = {
        ["Torso"] = Enum.BodyPart.Torso,
        ["Left Arm"] = Enum.BodyPart.LeftArm,
        ["Right Arm"] = Enum.BodyPart.RightArm,
        ["Left Leg"] = Enum.BodyPart.LeftLeg,
        ["Right Leg"] = Enum.BodyPart.RightLeg,
    }
    local bodyEnum = r6BodyPartMap[part.Name]
    if bodyEnum then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("CharacterMesh") and child.BodyPart == bodyEnum then
                local meshId = "rbxassetid://" .. tostring(child.MeshId)
                local textureId = ""
                if child.BaseTextureId > 0 then
                    textureId = "rbxassetid://" .. tostring(child.BaseTextureId)
                elseif child.OverlayTextureId > 0 then
                    textureId = "rbxassetid://" .. tostring(child.OverlayTextureId)
                end
                return {
                    MeshType = Enum.MeshType.FileMesh,
                    MeshId = meshId,
                    TextureId = textureId,
                    Scale = Vector3.new(1, 1, 1),
                    Offset = Vector3.new(0, 0, 0),
                    VertexColor = Vector3.new(1, 1, 1)
                }
            end
        end
    end

    return nil
end

task.spawn(function()
    local createdRigParts = {}
    local rawFakePartsList = {}
    local createQueue = {}

    -- Scan character parts while strictly ignoring HumanoidRootPart
    for _, child in ipairs(character:GetChildren()) do
        if child.Name == "HumanoidRootPart" then
            continue
        end

        if child:IsA("BasePart") then
            local isHead = (child.Name == "Head")
            table.insert(createQueue, {
                Name = child.Name,
                TargetPart = child,
                CFrame = child.CFrame,
                Size = child.Size,
                Color = child.Color,
                Material = child.Material,
                IsHead = isHead,
                IsAccessory = false,
                MeshInfo = extractMeshInfo(child)
            })
        elseif child:IsA("Accessory") then
            local handle = child:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                table.insert(createQueue, {
                    Name = child.Name,
                    TargetPart = handle,
                    CFrame = handle.CFrame,
                    Size = handle.Size,
                    Color = handle.Color,
                    Material = handle.Material,
                    IsHead = false,
                    IsAccessory = true,
                    MeshInfo = extractMeshInfo(handle)
                })
            end
        end
    end

    -- 1. USE F3X TO DUPLICATE / CREATE PARTS
    for _, item in ipairs(createQueue) do
        local ok, newPart = pcall(function()
            return serverEndpoint:InvokeServer("CreatePart", "Normal", item.CFrame, workspace)
        end)
        
        if ok and newPart then
            local finalSize = item.IsHead and Vector3.new(1.25, 1.25, 1.25) or item.Size

            table.insert(createdRigParts, {
                Name = item.Name,
                FakePart = newPart,
                RealPart = item.TargetPart,
                Size = finalSize,
                Color = item.Color,
                Material = item.Material,
                IsHead = item.IsHead,
                IsAccessory = item.IsAccessory,
                MeshInfo = item.MeshInfo
            })
            table.insert(rawFakePartsList, newPart)
        end
    end

    task.wait(0.1)

    -- 2. USE F3X TO SET PROPERTIES, ANCHOR THEM, AND REMOVE JOINTS (VIA NO COLLISION/ANCHOR)
    local resizeBatch = {}
    local anchorBatch = {}
    local collideBatch = {}
    local colorBatch = {}
    local materialBatch = {}
    local hideRealLimbsBatch = {}

    -- Create clothing container model wrapper for clothing support
    local fakeCharacterModel = Instance.new("Model")
    fakeCharacterModel.Name = "FEClothingModel"
    local fakeHumanoid = Instance.new("Humanoid")
    fakeHumanoid.Parent = fakeCharacterModel
    fakeCharacterModel.Parent = workspace

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") then
            child:Clone().Parent = fakeCharacterModel
        end
    end

    for _, data in ipairs(createdRigParts) do
        local fake = data.FakePart
        local real = data.RealPart

        -- Parent fake parts inside clothing model for native texture unwrapping
        fake.Parent = fakeCharacterModel
        fake.Name = data.Name

        table.insert(resizeBatch, {Part = fake, Size = data.Size, CFrame = real.CFrame})
        table.insert(anchorBatch, {Part = fake, Anchored = true}) -- Fully Anchored via F3X
        table.insert(collideBatch, {Part = fake, CanCollide = false}) -- Joint separation behavior simulation
        table.insert(colorBatch, {Part = fake, Color = data.Color})
        table.insert(materialBatch, {Part = fake, Material = data.Material})
        
        table.insert(hideRealLimbsBatch, {Part = real, Transparency = 1})
    end

    pcall(function() serverEndpoint:InvokeServer("SyncResize", resizeBatch) end)
    pcall(function() serverEndpoint:InvokeServer("SyncAnchor", anchorBatch) end)
    pcall(function() serverEndpoint:InvokeServer("SyncCollision", collideBatch) end)
    pcall(function() serverEndpoint:InvokeServer("SyncColor", colorBatch) end)
    pcall(function() serverEndpoint:InvokeServer("SyncMaterial", materialBatch) end)
    pcall(function() serverEndpoint:InvokeServer("SyncTransparency", hideRealLimbsBatch) end)

    -- 3. USE F3X TO APPLY MESHES & FACES
    local meshCreateBatch = {}
    local meshSyncBatch = {}

    for _, data in ipairs(createdRigParts) do
        if data.IsHead then
            table.insert(meshCreateBatch, {Part = data.FakePart})
            table.insert(meshSyncBatch, {
                Part = data.FakePart, 
                MeshType = Enum.MeshType.Head, 
                Scale = Vector3.new(1, 1, 1) 
            })
            
            pcall(function()
                serverEndpoint:InvokeServer("CreateTextures", {
                    {Part = data.FakePart, Face = Enum.NormalId.Front, TextureType = "Decal"}
                })
            end)
            pcall(function()
                serverEndpoint:InvokeServer("SyncTexture", {
                    {
                        Part = data.FakePart,
                        Face = Enum.NormalId.Front,
                        TextureType = "Decal",
                        Texture = "rbxassetid://144080495",
                        Transparency = 0
                    }
                })
            end)

        elseif data.MeshInfo then
            table.insert(meshCreateBatch, {Part = data.FakePart})
            table.insert(meshSyncBatch, {
                Part = data.FakePart,
                MeshType = data.MeshInfo.MeshType,
                MeshId = data.MeshInfo.MeshId,
                TextureId = data.MeshInfo.TextureId,
                Scale = data.MeshInfo.Scale,
                Offset = data.MeshInfo.Offset,
                VertexColor = data.MeshInfo.VertexColor
            })
        end
    end

    if #meshCreateBatch > 0 then
        pcall(function() serverEndpoint:InvokeServer("CreateMeshes", meshCreateBatch) end)
        pcall(function() serverEndpoint:InvokeServer("SyncMesh", meshSyncBatch) end)
    end

    -- 4. REAL CHARACTER INVISIBILITY & FACE REMOVAL OVERRIDE LOOP
    local realPartsToHide = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BasePart") then
            table.insert(realPartsToHide, child)
        elseif child:IsA("Accessory") and child:FindFirstChild("Handle") then
            table.insert(realPartsToHide, child.Handle)
        end
    end

    local hideLoop = RunService.RenderStepped:Connect(function()
        for _, part in ipairs(realPartsToHide) do
            if part and part.Parent then
                part.Transparency = 1
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("Decal") or child:IsA("Texture") then
                        child.Transparency = 1
                    end
                end
            end
        end
    end)

    -- 5. USE F3X SYNC MOVE TO ANIMATE ROTATION AND POSITIONING CONTINUOUSLY
    local trackingConnection
    local lastUpdate = 0
    local UPDATE_INTERVAL = 0.03

    trackingConnection = RunService.Heartbeat:Connect(function(dt)
        lastUpdate = lastUpdate + dt
        if lastUpdate >= UPDATE_INTERVAL then
            lastUpdate = 0
            
            local moveBatch = {}
            for _, data in ipairs(createdRigParts) do
                if data.FakePart and data.RealPart and data.RealPart.Parent then
                    table.insert(moveBatch, {
                        Part = data.FakePart,
                        CFrame = data.RealPart.CFrame
                    })
                end
            end

            if #moveBatch > 0 then
                pcall(function()
                    serverEndpoint:InvokeServer("SyncMove", moveBatch)
                end)
            end
        end
    end)

    -- 6. AUTO-CLEANUP ON DEATH
    local function cleanup()
        if hideLoop then hideLoop:Disconnect() end
        if trackingConnection then trackingConnection:Disconnect() end
        if fakeCharacterModel then fakeCharacterModel:Destroy() end

        if #rawFakePartsList > 0 then
            pcall(function()
                serverEndpoint:InvokeServer("Remove", rawFakePartsList)
            end)
        end
    end

    humanoid.Died:Connect(cleanup)
end)
