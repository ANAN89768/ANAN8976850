end)

local function getTargetAtCenter()
    local viewportSize = Camera.ViewportSize
    local centerRay = Camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    end

    local result = Workspace:Raycast(centerRay.Origin, centerRay.Direction * reachDistance, raycastParams)
    
    if result and result.Instance then
        local hitPart = result.Instance
        if hitPart.Anchored then return hitPart, "anchored" end
        return hitPart, "unanchored"
    end
    return nil, "none"
end

local function checkNetworkOwnership(part)
    if not part or not part:IsA("BasePart") or part.Anchored then return false end
    
    if typeof(isnetworkowner) == "function" then
        return isnetworkowner(part)
    end
    
    return part:ReceiveAge() > 0
end

local function possessesModelOwnership(part)
    if not part then return false end
    
    local ancestor = part.Parent
    local container = nil
    
    while ancestor and ancestor ~= Workspace do
        if ancestor:IsA("Model") or ancestor:IsA("Folder") then
            container = ancestor
        end
        ancestor = ancestor.Parent
    end
    
    if not container then return false end
    
    for _, desc in ipairs(container:GetDescendants()) do
        if desc:IsA("BasePart") and desc ~= part then
            if checkNetworkOwnership(desc) then
                return true
            end
        end
    end
    
    return false
end

local function reclaimOwnershipRoutine(part)
    if isReclaiming or not part or not part:IsA("BasePart") then return end
    isReclaiming = true
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        isReclaiming = false
        return 
    end
    local root = char.HumanoidRootPart

    local savedRootCF = root.CFrame
    local savedCamCF = Camera.CFrame

    root.CFrame = part.CFrame
    
    if typeof(firetouchinterest) == "function" then
        firetouchinterest(root, part, 0)
        task.wait()
        firetouchinterest(root, part, 1)
    else
        task.wait(0.04)
    end

    root.CFrame = savedRootCF
    Camera.CFrame = savedCamCF

    task.wait(0.08)
    isReclaiming = false
end

local function setRotateState(enabled)
    isRotating = enabled
    if isRotating then
        rotButton.Text = "ROT: ON"
        rotButton.BackgroundColor3 = Color3.fromRGB(0, 255, 170)
        rotButton.TextColor3 = Color3.fromRGB(15, 15, 25)
        
        Camera.CameraType = Enum.CameraType.Scriptable
    else
        rotButton.Text = "ROT: OFF"
        rotButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        rotButton.TextColor3 = Color3.fromRGB(200, 200, 200)
        isDraggingRotate = false
        lastRotatePos = nil
        
        Camera.CameraType = Enum.CameraType.Custom
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if isHolding and isRotating and not gpe then
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDraggingRotate = true
            lastRotatePos = input.Position
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if isHolding and isRotating and isDraggingRotate and lastRotatePos then
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - lastRotatePos
            lastRotatePos = input.Position
            
            if targetPart and targetPart:IsA("BasePart") then
                local rotSpeed = 0.012
                local pitch = CFrame.Angles(delta.Y * rotSpeed, 0, 0)
                local yaw = CFrame.Angles(0, delta.X * rotSpeed, 0)
                targetPart.CFrame = targetPart.CFrame * pitch * yaw
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingRotate = false
        lastRotatePos = nil
    end
end)

