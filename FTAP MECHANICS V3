local function startTelekinesis()
    local target, status = getTargetAtCenter()
    
    if status == "unanchored" and target then
        targetPart = target
        isHolding = true
        grabDistance = math.clamp((target.Position - Camera.CFrame.Position).Magnitude, minDistance, maxDistance)
        
        if not checkNetworkOwnership(targetPart) and not possessesModelOwnership(targetPart) then
            reclaimOwnershipRoutine(targetPart)
        end
        
        mainButton.Text = "DROP"
        mainButton.TextColor3 = Color3.fromRGB(255, 170, 0)
        throwButton.Visible = true
        plusButton.Visible = true
        minusButton.Visible = true
        rotButton.Visible = true
    end
end

local function stopTelekinesis()
    if isHolding and targetPart then
        if isRotating then
            setRotateState(false)
        end

        Camera.CameraType = Enum.CameraType.Custom

        if targetPart and targetPart:IsA("BasePart") then
            targetPart.AssemblyLinearVelocity = Vector3.zero
            targetPart.AssemblyAngularVelocity = Vector3.zero
        end

        isHolding = false
        isPushing = false
        isPulling = false
        targetPart = nil
        
        mainButton.Text = "GRAB"
        mainButton.TextColor3 = Color3.fromRGB(0, 255, 170)
        throwButton.Visible = false
        plusButton.Visible = false
        minusButton.Visible = false
        rotButton.Visible = false
    end
end

local function throwObject()
    if isHolding and targetPart then
        local launchPart = targetPart
        stopTelekinesis()
        launchPart.AssemblyLinearVelocity = Camera.CFrame.LookVector * throwPower
    end
end

mainButton.Activated:Connect(function()
    if not isHolding then startTelekinesis() else stopTelekinesis() end
end)

throwButton.Activated:Connect(function()
    if isHolding then throwObject() end
end)

rotButton.Activated:Connect(function()
    if isHolding then setRotateState(not isRotating) end
end)

RunService.Heartbeat:Connect(function()
    local now = os.clock()
    
    if isHolding and targetPart then
        if not targetPart.Parent or (targetPart.Anchored and not isReclaiming) then
            stopTelekinesis()
            return
        end

        if (now - lastOwnerCheck) > 0.1 then
            lastOwnerCheck = now
            if not isReclaiming then
                local hasDirectOwnership = checkNetworkOwnership(targetPart)
                local hasModelOwnership = possessesModelOwnership(targetPart)
                
                if not hasDirectOwnership and not hasModelOwnership then
                    task.spawn(function()
                        reclaimOwnershipRoutine(targetPart)
                    end)
                end
            end
        end

        local stepSpeed = math.max(1.8, grabDistance * 0.06)
        if isPushing then
            grabDistance = math.min(grabDistance + stepSpeed, maxDistance)
        elseif isPulling then
            grabDistance = math.max(grabDistance - stepSpeed, minDistance)
        end
        
        if not isReclaiming then
            local targetCFrame = Camera.CFrame * CFrame.new(0, 0, -grabDistance)
            local delta = (targetCFrame.Position - targetPart.Position)
            local calculatedVelocity = delta * 22
            
            if calculatedVelocity.Magnitude > 350 then
                calculatedVelocity = calculatedVelocity.Unit * 350
            end
            
            targetPart.AssemblyLinearVelocity = calculatedVelocity
            
            if not isRotating then
                targetPart.AssemblyAngularVelocity = targetPart.AssemblyAngularVelocity * 0.85
            end
        end
        
        crosshair.BackgroundColor3 = Color3.fromRGB(0, 255, 170)
    else
        if (now - lastRaycastCheck) > 0.2 then
            lastRaycastCheck = now
            local _, status = getTargetAtCenter()
            if status == "unanchored" then
                crosshair.BackgroundColor3 = Color3.fromRGB(0, 255, 170)
            elseif status == "anchored" then
                crosshair.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            else
                crosshair.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            end
        end
    end
end)
