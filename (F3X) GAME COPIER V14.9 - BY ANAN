    local anch = "true"
    local canCollide = part.CanCollide and "true" or "false"
    local texStr = getTextures(part)
    local surfStr = getSurfaces(part)
    
    local line = string.format(
        '  {%q, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s}',
        shape, cfStr, sizeStr, colorStr, matStr, tostring(transNum), anch, canCollide, texStr, meshStr, surfStr
    )
    table.insert(serializedLines, line)
end

