local CURRENT_COLOR = BrickColor.new("White")
local CURRENT_ROTATION = 0 
local CURRENT_MATERIAL = Enum.Material.SmoothPlastic

-- History Logic
local History = {}
local RedoStack = {}

-- Services
local Player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")

local BuildFolder = workspace:FindFirstChild("DeltaBuilds") or Instance.new("Folder", workspace)
BuildFolder.Name = "DeltaBuilds"

-- 1. GUI Setup
