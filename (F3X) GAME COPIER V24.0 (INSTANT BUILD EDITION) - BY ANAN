-- Helper to check if a part belongs to an active player's character
local function isPlayerPart(part)
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char and part:IsDescendantOf(char) then
            return true
        end
    end
    return false
end

-- Helper to verify if an instance is a valid part (Includes MeshParts; Excludes Terrain, Unions, Negates, and Character Parts)
local function isValidPart(part)
    if not part:IsA("BasePart") or part:IsA("Terrain") then return false end
    if part:IsA("UnionOperation") or part:IsA("NegateOperation") then return false end
    if isPlayerPart(part) then return false end
    return true
end

-- Asset ID Parser Helper
local function extractAssetId(val)
    if not val then return "" end
    local str = tostring(val)
    return str:match("(%d+)") or ""
end

-- String Escaping Helper
local function escapeString(str)
    if type(str) ~= "string" then return '""' end
    return string.format("%q", str)
end

-- Number Rounding Helper
local function round(num)
    if type(num) ~= "number" then return 0 end
    return math.floor(num * 10000 + 0.5) / 10000
end

-- Vector3 Serialization Helper
local function serializeVector3(vec)
    if typeof(vec) ~= "Vector3" then return "Vector3.new(1, 1, 1)" end
    return string.format("Vector3.new(%s, %s, %s)", round(vec.X), round(vec.Y), round(vec.Z))
end

-- CFrame Serialization Helper
local function serializeCFrame(cf)
    local comps = {cf:GetComponents()}
    for i, v in ipairs(comps) do comps[i] = round(v) end
    return string.format("CFrame.new(%s)", table.concat(comps, ", "))
end

-- Color3 Serialization Helper
local function serializeColor3(col)
    return string.format("Color3.fromRGB(%d, %d, %d)", math.round(col.R * 255), math.round(col.G * 255), math.round(col.B * 255))
end

