-- Surface Serialization
local function getSurfaces(part)
    local faces = {"Top", "Bottom", "Front", "Back", "Left", "Right"}
    local sTypes = {}
    local hasCustom = false
    for _, face in ipairs(faces) do
        local ok, surf = pcall(function() return part[face .. "Surface"] end)
        if ok and surf and typeof(surf) == "EnumItem" then
            local name = surf.Name
            if pcall(function() return Enum.SurfaceType[name] end) then
                sTypes[face] = "Enum.SurfaceType." .. name
                if name ~= "Smooth" and name ~= "SmoothNoOutlines" then
                    hasCustom = true
                end
            else
                sTypes[face] = "Enum.SurfaceType.Smooth"
            end
        else
            sTypes[face] = "Enum.SurfaceType.Smooth"
        end
    end
    if not hasCustom then return "nil" end
    return string.format(
        "{Top = %s, Bottom = %s, Front = %s, Back = %s, Left = %s, Right = %s}",
        sTypes.Top, sTypes.Bottom, sTypes.Front, sTypes.Back, sTypes.Left, sTypes.Right
    )
end

-- Multi-Side Texture & Decal Serialization (Detects Every Side/Face)
local function getTextures(part)
    local list = {}
    local faceMapping = {
        Top = "Enum.NormalId.Top",
        Bottom = "Enum.NormalId.Bottom",
        Front = "Enum.NormalId.Front",
        Back = "Enum.NormalId.Back",
        Left = "Enum.NormalId.Left",
        Right = "Enum.NormalId.Right"
    }
    
    for _, child in ipairs(part:GetDescendants()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            local isTex = child:IsA("Texture")
            local rawTex = child.Texture or ""
            local cleanId = extractAssetId(rawTex)
            if cleanId ~= "" then
                local r, g, b = 255, 255, 255
                pcall(function()
                    if child.Color3 then
                        local col = child.Color3
                        r = math.round(col.R * 255)
                        g = math.round(col.G * 255)
                        b = math.round(col.B * 255)
                    end
                end)
                local faceName = child.Face and child.Face.Name or "Front"
                local faceEnumStr = faceMapping[faceName] or "Enum.NormalId.Front"
                local trans = round(child.Transparency or 0)
                local uStuds, vStuds, uOffset, vOffset = 1, 1, 0, 0
                if isTex then
                    pcall(function() uStuds = round(child.StudsPerTileU or 1) end)
                    pcall(function() vStuds = round(child.StudsPerTileV or 1) end)
                    pcall(function() uOffset = round(child.OffsetStudsU or 0) end)
                    pcall(function() vOffset = round(child.OffsetStudsV or 0) end)
                end
                local entry = string.format(
                    '{Type = %s, Face = %s, Texture = %s, Transparency = %s, Color = Color3.fromRGB(%d, %d, %d), StudsPerTileU = %s, StudsPerTileV = %s, OffsetStudsU = %s, OffsetStudsV = %s}',
                    escapeString(child.ClassName), faceEnumStr, escapeString(cleanId), tostring(trans), r, g, b, tostring(uStuds), tostring(vStuds), tostring(uOffset), tostring(vOffset)
                )
                table.insert(list, entry)
            end
        end
    end
    if #list == 0 then return "nil" end
    return "{" .. table.concat(list, ", ") .. "}"
end

-- Comprehensive Mesh Data Extractor with Left-to-Right Cylinder Axis Correction
local function getMeshInfo(part)
    local meshInfo = nil

    local sm = part:FindFirstChildOfClass("SpecialMesh")
    local bm = part:FindFirstChildOfClass("BlockMesh")
    local cm = part:FindFirstChildOfClass("CylinderMesh")
    local charM = part:FindFirstChildOfClass("CharacterMesh")

    if part:IsA("MeshPart") then
        local meshId = extractAssetId(part.MeshId)
        local textureId = extractAssetId(part.TextureID)
        if meshId ~= "" then
            local mScale = Vector3.new(1, 1, 1)
            local mOffset = Vector3.new(0, 0, 0)
            if sm then
                mScale = sm.Scale or Vector3.new(1, 1, 1)
                mOffset = sm.Offset or Vector3.new(0, 0, 0)
            else
                local ok, meshSize = pcall(function() return part.MeshSize end)
                if ok and typeof(meshSize) == "Vector3" and meshSize.X > 0 and meshSize.Y > 0 and meshSize.Z > 0 then
                    mScale = Vector3.new(part.Size.X / meshSize.X, part.Size.Y / meshSize.Y, part.Size.Z / meshSize.Z)
                end
            end
            meshInfo = {
                MeshType = "FileMesh",
                MeshId = meshId,
                TextureId = textureId,
                Scale = mScale,
                Offset = mOffset
            }
        end
    elseif sm then
        local meshId = extractAssetId(sm.MeshId)
        local textureId = extractAssetId(sm.TextureId)
        local mOffset = sm.Offset or Vector3.new(0, 0, 0)
        local mScale = sm.Scale or Vector3.new(1, 1, 1)
        local mTypeName = "FileMesh"
        pcall(function() mTypeName = sm.MeshType.Name end)
        
        if mTypeName == "Cylinder" then
            mScale = Vector3.new(mScale.Y, mScale.X, mScale.Z)
        end

        meshInfo = {
            MeshType = mTypeName,
            MeshId = meshId,
            TextureId = textureId,
            Scale = mScale,
            Offset = mOffset
        }
    elseif bm then
        local mOffset = bm.Offset or Vector3.new(0, 0, 0)
        local mScale = bm.Scale or Vector3.new(1, 1, 1)
        meshInfo = {
            MeshType = "Brick",
            MeshId = "",
            TextureId = "",
            Scale = mScale,
            Offset = mOffset
        }
    elseif cm then
        local mOffset = cm.Offset or Vector3.new(0, 0, 0)
        local mScale = cm.Scale or Vector3.new(1, 1, 1)
        mScale = Vector3.new(mScale.Y, mScale.X, mScale.Z)
        meshInfo = {
            MeshType = "Cylinder",
            MeshId = "",
            TextureId = "",
            Scale = mScale,
            Offset = mOffset
        }
    elseif charM then
        local meshId = extractAssetId(charM.MeshId)
        local baseTex = extractAssetId(charM.BaseTextureId or charM.OverlayTextureId)
        meshInfo = {
            MeshType = "FileMesh",
            MeshId = meshId,
            TextureId = baseTex,
            Scale = Vector3.new(1, 1, 1),
            Offset = Vector3.new(0, 0, 0)
        }
    end

    if meshInfo then
        local mTypeEnum = "Enum.MeshType." .. (Enum.MeshType[meshInfo.MeshType] and meshInfo.MeshType or "FileMesh")
        return string.format(
            '{MeshType = %s, MeshId = %s, TextureId = %s, Scale = %s, Offset = %s}',
            mTypeEnum, escapeString(meshInfo.MeshId), escapeString(meshInfo.TextureId), serializeVector3(meshInfo.Scale), serializeVector3(meshInfo.Offset)
        )
    end
    return "nil"
end

-- ClassName and Shape Mapping Function
local function getF3XShape(part)
    local className = part.ClassName

    if className == "MeshPart" then
        return "Normal"
    elseif className == "WedgePart" then
        return "Wedge"
    elseif className == "CornerWedgePart" then
        return "Corner"
    elseif className == "TrussPart" then
        return "Truss"
    elseif className == "Seat" then
        return "Seat"
    elseif className == "VehicleSeat" then
        return "VehicleSeat"
    elseif className == "SpawnLocation" then
        return "Spawn"
    elseif part:IsA("Part") then
        local pShape = part.Shape
        if pShape == Enum.PartType.Ball then
            return "Ball"
        elseif pShape == Enum.PartType.Cylinder then
            return "Cylinder"
        elseif pShape == Enum.PartType.Wedge then
            return "Wedge"
        elseif pShape == Enum.PartType.CornerWedge then
            return "Corner"
        end
    end

    return "Normal"
end

local serializedLines = {}
for _, part in ipairs(partsToExport) do
    local shape = getF3XShape(part)
    local partCF = part.CFrame
    local partSize = part.Size

    -- Check for CylinderMesh / SpecialMesh Cylinder for axis correction
    local cm = part:FindFirstChildOfClass("CylinderMesh")
    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if cm or (sm and sm.MeshType == Enum.MeshType.Cylinder) then
        partCF = partCF * CFrame.Angles(0, 0, math.rad(90))
        partSize = Vector3.new(part.Size.Y, part.Size.X, part.Size.Z)
    end

    local cfStr = serializeCFrame(partCF)
    local sizeStr = serializeVector3(partSize)
    local colorStr = serializeColor3(part.Color)
    local matStr = "Enum.Material." .. part.Material.Name
    local transNum = round(math.clamp(part.Transparency, 0, 1))
    local anch = "true"
    local canCollide = part.CanCollide and "true" or "false"
    local texStr = getTextures(part)
    local meshStr = getMeshInfo(part)
    local surfStr = getSurfaces(part)

    local line = string.format(
        '    {%q, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s}',
        shape, cfStr, sizeStr, colorStr, matStr, tostring(transNum), anch, canCollide, texStr, meshStr, surfStr
    )
    table.insert(serializedLines, line)
end

