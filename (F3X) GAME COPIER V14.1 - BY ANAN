-- Surface Serialization
local function getSurfaces(part)
    local faces = {"Top", "Bottom", "Front", "Back", "Left", "Right"}
    local sTypes = {}
    local hasCustom = false
    
    for _, face in ipairs(faces) do
        local ok, surf = pcall(function() return part[face .. "Surface"] end)
        if ok and surf and typeof(surf) == "EnumItem" then
            local name = surf.Name
            if pcall(function() return Enum.SurfaceType[name] end) then
                sTypes[face] = "Enum.SurfaceType." .. name
                if name ~= "Smooth" and name ~= "SmoothNoOutlines" then
                    hasCustom = true
                end
            else
                sTypes[face] = "Enum.SurfaceType.Smooth"
            end
        else
            sTypes[face] = "Enum.SurfaceType.Smooth"
        end
    end
    
    if not hasCustom then return "nil" end
    
    return string.format(
        "{Top = %s, Bottom = %s, Front = %s, Back = %s, Left = %s, Right = %s}",
        sTypes.Top, sTypes.Bottom, sTypes.Front, sTypes.Back, sTypes.Left, sTypes.Right
    )
end

-- Texture / Decal Serialization
local function getTextures(part)
    local list = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture") then
            local isTex = child:IsA("Texture")
            local texImg = tostring(child.Texture or "")
            if texImg ~= "" then
                local r, g, b = 255, 255, 255
                pcall(function()
                    local col = child.Color3
                    r = math.round(col.R * 255)
                    g = math.round(col.G * 255)
                    b = math.round(col.B * 255)
                end)
                
                local faceName = child.Face and child.Face.Name or "Front"
                local faceEnumStr = "Enum.NormalId." .. (Enum.NormalId[faceName] and faceName or "Front")
                local trans = round(child.Transparency or 0)
                
                local uStuds = isTex and round(child.StudsPerTileU or 1) or 1
                local vStuds = isTex and round(child.StudsPerTileV or 1) or 1
                local uOffset = isTex and round(child.OffsetStudsU or 0) or 0
                local vOffset = isTex and round(child.OffsetStudsV or 0) or 0
                
                local entry = string.format(
                    '{Type = %s, Face = %s, Texture = %s, Transparency = %s, Color = Color3.fromRGB(%d, %d, %d), StudsPerTileU = %s, StudsPerTileV = %s, OffsetStudsU = %s, OffsetStudsV = %s}',
                    escapeString(child.ClassName),
                    faceEnumStr,
                    escapeString(texImg),
                    tostring(trans),
                    r, g, b,
                    tostring(uStuds),
                    tostring(vStuds),
                    tostring(uOffset),
                    tostring(vOffset)
                )
                table.insert(list, entry)
            end
        end
    end
    if #list == 0 then return "nil" end
    return "{" .. table.concat(list, ", ") .. "}"
end

-- Mesh & Shape Detector
local function getInfo(part)
    local shape = "Normal"
    local meshStr = "nil"
    local meshInfo = nil
    
    if part:IsA("MeshPart") or part.ClassName == "MeshPart" then
        local meshId = tostring(part.MeshId or "")
        local textureId = tostring(part.TextureID or "")
        if meshId ~= "" then
            meshInfo = {
                MeshType = "FileMesh",
                MeshId = meshId,
                TextureId = textureId,
                Scale = Vector3.new(1, 1, 1),
                Offset = Vector3.new(0, 0, 0)
            }
        end
    end

    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm then
        local meshId = tostring(sm.MeshId or "")
        local textureId = tostring(sm.TextureId or "")
        local mScale = sm.Scale or Vector3.new(1, 1, 1)
        local mOffset = sm.Offset or Vector3.new(0, 0, 0)
        local mTypeName = "FileMesh"
        pcall(function() mTypeName = sm.MeshType.Name end)
        
        meshInfo = {
            MeshType = mTypeName,
            MeshId = meshId,
            TextureId = textureId,
            Scale = mScale,
            Offset = mOffset
        }
    end
    
    if meshInfo then
        local mTypeEnum = "Enum.MeshType." .. (Enum.MeshType[meshInfo.MeshType] and meshInfo.MeshType or "FileMesh")
        meshStr = string.format(
            '{MeshType = %s, MeshId = %s, TextureId = %s, Scale = %s, Offset = %s}',
            mTypeEnum,
            escapeString(meshInfo.MeshId),
            escapeString(meshInfo.TextureId),
            serializeVector3(meshInfo.Scale),
            serializeVector3(meshInfo.Offset)
        )
    else
        if part:IsA("WedgePart") or part.ClassName == "WedgePart" then
            shape = "Wedge"
        elseif part:IsA("CornerWedgePart") or part.ClassName == "CornerWedgePart" then
            shape = "Corner"
        elseif part:IsA("TrussPart") or part.ClassName == "TrussPart" then
            shape = "Truss"
        elseif part:IsA("Part") then
            local ok, pShape = pcall(function() return part.Shape end)
            if ok and pShape then
                if pShape == Enum.PartType.Ball then shape = "Ball"
                elseif pShape == Enum.PartType.Cylinder then shape = "Cylinder"
                elseif pShape == Enum.PartType.Wedge then shape = "Wedge"
                end
            end
        end
    end
    return shape, meshStr
end

local serializedLines = {}
for _, part in ipairs(partsToExport) do
    local shape, meshStr = getInfo(part)
    local cfStr = serializeCFrame(part.CFrame)
    local sizeStr = serializeVector3(part.Size)
    local colorStr = serializeColor3(part.Color)
    local matStr = "Enum.Material." .. part.Material.Name
    local transNum = round(math.clamp(part.Transparency, 0, 1))
    local anch = part.Anchored and "true" or "false"
    local canCollide = part.CanCollide and "true" or "false"
    local texStr = getTextures(part)
    local surfStr = getSurfaces(part)
    
    local line = string.format(
        '  {%q, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s}',
        shape, cfStr, sizeStr, colorStr, matStr, tostring(transNum), anch, canCollide, texStr, meshStr, surfStr
    )
    table.insert(serializedLines, line)
end

