-- String Escaping Helper for Safe Code Generation
local function escapeString(str)
    if type(str) ~= "string" then return '""' end
    return string.format("%q", str)
end

-- Number Rounding Helper
local function round(num)
    if type(num) ~= "number" then return 0 end
    return math.floor(num * 10000 + 0.5) / 10000
end

-- Vector3 Serialization Helper
local function serializeVector3(vec)
    if typeof(vec) ~= "Vector3" then return "Vector3.new(0, 0, 0)" end
    return string.format("Vector3.new(%s, %s, %s)", round(vec.X), round(vec.Y), round(vec.Z))
end

-- CFrame Serialization Helper
local function serializeCFrame(cf)
    local comps = {cf:GetComponents()}
    for i, v in ipairs(comps) do comps[i] = round(v) end
    return string.format("CFrame.new(%s)", table.concat(comps, ", "))
end

-- Color3 Serialization Helper
local function serializeColor3(col)
    return string.format("Color3.fromRGB(%d, %d, %d)", math.round(col.R * 255), math.round(col.G * 255), math.round(col.B * 255))
end

