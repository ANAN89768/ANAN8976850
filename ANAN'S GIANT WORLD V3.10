--========================================================
-- ANAN'S GIANT WORLD V3.10 — ROBUST MULTI-PART FIX
-- Ensures every single map part gets resized and moved
-- with fallback error logging!
--========================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer

--========================================================
-- SETTINGS
--========================================================

local SCALE = 5
local ORIGIN = Vector3.zero
local MAX_SCALE = 100
local VOID_FLOOR_SIZE = 100000
local VOID_FLOOR_DEPTH = 250

--========================================================
-- FRESH F3X SYNC API SCANNER
--========================================================

local function getFreshEndpoint()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack

    for _, container in ipairs({ char, backpack }) do
        if container then
            for _, item in ipairs(container:GetDescendants()) do
                if item.Name == "SyncAPI" and item:FindFirstChild("ServerEndpoint") then
                    return item.ServerEndpoint
                end
            end
        end
    end
    return nil
end

local function sync(action, ...)
    local ep = getFreshEndpoint()
    if not ep then
        return false, "F3X Building Tool missing or unequipped!"
    end

    local args = table.pack(...)
    local ok, result = pcall(function()
        return ep:InvokeServer(action, table.unpack(args, 1, args.n))
    end)

    return ok, result
end

--========================================================
-- STORAGE & EXCLUSIONS
--========================================================

local ProxyFolder = Workspace:FindFirstChild("ANAN_F3X_GIANT_OBJECTS")
if not ProxyFolder then
    ProxyFolder = Instance.new("Folder")
    ProxyFolder.Name = "ANAN_F3X_GIANT_OBJECTS"
    ProxyFolder.Parent = Workspace
end

local function IsCharacterPart(obj)
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character and obj:IsDescendantOf(character) then
            return true
        end
    end
    return false
end

