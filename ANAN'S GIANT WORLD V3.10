--========================================================
-- MAIN EXECUTION
--========================================================

local function StartScaling()
    local ep = getFreshEndpoint()
    if not ep then
        StatusMsg.Text = "Equip F3X Tool into hand first!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    DoneButton.Text = "SCALING..."
    DoneButton.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    DoneButton.Active = false

    local targetParts = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- Collect all valid BaseParts excluding proxy folders and player models
        if obj:IsA("BasePart") and not obj:IsDescendantOf(ProxyFolder) and not IsCharacterPart(obj) then
            table.insert(targetParts, obj)
        end
    end

    local lockBatch = {}
    local resizeBatch = {}

    for _, part in ipairs(targetParts) do
        local oldCF = part.CFrame
        local newPosition = ORIGIN + (oldCF.Position - ORIGIN) * SCALE
        
        local rawSize = part.Size * SCALE
        local safeSize = Vector3.new(
            math.clamp(rawSize.X, 0.05, 2048),
            math.clamp(rawSize.Y, 0.05, 2048),
            math.clamp(rawSize.Z, 0.05, 2048)
        )
        local newCF = CFrame.new(newPosition) * oldCF.Rotation

        table.insert(lockBatch, { Part = part, Locked = false })
        table.insert(resizeBatch, { Part = part, Size = safeSize, CFrame = newCF })
    end

    local batchSize = 25 -- Reduced chunk size for absolute reliability across all parts

    -- 1. UNLOCK BATCH WITH RETRY LOGIC
    for i = 1, #lockBatch, batchSize do
        local chunk = {}
        for j = i, math.min(i + batchSize - 1, #lockBatch) do
            table.insert(chunk, lockBatch[j])
        end
        local ok, err = sync("SyncLock", chunk)
        if not ok then
            print("[ANAN F3X] Lock chunk failed:", err)
        end
        task.wait(0.01)
    end

    task.wait(0.1)

    -- 2. RESIZE/MOVE BATCH WITH ERROR LOGGING
    for i = 1, #resizeBatch, batchSize do
        local chunk = {}
        for j = i, math.min(i + batchSize - 1, #resizeBatch) do
            table.insert(chunk, resizeBatch[j])
        end
        
        local ok, err = sync("SyncResize", chunk)
        if not ok then
            -- Fallback attempt: if batch fails, loop through parts individually to isolate failing parts
            for _, item in ipairs(chunk) do
                local singleOk, singleErr = sync("SyncResize", {item})
                if not singleOk then
                    warn("[ANAN F3X] Skipped/Rejected Part:", item.Part:GetFullName(), "Error:", singleErr)
                end
            end
        end

        StatusMsg.Text = string.format("Scaling %d / %d", math.min(i + batchSize - 1, #resizeBatch), #resizeBatch)
        task.wait(0.02)
    end

    -- TELEPORT
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(ORIGIN + (root.Position - ORIGIN) * SCALE) * root.CFrame.Rotation
    end

    StatusMsg.Text = "Done!"
    StatusMsg.TextColor3 = Color3.fromRGB(100, 255, 100)
    task.wait(0.8)
    ScreenGui:Destroy()
end

DoneButton.MouseButton1Click:Connect(function()
    local enteredSize = tonumber(SizeBox.Text)
    if not enteredSize or enteredSize <= 0 or enteredSize > MAX_SCALE then
        StatusMsg.Text = "Enter valid size (0.01 - 100)!"
        StatusMsg.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    SCALE = enteredSize
    StartScaling()
end)
