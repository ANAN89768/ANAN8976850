local function CreateConsoleBox(titleText, connectToRobloxLogs)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0.49, 0, 1, 0)
    Frame.BackgroundColor3 = BG_CARD
    Frame.Parent = ConsolePage
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Frame
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -20, 0, 22)
    Title.Position = UDim2.new(0, 10, 0, 6)
    Title.BackgroundTransparency = 1
    Title.Text = titleText
    Title.TextColor3 = TEXT_WHITE
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 12
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Frame
    
    local Display = Instance.new("TextBox")
    Display.Size = UDim2.new(1, -20, 1, -70)
    Display.Position = UDim2.new(0, 10, 0, 30)
    Display.BackgroundColor3 = BG_DARK
    Display.Text = "> Console Initialized...\n"
    Display.TextColor3 = TEXT_MUTED
    Display.Font = Enum.Font.Code
    Display.TextSize = 10
    Display.TextXAlignment = Enum.TextXAlignment.Left
    Display.TextYAlignment = Enum.TextYAlignment.Top
    Display.ClearTextOnFocus = false
    Display.MultiLine = true
    Display.Parent = Frame
    
    local ClearCslBtn = Instance.new("TextButton")
    ClearCslBtn.Size = UDim2.new(0, 70, 0, 24)
    ClearCslBtn.Position = UDim2.new(0, 10, 1, -30)
    ClearCslBtn.BackgroundColor3 = BG_DARK
    ClearCslBtn.Text = "CLEAR"
    ClearCslBtn.TextColor3 = TEXT_WHITE
    ClearCslBtn.Font = Enum.Font.GothamBold
    ClearCslBtn.TextSize = 9
    ClearCslBtn.Parent = Frame
    
    local CslCorner = Instance.new("UICorner")
    CslCorner.CornerRadius = UDim.new(0, 4)
    CslCorner.Parent = ClearCslBtn
    
    ClearCslBtn.MouseButton1Click:Connect(function()
        Display.Text = "> Console Cleared...\n"
    end)

    if connectToRobloxLogs then
        LogService.MessageOut:Connect(function(message, messageType)
            if Display and Display.Parent then
                local prefix = "[LOG] "
                if messageType == Enum.MessageType.MessageWarning then
                    prefix = "[WARN] "
                elseif messageType == Enum.MessageType.MessageError then
                    prefix = "[ERR] "
                end
                Display.Text = Display.Text .. prefix .. message .. "\n"
            end
        end)
    end
end

