--============================================================
-- F3X ENDPOINT DETECTION
--============================================================

local function getEndpoint()
    local containers = {Player.Character, Player.Backpack}

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") and (
                    string.find(string.lower(item.Name), "building tools")
                    or item:FindFirstChild("SyncAPI")
                ) then
                    local syncApi = item:FindFirstChild("SyncAPI")

                    if syncApi then
                        local endpoint = syncApi:FindFirstChild("ServerEndpoint")

                        if endpoint and (
                            endpoint:IsA("RemoteFunction")
                            or endpoint:IsA("RemoteEvent")
                        ) then
                            return endpoint
                        end
                    end
                end
            end

            local syncApi = container:FindFirstChild("SyncAPI", true)

            if syncApi then
                local endpoint = syncApi:FindFirstChild("ServerEndpoint")

                if endpoint and (
                    endpoint:IsA("RemoteFunction")
                    or endpoint:IsA("RemoteEvent")
                ) then
                    return endpoint
                end
            end
        end
    end

    return nil
end

local function sync(action, ...)
    local ep = getEndpoint()

    if not ep then
        return false, "No endpoint found"
    end

    local args = table.pack(...)

    local ok, result = pcall(function()
        return ep:InvokeServer(action, table.unpack(args, 1, args.n))
    end)

    return ok, result
end

