local function UpdateCameraFacing()
    if not MovementAlignOrientation then return end

    local camera = workspace.CurrentCamera

    if not camera then return end

    local look = camera.CFrame.LookVector

    local horizontalLook = Vector3.new(
        look.X,
        0,
        look.Z
    )

    if horizontalLook.Magnitude < 0.01 then
        return
    end

    LastFacing = horizontalLook.Unit

    MovementAlignOrientation.CFrame = CFrame.lookAt(
        Vector3.zero,
        LastFacing,
        Vector3.yAxis
    )
end

local function GetInputMovement()
    local direction = Humanoid.MoveDirection

    local horizontal = Vector3.new(
        direction.X,
        0,
        direction.Z
    )

    if horizontal.Magnitude > 0.05 then
        return horizontal.Unit
    end

    return Vector3.zero
end

local function GetActualMovement()
    local velocity = Root.AssemblyLinearVelocity

    local horizontal = Vector3.new(
        velocity.X,
        0,
        velocity.Z
    )

    if horizontal.Magnitude > 1 then
        return horizontal.Unit
    end

    return Vector3.zero
end

local function GetCharacterHeight()
    return Humanoid.HipHeight + Root.Size.Y * 0.5
end

local function GetFloatingHeight()
    local ground = GroundRay(Root.Position)

    if ground then
        BaseFloatY = ground.Position.Y
            + GetCharacterHeight()
            + CFG.FLOAT_HEIGHT
    end

    return BaseFloatY
end

local function UpdateVerticalMovement(dt, wall)
    local baseHeight = GetFloatingHeight()

    if not baseHeight then
        return Root.Position.Y
    end

    if JumpHeld then
        if wall then
            VerticalOffset += CFG.WALL_CLIMB_SPEED * dt
        else
            VerticalOffset = math.min(
                VerticalOffset + CFG.JUMP_RISE_SPEED * dt,
                CFG.JUMP_MAX_HEIGHT
            )
        end
    else
        VerticalOffset = math.max(
            VerticalOffset - CFG.RETURN_SPEED * dt,
            0
        )
    end

    return baseHeight + VerticalOffset
end

local function GetWallForward(normal)
    return SafeUnit(
        Vector3.new(-normal.X, 0, -normal.Z),
        LastFacing
    )
end

local function DetectWallTop(wallNormal)
    if not wallNormal or not ClimbStartY then
        return nil
    end

    local forward = GetWallForward(wallNormal)

    local bestResult = nil
    local bestDistance = math.huge

    for _, probeDistance in ipairs(CFG.LEDGE_PROBES) do
        local probeOrigin = Root.Position
            + forward * probeDistance
            + Vector3.new(0, CFG.LEDGE_DETECT_HEIGHT, 0)

        local result = CastRay(
            probeOrigin,
            Vector3.new(0, -CFG.LEDGE_DETECT_DISTANCE, 0)
        )

        if result and result.Normal.Y >= 0.7 then
            local targetY = result.Position.Y
                + GetCharacterHeight()
                + CFG.FLOAT_HEIGHT

            local climbHeight = result.Position.Y - ClimbStartY
            local difference = targetY - Root.Position.Y

            if climbHeight >= CFG.LEDGE_MIN_CLIMB_HEIGHT
                and difference <= CFG.LEDGE_MAX_NEAR_HEIGHT
                and difference >= -2 then

                if probeDistance < bestDistance then
                    bestDistance = probeDistance
                    bestResult = result
                end
            end
        end
    end

    if not bestResult then
        return nil
    end

    local targetPosition = bestResult.Position
        + forward * CFG.LEDGE_FORWARD_DISTANCE

    local targetY = bestResult.Position.Y
        + GetCharacterHeight()
        + CFG.FLOAT_HEIGHT

    return Vector3.new(
        targetPosition.X,
        targetY,
        targetPosition.Z
    )
end

local function GetCurrentLockedWall()
    if not LockedWallGroup or not LockedWallNormal then
        return nil
    end

    local direction = -LockedWallNormal

    local detected = WallRay(
        direction,
        LockedWallGroup
    )

    if detected then
        LockWall(detected)
        return detected
    end

    if os.clock() - LastWallTime <= CFG.WALL_MEMORY_TIME then
        return {
            Normal = LastWallNormal,
            Position = LastWallPosition,
            Instance = LockedWallGroup
        }
    end

    return nil
end

local function DetectNewWall()
    local detected = WallRay(LastFacing)

    if not detected then
        return nil
    end

    if math.abs(detected.Normal.Y) >= 0.35 then
        return nil
    end

    LockWall(detected)

    return detected
end

local function UpdateMovement(dt)
    if not MovementAlignPosition
        or not MovementAlignOrientation
        or not Root
        or not Root.Parent then
        return
    end

    local movement = GetInputMovement()
    local speed = ShiftHeld and CFG.RUN_SPEED or CFG.WALK_SPEED

    UpdateCameraFacing()

    if not JumpHeld then
        LedgeLocked = false
        LedgeTarget = nil
        ClearWallLock()
    end

    if LedgeTarget then
        local difference = LedgeTarget - Root.Position

        local step = math.min(
            1,
            CFG.LEDGE_TRANSITION_SPEED * dt
                / math.max(difference.Magnitude, 0.001)
        )

        MovementTarget = Root.Position:Lerp(
            LedgeTarget,
            step
        )

        MovementAlignPosition.Position = MovementTarget

        if difference.Magnitude < 0.35 then
            MovementTarget = LedgeTarget
            MovementAlignPosition.Position = LedgeTarget
            LedgeTarget = nil
            LedgeLocked = true
            CurrentWall = nil
            VerticalOffset = 0
            BaseFloatY = MovementTarget.Y
            ClearWallLock()
        end

        return
    end

    local wall = nil

    if JumpHeld and not LedgeLocked then
        if LockedWallGroup then
            wall = GetCurrentLockedWall()
        else
            wall = DetectNewWall()

            if wall and not ClimbStartY then
                ClimbStartY = Root.Position.Y
            end
        end
    end

    CurrentWall = wall

    if JumpHeld and wall and not LedgeLocked then
        local topTarget = DetectWallTop(wall.Normal)

        if topTarget then
            LedgeTarget = topTarget
            MovementTarget = Root.Position
            CurrentWall = nil
            return
        end
    end

    local targetY = UpdateVerticalMovement(dt, wall)

    if wall and JumpHeld then
        local wallNormal = SafeUnit(
            Vector3.new(
                wall.Normal.X,
                0,
                wall.Normal.Z
            ),
            -LastFacing
        )

        local wallRight = Vector3.new(
            -wallNormal.Z,
            0,
            wallNormal.X
        )

        local sideways = movement:Dot(wallRight)

        if math.abs(sideways) > 0.05 then
            MovementTarget += wallRight * sideways * speed * dt
        else
            MovementTarget = Vector3.new(
                MovementTarget.X,
                targetY,
                MovementTarget.Z
            )
        end

    elseif movement.Magnitude > 0.05 then
        MovementTarget += movement * speed * dt

    else
        MovementTarget = Vector3.new(
            MovementTarget.X,
            targetY,
            MovementTarget.Z
        )
    end

    MovementAlignPosition.Position = Vector3.new(
        MovementTarget.X,
        targetY,
        MovementTarget.Z
    )
end

