local function BuildClaw(index)
    local claw = {
        Center = Sphere("ClawCenter_" .. index, 0.65, CFG.DARK),

        Palm = DefinePart(
            "ClawPalm_" .. index,
            Vector3.new(1, 0.18, 0.85),
            CFG.DARK
        ),

        Fingers = {}
    }

    for i = 1, 3 do
        table.insert(claw.Fingers, {
            Joint = Sphere(
                "ClawJoint_" .. index .. "_" .. i,
                0.22,
                CFG.DARK
            ),

            Rod = DefinePart(
                "ClawFinger_" .. index .. "_" .. i,
                Vector3.new(1, 0.2, 0.2),
                CFG.DARK,
                Enum.Material.Metal,
                Enum.PartType.Cylinder
            ),

            Tip = DefinePart(
                "ClawTip_" .. index .. "_" .. i,
                Vector3.new(1, 0.14, 0.14),
                CFG.YELLOW,
                Enum.Material.Metal,
                Enum.PartType.Cylinder
            )
        })
    end

    return claw
end

local function BuildArm(config, index)
    local arm = {
        Config = config,
        Segments = {},
        Joints = {},
        Claw = BuildClaw(index),
        Plant = nil,
        PlantNormal = Vector3.yAxis,
        CurrentTarget = nil,
        CurrentNormal = Vector3.yAxis,
        LastCycle = -1,
    }

    arm.Shoulder = Sphere(
        "Shoulder_" .. index,
        1,
        CFG.DARK
    )

    arm.ShoulderRing = DefinePart(
        "ShoulderRing_" .. index,
        Vector3.new(0.35, 1.1, 1.1),
        CFG.YELLOW,
        Enum.Material.Metal,
        Enum.PartType.Cylinder
    )

    for i = 1, CFG.SEGMENTS do
        table.insert(
            arm.Segments,
            DefinePart(
                "ArmSegment_" .. index .. "_" .. i,
                Vector3.new(1, CFG.ARM_WIDTH, CFG.ARM_WIDTH),
                CFG.YELLOW,
                Enum.Material.Metal,
                Enum.PartType.Cylinder
            )
        )

        table.insert(
            arm.Joints,
            Sphere(
                "ArmJoint_" .. index .. "_" .. i,
                0.32,
                CFG.DARK
            )
        )
    end

    return arm
end

local function GetBase(arm)
    local c = arm.Config

    return Root.CFrame:PointToWorldSpace(
        Vector3.new(
            c.x * 0.95,
            0.6,
            c.z * 0.95 + 0.2
        )
    )
end

local function GetSurfaceTarget(position)
    local result = SurfaceRay(position)

    if result then
        return result.Position + result.Normal * 0.25,
            result.Normal
    end

    return position, Vector3.yAxis
end

local function GetWalkingTarget(arm, movement)
    local c = arm.Config

    local radial = SafeUnit(
        Root.CFrame:VectorToWorldSpace(
            Vector3.new(c.x, 0, c.z)
        ),
        Vector3.xAxis
    )

    local forward = SafeUnit(
        Vector3.new(movement.X, 0, movement.Z),
        LastFacing
    )

    if movement.Magnitude < 0.05 then
        arm.Plant = nil
        arm.LastCycle = -1

        local idleTarget = Root.Position
            + radial * CFG.ARM_SPREAD
            + Vector3.new(0, -2.5, 0)

        return GetSurfaceTarget(idleTarget)
    end

    local rawCycle = Elapsed * CFG.GAIT_SPEED
        / (2 * math.pi)
        + c.phase / (2 * math.pi)

    local cyclePosition = rawCycle % 1
    local cycleNumber = math.floor(rawCycle)

    local stance = cyclePosition < 0.58
    local sidePosition = radial * CFG.ARM_SPREAD

    if stance and cycleNumber ~= arm.LastCycle then
        arm.LastCycle = cycleNumber

        local plantPosition = Root.Position
            + sidePosition
            + forward * (CFG.STRIDE * 0.5)

        local planted, normal = GetSurfaceTarget(plantPosition)

        arm.Plant = planted
        arm.PlantNormal = normal
    end

    if stance and arm.Plant then
        return arm.Plant, arm.PlantNormal
    end

    local swingProgress = math.clamp(
        (cyclePosition - 0.58) / 0.42,
        0,
        1
    )

    local stridePosition = -CFG.STRIDE * 0.5
        + CFG.STRIDE * swingProgress

    local lift = math.sin(swingProgress * math.pi)
        * CFG.STEP_HEIGHT

    local swingPosition = Root.Position
        + sidePosition
        + forward * stridePosition
        + Vector3.new(0, lift, 0)

    return GetSurfaceTarget(swingPosition)
end

local function GetWallTarget(arm, wall, index)
    local c = arm.Config

    local radial = Root.CFrame:VectorToWorldSpace(
        Vector3.new(c.x, 0, c.z)
    )

    local height = ((index % 2 == 0) and 2 or -2)
        + math.sin(Elapsed * 3 + c.phase)

    local desired = wall.Position
        + radial * 2
        + Vector3.new(0, height, 0)

    local result = CastRay(
        desired + wall.Normal * 4,
        -wall.Normal * 9,
        LockedWallGroup
    )

    if result then
        return result.Position + result.Normal * 0.25,
            result.Normal
    end

    return desired, wall.Normal
end

--============================================================
-- OUTWARD ANGULAR ARM CURVE
--============================================================

local function AnimateArm(arm, target, normal, dt)
    local base = GetBase(arm)

    normal = SafeUnit(normal, Vector3.yAxis)

    if not arm.CurrentTarget then
        arm.CurrentTarget = target
    end

    local alpha = 1 - math.exp(-dt * CFG.ARM_RETURN_SPEED)

    arm.CurrentTarget = arm.CurrentTarget:Lerp(target, alpha)
    arm.CurrentNormal = arm.CurrentNormal:Lerp(normal, alpha)

    target = arm.CurrentTarget
    normal = SafeUnit(arm.CurrentNormal, Vector3.yAxis)

    local radial = SafeUnit(target - base, LastFacing)

    -- Build the outward-hook shape from several guide points.
    local localOutward = Vector3.new(
        arm.Config.x,
        0,
        arm.Config.z
    )

    local outward = SafeUnit(
        Root.CFrame:VectorToWorldSpace(localOutward),
        radial
    )

    local distance = (target - base).Magnitude
    local bend = math.min(
        CFG.ARM_CURVE_BEND,
        math.max(1.2, distance * 0.22)
    )

    local lift = CFG.ARM_CURVE_HEIGHT

    -- Shoulder -> outward bend -> inward turn -> palm.
    local path = {
        base,

        base + radial * (distance * 0.22)
            + outward * (bend * 0.75)
            + Vector3.new(0, lift * 0.15, 0),

        base + radial * (distance * 0.52)
            + outward * bend
            + Vector3.new(0, lift * 0.55, 0),

        target - radial * (distance * 0.18)
            + outward * (bend * 0.18)
            + Vector3.new(0, lift * 0.25, 0),

        target,
    }

    local function CurvePoint(t)
        local scaled = math.clamp(t, 0, 1) * (#path - 1)
        local segment = math.min(
            math.floor(scaled) + 1,
            #path - 1
        )

        local u = scaled - (segment - 1)

        local p0 = path[math.max(1, segment - 1)]
        local p1 = path[segment]
        local p2 = path[segment + 1]
        local p3 = path[math.min(#path, segment + 2)]

        local u2 = u * u
        local u3 = u2 * u

        return (p1 * 2
            + (p2 - p0) * u
            + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * u2
            + (-p0 + p1 * 3 - p2 * 3 + p3) * u3) * 0.5
    end

    local previous = CurvePoint(0)

    arm.Shoulder.cf = CFrame.new(base)

    PlaceCylinder(
        arm.ShoulderRing,
        base - radial * 0.35,
        base + radial * 0.35,
        0.9
    )

    for i = 1, CFG.SEGMENTS do
        local point = CurvePoint(i / CFG.SEGMENTS)

        PlaceCylinder(
            arm.Segments[i],
            previous,
            point,
            CFG.ARM_WIDTH
        )

        arm.Joints[i].cf = CFrame.new(previous)

        previous = point
    end

    local along = base - target
    along = along - normal * along:Dot(normal)

    if along.Magnitude < 0.01 then
        along = LastFacing
        along = along - normal * along:Dot(normal)
    end

    along = SafeUnit(along, Vector3.xAxis)

    local side = SafeUnit(
        along:Cross(normal),
        Vector3.xAxis
    )

    local up = SafeUnit(
        normal:Cross(side),
        Vector3.yAxis
    )

    arm.Claw.Palm.cf = CFrame.fromMatrix(
        target - normal * 0.08,
        side,
        up,
        normal
    )

    arm.Claw.Center.cf = CFrame.new(
        target + normal * 0.15
    )

    local directions = {
        along,
        SafeUnit(along + side * 0.65, along),
        SafeUnit(along - side * 0.65, along)
    }

    for i, finger in ipairs(arm.Claw.Fingers) do
        local direction = directions[i]

        local start = target
            + normal * 0.12
            + direction * 0.25

        local middle = start + direction * 0.7
        local finish = middle + direction * 0.35

        finger.Joint.cf = CFrame.new(start)

        PlaceCylinder(
            finger.Rod,
            start,
            middle,
            0.2
        )

        PlaceCylinder(
            finger.Tip,
            middle,
            finish,
            0.14
        )
    end
end

--============================================================
-- CLEANUP
--============================================================

local function Cleanup()
    F3XReady = false

    for _, connection in ipairs(Connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    table.clear(Connections)

    RunService:UnbindFromRenderStep(
        "DocOckPureF3X_Arms"
    )

    if MovementAlignPosition then
        MovementAlignPosition:Destroy()
        MovementAlignPosition = nil
    end

    if MovementAlignOrientation then
        MovementAlignOrientation:Destroy()
        MovementAlignOrientation = nil
    end

    if MovementAttachment then
        MovementAttachment:Destroy()
        MovementAttachment = nil
    end

    local toDestroy = {}

    for _, p in ipairs(Order) do
        if p.inst and p.inst.Parent then
            table.insert(toDestroy, p.inst)
        end
    end

    if #toDestroy > 0 then
        sync("Remove", toDestroy)
    end

    if Folder then
        Folder:Destroy()
        Folder = nil
    end

    table.clear(Arms)
    table.clear(Order)

    if Humanoid and Humanoid.Parent and OriginalSettings then
        Humanoid.WalkSpeed = OriginalSettings.WalkSpeed
        Humanoid.JumpPower = OriginalSettings.JumpPower
        Humanoid.JumpHeight = OriginalSettings.JumpHeight
        Humanoid.AutoJumpEnabled = OriginalSettings.AutoJumpEnabled
        Humanoid.AutoRotate = OriginalSettings.AutoRotate

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            OriginalSettings.JumpingEnabled
        )

        Humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Climbing,
            OriginalSettings.ClimbingEnabled
        )
    end

    if AnimateScript and AnimateScript.Parent then
        AnimateScript.Enabled = AnimateWasEnabled
    end

    OriginalSettings = nil
    AnimateScript = nil
    AnimateWasEnabled = nil

    MovementTarget = nil
    LedgeTarget = nil
    LedgeLocked = false

    BaseFloatY = nil
    VerticalOffset = 0

    ClearWallLock()

    JumpHeld = false
    ShiftHeld = false
    CurrentWall = nil
end

--============================================================
-- INITIALIZE & UNIFIED MASS SYNC
--============================================================

local function Initialize(character)
    if not Active then return end

    Cleanup()

    Character = character
    Humanoid = character:WaitForChild("Humanoid")
    Root = character:WaitForChild("HumanoidRootPart")

    CreateMovementPhysics()
    DisableDefaultAnimations()

    Elapsed = 0
    ShiftHeld = false
    JumpHeld = false
    VerticalOffset = 0

    Folder = Instance.new("Folder")
    Folder.Name = "DocOckNoBackpack_Folder"
    Folder.Parent = workspace

    for i, config in ipairs(ARM_CONFIG) do
        table.insert(
            Arms,
            BuildArm(config, i)
        )
    end

    -- F3X SPAWNING
    task.spawn(function()
        StatusLabel.Visible = true
        StatusLabel.Text = "Scanning F3X Endpoint..."

        while Active and not getEndpoint() do
            task.wait(0.1)
        end

        if not Active then return end

        StatusLabel.Text = "Instant Spawning Arms..."

        local spawnCF = Root.CFrame
        local created = 0
        local total = #Order

        for _, p in ipairs(Order) do
            task.spawn(function()
                local ok, inst = sync(
                    "CreatePart",
                    p.kind,
                    spawnCF,
                    workspace
                )

                if ok and typeof(inst) == "Instance" then
                    p.inst = inst
                    inst.Name = p.name
                    created += 1
                end
            end)
        end

        local timeout = os.clock() + 3

        while created < total
            and os.clock() < timeout
            and Active do
            task.wait(0.01)
        end

        if not Active then return end

        if created < total then
            StatusLabel.Text = "Spawn incomplete. Re-try script."
            return
        end

        StatusLabel.Text = "Snapping Rig Into Place..."

        local anchors = {}
        local cols = {}
        local colors = {}
        local mats = {}
        local sizes = {}

        for _, p in ipairs(Order) do
            if p.inst and p.inst.Parent then
                table.insert(anchors, {
                    Part = p.inst,
                    Anchored = true
                })

                table.insert(cols, {
                    Part = p.inst,
                    CanCollide = false
                })

                table.insert(colors, {
                    Part = p.inst,
                    Color = p.color,
                    UnionColoring = true
                })

                table.insert(mats, {
                    Part = p.inst,
                    Material = p.material,
                    Transparency = 0
                })

                table.insert(sizes, {
                    Part = p.inst,
                    Size = p.size,
                    CFrame = p.cf
                })

                p.sentCF = p.cf
                p.sentSize = p.size
            end
        end

        sync("SyncAnchor", anchors)
        sync("SyncCollision", cols)
        sync("SyncColor", colors)
        sync("SyncMaterial", mats)
        sync("SyncResize", sizes)

        F3XReady = true

        StatusLabel.Text = "DOC OCK ACTIVE!"

        task.wait(1)

        if Active then
            StatusLabel.Visible = false
        end
    end)

    --========================================================
    -- INPUT CONNECTIONS
    -- SPACEBAR HOLD + SHIFT + MOBILE CLIMB
    --========================================================

    table.insert(
        Connections,
        UserInputService.InputBegan:Connect(function(input, processed)
            if input.KeyCode == Enum.KeyCode.LeftShift
                or input.KeyCode == Enum.KeyCode.RightShift then

                if not processed then
                    ShiftHeld = true
                end
            end

            -- HOLD SPACE TO CLIMB / JUMP
            if input.KeyCode == Enum.KeyCode.Space
                and not processed then
                JumpHeld = true
            end
        end)
    )

    table.insert(
        Connections,
        UserInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.LeftShift
                or input.KeyCode == Enum.KeyCode.RightShift then
                ShiftHeld = false
            end

            -- RELEASE SPACE TO STOP CLIMBING
            if input.KeyCode == Enum.KeyCode.Space then
                JumpHeld = false
            end
        end)
    )

    table.insert(
        Connections,
        UserInputService.WindowFocusReleased:Connect(function()
            JumpHeld = false
            ShiftHeld = false
        end)
    )

    -- MOVEMENT
    table.insert(
        Connections,
        RunService.PreSimulation:Connect(function(dt)
            if not Active
                or not F3XReady
                or not Root
                or not Root.Parent
                or not Humanoid
                or Humanoid.Health <= 0 then
                return
            end

            UpdateMovement(math.min(dt, 0.05))
        end)
    )

    -- ARM ANIMATION LOOP
    RunService:BindToRenderStep(
        "DocOckPureF3X_Arms",
        Enum.RenderPriority.Character.Value + 1,
        function(dt)
            if not Active
                or not F3XReady
                or not Character
                or not Character.Parent
                or not Humanoid
                or Humanoid.Health <= 0
                or not Root
                or not Root.Parent then
                return
            end

            dt = math.min(dt, 0.05)

            Elapsed += dt

            local movement = GetActualMovement()
            local wall = CurrentWall
            local ground = GroundRay(Root.Position)

            for i, arm in ipairs(Arms) do
                local target, normal

                if wall and JumpHeld then
                    target, normal = GetWallTarget(
                        arm,
                        wall,
                        i
                    )

                elseif ground then
                    target, normal = GetWalkingTarget(
                        arm,
                        movement
                    )

                else
                    target, normal = GetSurfaceTarget(
                        Root.Position
                            + Root.CFrame:VectorToWorldSpace(
                                Vector3.new(
                                    arm.Config.x * CFG.ARM_SPREAD,
                                    -2.5,
                                    arm.Config.z * CFG.ARM_SPREAD
                                )
                            )
                    )
                end

                AnimateArm(
                    arm,
                    target,
                    normal,
                    dt
                )
            end
        end
    )

    --========================================================
    -- UNIFIED F3X BATCH SERVER REPLICATION LOOP
    --========================================================

    task.spawn(function()
        local inflight = 0

        while Active do
            task.wait(0.06)

            if F3XReady and inflight < 2 then
                local batch = {}

                for _, p in ipairs(Order) do
                    local part = p.inst

                    if part and part.Parent then
                        if not p.sentCF
                            or not p.sentSize
                            or (p.cf.Position - p.sentCF.Position).Magnitude > 0.03
                            or p.cf.LookVector:Dot(p.sentCF.LookVector) < 0.99
                            or (p.size - p.sentSize).Magnitude > 0.02 then

                            table.insert(batch, {
                                Part = part,
                                Size = p.size,
                                CFrame = p.cf
                            })

                            p.sentCF = p.cf
                            p.sentSize = p.size
                        end
                    end
                end

                if #batch > 0 then
                    inflight += 1

                    task.spawn(function()
                        sync("SyncResize", batch)
                        inflight -= 1
                    end)
                end
            end
        end
    end)

    table.insert(
        Connections,
        Humanoid.Died:Connect(Cleanup)
    )

    print("[DOC OCK NO-BACKPACK SYNC] Initialized successfully!")
end

