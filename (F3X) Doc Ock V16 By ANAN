local function DefinePart(name, size, color, material, shape)
    shape = shape or Enum.PartType.Block

    local kind = "Normal"

    if shape == Enum.PartType.Ball then
        kind = "Ball"
    elseif shape == Enum.PartType.Cylinder then
        kind = "Cylinder"
    end

    local p = {
        name = name,
        kind = kind,
        size = size,
        color = color,
        material = material or Enum.Material.Metal,
        shape = shape,
        cf = CFrame.new(),
        sentCF = nil,
        sentSize = nil,
        inst = nil
    }

    table.insert(Order, p)
    return p
end

local function Sphere(name, size, color)
    return DefinePart(
        name,
        Vector3.one * size,
        color,
        Enum.Material.Metal,
        Enum.PartType.Ball
    )
end

local function PlaceCylinder(p, a, b, thickness)
    local difference = b - a
    local length = difference.Magnitude

    if length < 0.001 then
        return
    end

    local xAxis = difference.Unit
    local reference = Vector3.yAxis

    if math.abs(xAxis:Dot(reference)) > 0.95 then
        reference = Vector3.zAxis
    end

    local yAxis = (
        reference - xAxis * xAxis:Dot(reference)
    ).Unit

    local zAxis = xAxis:Cross(yAxis).Unit

    p.size = Vector3.new(length, thickness, thickness)

    p.cf = CFrame.fromMatrix(
        (a + b) / 2,
        xAxis,
        yAxis,
        zAxis
    )
end

local function SafeUnit(v, fallback)
    if v.Magnitude > 0.001 then
        return v.Unit
    end

    return fallback or Vector3.yAxis
end

--============================================================
-- WALL IDENTITY & RAYCASTS
--============================================================

local function GetWallGroup(instance)
    if not instance then return nil end

    if instance == workspace.Terrain then
        return workspace.Terrain
    end

    local model = instance:FindFirstAncestorOfClass("Model")

    if model then
        return model
    end

    return instance
end

local function IsSameWall(instance, lockedGroup)
    if not instance or not lockedGroup then
        return false
    end

    if lockedGroup == workspace.Terrain then
        return instance == workspace.Terrain
    end

    if instance == lockedGroup then
        return true
    end

    if lockedGroup:IsA("Model") then
        return instance:IsDescendantOf(lockedGroup)
    end

    return false
end

local function LockWall(result)
    if not result then return end

    if not LockedWallGroup then
        LockedWallGroup = GetWallGroup(result.Instance)
    end

    LockedWallNormal = result.Normal
    LockedWallPosition = result.Position

    LastWallNormal = result.Normal
    LastWallPosition = result.Position
    LastWallTime = os.clock()
end

local function ClearWallLock()
    LockedWallGroup = nil
    LockedWallNormal = nil
    LockedWallPosition = nil

    LastWallNormal = nil
    LastWallPosition = nil
    LastWallTime = 0

    ClimbStartY = nil
end

local function CastRay(origin, direction, requiredWallGroup)
    local ignored = {Character}

    if Folder then
        table.insert(ignored, Folder)
    end

    for _, p in ipairs(Order) do
        if p.inst then
            table.insert(ignored, p.inst)
        end
    end

    for attempt = 1, CFG.MAX_RAYCAST_SKIPS do
        RayParams.FilterType = Enum.RaycastFilterType.Exclude
        RayParams.FilterDescendantsInstances = ignored

        local result = workspace:Raycast(origin, direction, RayParams)

        if not result then
            return nil
        end

        local hit = result.Instance

        if hit == workspace.Terrain then
            if requiredWallGroup then
                if IsSameWall(hit, requiredWallGroup) then
                    return result
                end

                return nil
            end

            return result
        end

        if hit:IsA("BasePart") then
            if not hit.CanCollide then
                table.insert(ignored, hit)
            else
                if requiredWallGroup then
                    if IsSameWall(hit, requiredWallGroup) then
                        return result
                    end

                    return nil
                end

                return result
            end
        else
            return nil
        end
    end

    return nil
end

local function GroundRay(position)
    return CastRay(
        position + Vector3.new(0, 3, 0),
        Vector3.new(0, -60, 0)
    )
end

local function SurfaceRay(position)
    return CastRay(
        position + Vector3.new(0, 12, 0),
        Vector3.new(0, -65, 0)
    )
end

local function WallRay(direction, requiredWallGroup)
    if not Root or not Root.Parent then
        return nil
    end

    direction = SafeUnit(direction, LastFacing)

    return CastRay(
        Root.Position,
        direction * CFG.WALL_RAY_DISTANCE,
        requiredWallGroup
    )
end

