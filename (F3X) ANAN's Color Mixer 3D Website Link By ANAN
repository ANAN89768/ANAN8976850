	},

	-- Size
	PS = 0.5,             -- studs per unit (bigger = bigger text)
	STROKE = 0.9,         -- stroke thickness in units (lower = thinner)
	DEPTH = 0.4,          -- block depth in studs
	ADV = 6,              -- letter spacing in units
	PITCH = 14,           -- line spacing in units

	-- Position
	DIST = 45,            -- distance in front of you (studs)
	HEIGHT = 0,           -- extra lift (0 = bottom just above ground)

	-- Colors
	TEXT_COLOR = Color3.fromRGB(0, 0, 0),
	BG_COLOR = Color3.fromRGB(255, 255, 255),

	-- Board
	SHOW_BOARD = true,    -- false = text only, no white board
	BOARD_PADDING = 4,    -- extra board size around the text (studs)

	-- Parts
	MATERIAL = Enum.Material.SmoothPlastic,
	CAN_COLLIDE = false,
}
