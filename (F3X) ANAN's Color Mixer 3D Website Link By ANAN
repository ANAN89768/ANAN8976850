local function getEndpoint()
	for _, container in ipairs({player.Character, player:FindFirstChildOfClass("Backpack")}) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:FindFirstChild("SyncAPI") then
					return tool.SyncAPI.ServerEndpoint
				end
			end
		end
	end
end

local endpoint = getEndpoint()
if not endpoint then
	warn("F3X tool not found! Get Building Tools by F3X first.")
	return
end

local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

local maxW = 0
for _, line in ipairs(LINES) do
	maxW = math.max(maxW, (#line - 1) * ADV + 4)
end
local totalW = maxW * PS
local totalH = ((#LINES - 1) * PITCH + 11) * PS

local pos = hrp.Position + hrp.CFrame.LookVector * DIST + Vector3.new(0, totalH + HEIGHT, 0)
local base = CFrame.lookAt(pos, Vector3.new(hrp.Position.X, pos.Y, hrp.Position.Z))

local specs = {}
if CONFIG.SHOW_BOARD then
	table.insert(specs, {
		cf = base * CFrame.new(0, -totalH / 2, 0),
		size = Vector3.new(totalW + CONFIG.BOARD_PADDING, totalH + CONFIG.BOARD_PADDING, 0.4),
		color = BG_COLOR,
	})
end

local function toLocal(li, xOff, ci, gx, gy)
	local px = xOff + (ci - 1) * ADV + gx
	local py = (li - 1) * PITCH + (8 - gy)
	return -(px * PS - totalW / 2), -(py * PS)
end

for li, line in ipairs(LINES) do
	local width = (#line - 1) * ADV + 4
	local xOff = (maxW - width) / 2
	for ci = 1, #line do
		local glyph = G[line:sub(ci, ci)]
		if glyph then
			for _, poly in ipairs(glyph) do
				for i = 1, #poly - 3, 2 do
					local ax, ay = toLocal(li, xOff, ci, poly[i], poly[i + 1])
					local bx, by = toLocal(li, xOff, ci, poly[i + 2], poly[i + 3])
					local dx, dy = bx - ax, by - ay
					local len = math.sqrt(dx * dx + dy * dy)
					local angle = len > 1e-6 and math.atan2(-dx, dy) or 0
					table.insert(specs, {
						cf = base * CFrame.new((ax + bx) / 2, (ay + by) / 2, -DEPTH) * CFrame.Angles(0, 0, angle),
						size = Vector3.new(STROKE * PS, len + STROKE * PS, DEPTH),
						color = TEXT_COLOR,
					})
				end
			end
		end
	end
end

local total = #specs
local done = 0
for _, spec in ipairs(specs) do
	task.spawn(function()
		spec.part = endpoint:InvokeServer("CreatePart", "Normal", spec.cf, workspace)
		done += 1
	end)
end
while done < total do task.wait() end

local resize, color, anchor, collide, material = {}, {}, {}, {}, {}
for _, s in ipairs(specs) do
	if s.part then
		table.insert(resize, {Part = s.part, CFrame = s.cf, Size = s.size})
		table.insert(color, {Part = s.part, Color = s.color, UnionColoring = false})
		table.insert(anchor, {Part = s.part, Anchored = true})
		table.insert(collide, {Part = s.part, CanCollide = CONFIG.CAN_COLLIDE})
		table.insert(material, {Part = s.part, Material = CONFIG.MATERIAL})
	end
end

task.spawn(function() endpoint:InvokeServer("SyncResize", resize) end)
task.spawn(function() endpoint:InvokeServer("SyncColor", color) end)
task.spawn(function() endpoint:InvokeServer("SyncAnchor", anchor) end)
task.spawn(function() endpoint:InvokeServer("SyncCollision", collide) end)
task.spawn(function() endpoint:InvokeServer("SyncMaterial", material) end)

print("Stroke text built with " .. #specs .. " parts")
