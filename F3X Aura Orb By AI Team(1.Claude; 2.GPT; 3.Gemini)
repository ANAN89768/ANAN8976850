local function updateWave(p, w, flat, dt)
	if not w then
		p.transparency = 1
		return nil
	end
	w.t += dt / 0.5
	if w.t >= 1 then
		p.transparency = 1
		return nil
	end
	local e = 1 - (1 - w.t) ^ 2
	local s = math.max(0.05, 1 + (w.max - 1) * e)
	if flat then
		p.cf = CFrame.new(w.pos) * CFrame.Angles(0, 0, math.rad(90))
		p.size = Vector3.new(0.2, s, s)
	else
		p.cf = CFrame.new(w.pos)
		p.size = Vector3.one * s
	end
	p.color = w.color
	p.transparency = 0.3 + 0.7 * w.t
	return w
end

