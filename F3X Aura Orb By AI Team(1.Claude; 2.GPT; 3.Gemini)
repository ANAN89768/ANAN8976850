	for _, p in ipairs(order) do
		if p.inst then table.insert(list, p.inst) end
	end
	if #list > 0 then sync("Remove", list) end
end

-- Parallel Initialization of F3X Parts
local function build(root)
	local spawnCF = root.CFrame * CFrame.new(2.5, 10, 3)
	local createdCount = 0
	local lock = false
	
	for _, p in ipairs(order) do
		task.spawn(function()
			if not alive then return end
			local inst = sync("CreatePart", p.kind, spawnCF, workspace)
			while lock do task.wait() end
			lock = true
			if typeof(inst) == "Instance" then
				p.inst = inst
				createdCount += 1
			end
			lock = false
		end)
	end

	local timeout = os.clock() + 6
	while createdCount < #order and os.clock() < timeout and alive do
		task.wait(0.05)
	end

	if createdCount < #order then
		removeAll()
		for _, q in ipairs(order) do q.inst = nil end
		return false
	end

	local anchors, collisions = {}, {}
	for _, p in ipairs(order) do
		table.insert(anchors, { Part = p.inst, Anchored = true })
		table.insert(collisions, { Part = p.inst, CanCollide = false })
	end
	sync("SyncAnchor", anchors)
	sync("SyncCollision", collisions)
	if USE_LIGHT then
		sync("CreateLights", { { Part = core.inst, LightType = "PointLight" } })
	end
	return true
end

-- Batched Synchronization Pipeline
local inflight = 0
local lightB, lightColor, lastLight = 2.5, mainColor, 0

local function fire(action, list)
	if #list == 0 then return end
	inflight += 1
	task.spawn(function()
		sync(action, list)
		inflight -= 1
	end)
end

local function cdiff(a, b)
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B)
end

local function flush()
	if inflight > 6 then return end
	local resize, move, colors, mats = {}, {}, {}, {}

	for _, p in ipairs(order) do
		local inst = p.inst
		if inst and inst.Parent then
			local s = p.sent

			local sizeChanged = not s.size or (p.size - s.size).Magnitude > 0.01
			local cfChanged = not s.cf
				or (p.cf.Position - s.cf.Position).Magnitude > 0.003
				or p.cf.LookVector:Dot(s.cf.LookVector) < 0.9998
				or p.cf.UpVector:Dot(s.cf.UpVector) < 0.9998

			if sizeChanged then
				table.insert(resize, { Part = inst, Size = p.size, CFrame = p.cf })
				s.size, s.cf = p.size, p.cf
			elseif cfChanged then
				table.insert(move, { Part = inst, CFrame = p.cf })
				s.cf = p.cf
			end

			if not s.color or cdiff(p.color, s.color) > 0.01 then
				table.insert(colors, { Part = inst, Color = p.color, UnionColoring = true })
				s.color = p.color
			end

			if s.transparency == nil or math.abs(p.transparency - s.transparency) > 0.02 then
				table.insert(mats, { Part = inst, Material = p.material, Transparency = p.transparency })
				s.transparency = p.transparency
			end
		end
	end

	fire("SyncResize", resize)
	fire("SyncMove", move)
	fire("SyncColor", colors)
	fire("SyncMaterial", mats)

	if USE_LIGHT and core.inst and os.clock() - lastLight > LIGHT_INTERVAL then
		lastLight = os.clock()
		fire("SyncLighting", {
			{ Part = core.inst, LightType = "PointLight", Range = 22, Brightness = lightB, Color = lightColor },
		})
	end
end

