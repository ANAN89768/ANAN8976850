-- Main Physics & Animation Loop
RunService.Heartbeat:Connect(function(rawDt)
	if not alive then return end
	local dt = math.min(rawDt, 1 / 30)
	updateUI()
	if not ready then return end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end

	local t = os.clock()
	local rootVel = root.AssemblyLinearVelocity
	if rootVel.Y < 0 then fallSpeed = math.max(fallSpeed, -rootVel.Y) end
	local flatSpeed = Vector3.new(rootVel.X, 0, rootVel.Z).Magnitude
	local speedFactor = math.clamp(flatSpeed / 30, 0, 1)

	-- Idle & Sleep Checks
	if flatSpeed < 1 then idleTime += dt else idleTime = 0 end
	local idleGoal = idleTime > IDLE_AFTER and 1 or 0
	idleBlend += (idleGoal - idleBlend) * (1 - math.exp(-2 * dt))

	local dead = hum.Health <= 0
	local sleepGoal = (idleTime > SLEEP_AFTER or dead) and 1 or 0
	if prevSleepGoal == 1 and sleepGoal == 0 then
		excite, pulse = 1, 1
	end
	prevSleepGoal = sleepGoal
	sleep += (sleepGoal - sleep) * (1 - math.exp(-1.2 * dt))

	-- Rage Mode & Health Alerts
	alert = math.max(0, alert - dt / 2.5)
	local lowHealth = (not dead) and (hum.Health / hum.MaxHealth < 0.3)
	local alertGoal = math.max(alert, lowHealth and 0.6 or 0)
	alertS += (alertGoal - alertS) * (1 - math.exp(-8 * dt))

	-- Curiosity AI Scan
	scanTimer -= dt
	if scanTimer <= 0 then
		scanTimer = 0.3
		curiousRoot = nil
		local best = CURIOUS_RANGE
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player and other.Character then
				local r = other.Character:FindFirstChild("HumanoidRootPart")
				if r then
					local d = (r.Position - root.Position).Magnitude
					if d < best then
						best = d
						curiousRoot = r
					end
				end
			end
		end
	end
	if curiousRoot and not curiousRoot.Parent then curiousRoot = nil end
	curious += ((curiousRoot and 1 or 0) - curious) * (1 - math.exp(-3 * dt))

	-- Decay Factors
	pulse = math.max(0, pulse - dt * 2.5)
	overdrive = math.max(0, overdrive - dt / 3)
	excite = math.max(0, excite - dt / 1.5)
	greet = math.max(0, greet - dt / 2.5)
	dashOffset = dashOffset:Lerp(Vector3.zero, 1 - math.exp(-6 * dt))

	-- Target Position Calculation
	local followOffset = FOLLOW_OFFSET * (1 - 0.45 * alertS)
	local bobSpeed = 2.5 + excite * 3.5
	local bobAmp = math.max(0.1, 0.45 + excite * 0.45 - sleep * 0.3)
	local followTarget = root.CFrame:PointToWorldSpace(
		followOffset + Vector3.new(0, math.sin(t * bobSpeed) * bobAmp, 0)
	) + dashOffset

	orbitAngle += dt * (1.6 + greet * 7)
	local orbitRadius = ORBIT_RADIUS * (1 - 0.3 * greet)
	local orbitTarget = root.Position + Vector3.new(
		math.cos(orbitAngle) * orbitRadius,
		2.8 + math.sin(t * 2) * 0.7,
		math.sin(orbitAngle) * orbitRadius
	)
	local orbitBlend = math.max(idleBlend, math.min(1, greet * 3))
	local target = followTarget:Lerp(orbitTarget, orbitBlend)

	if curiousRoot then
		target = target:Lerp(curiousRoot.Position + Vector3.new(0, 3, 0), 0.25 * curious * (1 - sleep))
	end

	local restSpot = root.CFrame:PointToWorldSpace(Vector3.new(2.5, -1.4 + math.sin(t * 1.2) * 0.15, 2.5))
	target = target:Lerp(restSpot, sleep)

	-- Environmental Wall Raycasting
	rayParams.FilterDescendantsInstances = ignoreList(char)
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local hit = workspace:Raycast(origin, target - origin, rayParams)
	if hit then target = hit.Position + hit.Normal end

	if not placed or (target - pos).Magnitude > 80 then
		pos, vel, placed = target, Vector3.zero, true
		history = {}
	end

	-- Spring Physics Integration
	local stiff = STIFFNESS * (1 - 0.5 * sleep) * (1 + 0.4 * alertS)
	local damp = DAMPING * math.sqrt(stiff / STIFFNESS)
	vel += ((target - pos) * stiff - vel * damp) * dt
	pos += vel * dt

	-- Color Theming & Transitions
	local theme = THEMES[themeIndex]
	local k = 1 - math.exp(-6 * dt)
	mainColor = mainColor:Lerp(theme.main, k)
	accentColor = accentColor:Lerp(theme.accent, k)
	
	local activeMain = isBlackHoleActive and BLACKHOLE_MAIN or mainColor
	local activeAccent = isBlackHoleActive and BLACKHOLE_ACCENT or accentColor
	
	local displayMain = activeMain:Lerp(ALARM_COLOR, alertS * 0.8):Lerp(SLEEP_COLOR, sleep * 0.5)
	local displayAccent = activeAccent:Lerp(SLEEP_COLOR, sleep * 0.5)

	-- Tremor/Shake Calculation
	local shake = overdrive * 0.15 + alertS * 0.1
	local renderPos = pos + Vector3.new(
		(math.random() - 0.5) * shake,
		(math.random() - 0.5) * shake,
		(math.random() - 0.5) * shake
	)

	-- Core & Glass Shell
	local breathe = 1 + 0.05 * math.sin(t * (2 - sleep * 0.9))
	local size = (BASE_SIZE * (1 - 0.15 * sleep) + pulse * 0.6 + overdrive * 0.5 + excite * 0.25) * breathe
	local stretch = math.clamp(vel.Magnitude / 55, 0, 0.6)
	local coreCF = vel.Magnitude > 0.5 and CFrame.lookAt(renderPos, renderPos + vel) or CFrame.new(renderPos)
	
	put(core, coreCF, Vector3.new(size * 0.75, size * 0.75, size * 0.75 * (1 + stretch)), displayMain)
	put(shell, CFrame.new(renderPos), Vector3.one * size * (isBlackHoleActive and 1.6 or 1.3), displayAccent, isBlackHoleActive and 0.2 or 0.5)

	-- Eye Tracking & Glancing
	local toPlayer = (root.Position + Vector3.new(0, 1.5, 0)) - renderPos
	local desired = toPlayer.Magnitude > 0.1 and toPlayer.Unit or lookDir
	if flatSpeed > 4 then
		local moveDir = Vector3.new(rootVel.X, 0, rootVel.Z).Unit
		desired = (desired * 0.3 + moveDir).Unit
	end

	glanceTimer -= dt
	if glanceTimer <= 0 then
		glanceTimer = 1.5 + math.random() * 3.5
		glance = Vector3.new(math.random() * 2 - 1, math.random() - 0.4, math.random() * 2 - 1) * 0.7
	end
	desired += glance * (idleBlend * (1 - curious) * (1 - sleep))

	if curiousRoot then
		local toThem = (curiousRoot.Position + Vector3.new(0, 2, 0)) - renderPos
		if toThem.Magnitude > 0.1 then
			desired = desired:Lerp(toThem.Unit, curious)
		end
	end
	desired = desired:Lerp(Vector3.new(0, -0.7, 0.3), sleep)
	if desired.Magnitude < 0.01 then desired = lookDir end

	lookDir = lookDir:Lerp(desired.Unit, 1 - math.exp(-8 * dt))
	if lookDir.Magnitude < 0.01 then lookDir = Vector3.zAxis end
	lookDir = lookDir.Unit

	-- Blinking Mechanics
	blinkTimer -= dt
	if blinkTimer <= 0 then
		blinkTimer = 2 + math.random() * 4
		blinking = 0.14
	end
	blinking = math.max(0, blinking - dt)
	local blinkClosed = blinking > 0 and math.sin(math.clamp(blinking / 0.14, 0, 1) * math.pi) or 0
	local openness = (1 - 0.8 * sleep) * (1 + 0.25 * alertS + 0.2 * excite) * (1 - 0.95 * blinkClosed)
	openness = math.clamp(openness, 0.05, 1.3)

	local eyeCenter = renderPos + lookDir * (size * 0.32)
	local eyeCF = CFrame.lookAt(eyeCenter, eyeCenter + lookDir)
	put(eye, eyeCF, Vector3.new(size * 0.48, size * 0.48 * openness, size * 0.22), isBlackHoleActive and displayAccent or WHITE:Lerp(displayMain, 0.25))

	local pupilScale = size * 0.22 * (1 + 0.5 * excite + 0.4 * curious - 0.35 * alertS)
	local ox = math.noise(t * 1.3, 5, 0) * size * 0.06
	local oy = math.noise(t * 1.1, 9, 0) * size * 0.05
	put(
		pupil,
		eyeCF * CFrame.new(ox, oy, -size * 0.1),
		Vector3.new(pupilScale, pupilScale * math.clamp(openness, 0.05, 1), size * 0.12)
	)

	-- Rotating Shield Rings
	ringAngle += dt * (1.2 + speedFactor * 2.5 + overdrive * 6 - sleep * 0.8)
	local ringCFs = {
		CFrame.new(renderPos) * CFrame.Angles(ringAngle * 1.5, ringAngle * 0.7, 0),
		CFrame.new(renderPos) * CFrame.Angles(0, ringAngle * 1.1, ringAngle * 1.9),
		CFrame.new(renderPos) * CFrame.Angles(ringAngle * 0.8, 0, ringAngle * 1.3),
	}
	for i, r in ipairs(rings) do
		local d = size * (1.8 + i * 0.32)
		put(r, ringCFs[i], Vector3.new(0.08, d, d), i == 2 and displayAccent or displayMain, isBlackHoleActive and 0.1 or 0.2)
	end

	-- High-Speed Blades
	spinAngle += dt * (2.5 + speedFactor * 7 + overdrive * 16 + excite * 5) * (1 - 0.85 * sleep)
	local radius = size * 1.45 + speedFactor * 0.6 + overdrive + alertS * 0.4
	for i, b in ipairs(blades) do
		local a = spinAngle + (i - 1) * (math.pi * 2 / BLADE_COUNT)
		put(
			b,
			CFrame.new(renderPos) * CFrame.Angles(0, a, 0) * CFrame.new(0, math.sin(t * 3 + i) * 0.25, -radius),
			Vector3.new(1.4 + overdrive * 1.4, 0.12, 0.12),
			displayAccent
		)
	end

	-- Thunderstorm Aura (8 Electric Arcs)
	lightningAngle += dt * 6
	for i, arc in ipairs(lightningArcs) do
		if sleep > 0.8 then
			arc.transparency = 1
		else
			local angle = lightningAngle + (i * (math.pi * 2 / #lightningArcs))
			local arcRadius = size * 1.1 + math.sin(t * 10 + i) * 0.3
			local arcCF = CFrame.new(renderPos) * CFrame.Angles(math.sin(t * 5 + i), angle, math.cos(t * 4 + i)) * CFrame.new(0, 0, -arcRadius)
			local arcSize = Vector3.new(0.1, 0.1, size * (0.8 + 0.4 * math.sin(t * 15 + i)))
			put(arc, arcCF, arcSize, WHITE, 0.15)
		end
	end

	-- Animated Swarm Nodes
	swarmAngle += dt * 3.5
	for i, node in ipairs(swarmNodes) do
		if sleep > 0.8 then
			node.transparency = 1
		else
			local angleOffset = (i / SWARM_COUNT) * (math.pi * 2)
			local subRadius = size * (isBlackHoleActive and (1.5 + (i % 5) * 0.4) or 2.2) + math.sin(t * 3 + i) * 0.4
			local swarmCF = CFrame.new(renderPos) * CFrame.Angles(0, swarmAngle + angleOffset, math.sin(t * 2 + i) * 0.8) * CFrame.new(0, 0, -subRadius)
			put(node, swarmCF, Vector3.one * (0.2 + 0.1 * math.sin(t * 4 + i)), displayAccent, isBlackHoleActive and 0.05 or 0.15)
		end
	end

	-- Sleepy Z Markers
	for i, z in ipairs(zs) do
		if sleep > 0.7 then
			local ph = (t * 0.5 + i / #zs) % 1
			put(
				z,
				CFrame.new(renderPos + Vector3.new(0.6 + ph, 1.2 + ph * 2.2, 0)),
				Vector3.one * (0.2 + ph * 0.2),
				displayAccent,
				math.clamp(0.2 + ph * 0.8, 0, 1)
			)
		else
			z.transparency = 1
		end
	end

	-- Particle Trail Dots
	histTimer += dt
	if histTimer > 0.04 then
		histTimer = 0
		table.insert(history, 1, renderPos)
		if #history > #dots + 1 then table.remove(history) end
	end
	for i, d in ipairs(dots) do
		local h = history[i + 1]
		if h and vel.Magnitude > 2 then
			put(d, CFrame.new(h), Vector3.one * (size * 0.4 * (1 - i / (#dots + 1))), displayMain, 0.3 + i * 0.1)
		else
			d.transparency = 1
		end
	end

	-- Shockwaves
	waveB = updateWave(waveBall, waveB, false, dt)
	waveD = updateWave(waveDisc, waveD, true, dt)

	-- Dynamic Lighting Integration
	local flicker = math.noise(t * 16, 0, 0) * 1.5
	lightColor = displayMain
	lightB = math.max(0.4, (3.0 + flicker + pulse * 3.5 + overdrive * 4.5 + excite * 1.8) * (1 - 0.7 * sleep))
end)
