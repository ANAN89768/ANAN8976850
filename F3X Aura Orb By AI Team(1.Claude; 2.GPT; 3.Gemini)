local function onCharacter(char)
	local hum = char:WaitForChild("Humanoid")
	lastHealth = hum.Health
	greet = 1

	hum.StateChanged:Connect(function(_, new)
		if new ~= Enum.HumanoidStateType.Landed then return end
		excite = math.max(excite, 0.6)
		if fallSpeed > 45 and ready then
			local root = char:FindFirstChild("HumanoidRootPart")
			if root then
				rayParams.FilterDescendantsInstances = ignoreList(char)
				local hit = workspace:Raycast(root.Position, Vector3.new(0, -25, 0), rayParams)
				if hit then
					waveD = {
						t = 0,
						pos = hit.Position + Vector3.new(0, 0.15, 0),
						max = math.clamp(fallSpeed / 1.8, 16, 45),
						color = mainColor,
					}
				end
			end
			pulse = 2
		end
		fallSpeed = 0
	end)

	hum.HealthChanged:Connect(function(h)
		if h < lastHealth - 0.5 then
			alert = 1
			excite = 0
		end
		lastHealth = h
	end)
end

