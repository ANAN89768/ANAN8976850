-- Custom Draggable Implementation for Main Frame
local dragging, dragStart, startPos

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- Main Logic
local gatheredParts = {}
local isBringing = false

local function giveTool()
    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    
    if backpack:FindFirstChild("Click Target") or (char and char:FindFirstChild("Click Target")) then return end
    
    local tool = Instance.new("Tool")
    tool.Name = "Click Target"
    tool.RequiresHandle = false
    tool.Parent = backpack
    
    local toolReady = false
    
    tool.Equipped:Connect(function()
        task.wait(0.02)
        toolReady = true
    end)
    
    tool.Unequipped:Connect(function()
        toolReady = false
    end)
    
    tool.Activated:Connect(function()
        if not toolReady then return end
        
        local mouse = player:GetMouse()
        local targetPos = mouse.Hit.Position
        local throwPower = tonumber(throwTextBox.Text) or 350
        
        for _, part in ipairs(gatheredParts) do
            if part and part.Parent then
                pcall(function()
                    local dir = (targetPos - part.Position).Unit
                    part.AssemblyLinearVelocity = (dir * throwPower) + Vector3.new(0, 50, 0)
                end)
            end
        end
        table.clear(gatheredParts)
        isBringing = false
        tool:Destroy()
    end)
end

bringButton.MouseButton1Click:Connect(function()
    table.clear(gatheredParts)
    isBringing = true
    
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    pcall(function() setsimulationradius(1000) end)
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj.Anchored and not obj:IsDescendantOf(char) then
            if (obj.Position - root.Position).Magnitude <= 1000 then
                table.insert(gatheredParts, obj)
            end
        end
    end
    
    giveTool()
end)

-- Dynamic Part Calculator & Orbit Loop
RunService.Heartbeat:Connect(function(dt)
    if not isBringing then return end
    
    for i = #gatheredParts, 1, -1 do
        local p = gatheredParts[i]
        if not p or not p.Parent or p.Anchored then
            table.remove(gatheredParts, i)
        end
    end
    
    if #gatheredParts == 0 then return end
    
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local angle = tick() * 6
    local radius = tonumber(orbitTextBox.Text) or 7
    local total = #gatheredParts
    
    for i, part in ipairs(gatheredParts) do
        pcall(function()
            local phi = math.acos(1 - (2 * (i - 0.5) / total))
            local theta = math.sqrt(total * math.pi) * phi + angle
            
            local x = radius * math.sin(phi) * math.cos(theta)
            local y = radius * math.cos(phi)
            local z = radius * math.sin(phi) * math.sin(theta)
            
            local targetPos = root.Position + Vector3.new(x, y + 2, z)
            part.AssemblyLinearVelocity = (targetPos - part.Position) * 18
        end)
    end
end)
